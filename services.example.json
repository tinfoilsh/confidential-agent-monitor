{
  "services": {
    "google": {
      "title": "Google",
      "operations": [
        {"id": "gmail.messages.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://gmail.googleapis.com", "path": "/gmail/v1/users/{user}/messages", "scope": {"user": {"from": "path", "at": "user"}}, "params": ["q", "maxResults", "pageToken", "labelIds"]},
        {"id": "gmail.messages.send", "action": "send.mail", "effects": ["send"], "method": "POST", "origin": "https://gmail.googleapis.com", "path": "/gmail/v1/users/{user}/messages/send", "body": "json", "scope": {"user": {"from": "path", "at": "user"}, "message": {"from": "body", "at": "", "type": "object"}}},
        {"id": "drive.files.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://www.googleapis.com", "path": "/drive/v3/files/{file}", "scope": {"file": {"from": "path", "at": "file"}}},
        {"id": "drive.permissions.create", "action": "share", "effects": ["share"], "method": "POST", "origin": "https://www.googleapis.com", "path": "/drive/v3/files/{file}/permissions", "body": "json", "scope": {"file": {"from": "path", "at": "file"}, "permission": {"from": "body", "at": "", "type": "object"}}},
        {"id": "sheets.values.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://sheets.googleapis.com", "path": "/v4/spreadsheets/{spreadsheet}/values/{range}", "scope": {"spreadsheet": {"from": "path", "at": "spreadsheet"}, "range": {"from": "path", "at": "range"}}},
        {"id": "sheets.values.append", "action": "write", "effects": ["write"], "method": "POST", "origin": "https://sheets.googleapis.com", "path": "/v4/spreadsheets/{spreadsheet}/values/{range}:append", "body": "json", "scope": {"spreadsheet": {"from": "path", "at": "spreadsheet"}, "range": {"from": "path", "at": "range"}}},
        {"id": "calendar.events.insert", "action": "send.invite", "effects": ["send"], "method": "POST", "origin": "https://www.googleapis.com", "path": "/calendar/v3/calendars/{calendar}/events", "body": "json", "scope": {"calendar": {"from": "path", "at": "calendar"}, "event": {"from": "body", "at": "", "type": "object"}}}
      ]
    },
    "slack": {
      "title": "Slack",
      "operations": [
        {"id": "conversations.history", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://slack.com", "path": "/api/conversations.history", "scope": {"channel": {"from": "query", "at": "channel"}}, "params": ["channel", "cursor", "limit"]},
        {"id": "chat.postMessage", "action": "send.message", "effects": ["send"], "method": "POST", "origin": "https://slack.com", "path": "/api/chat.postMessage", "body": "json", "scope": {"channel": {"from": "body", "at": "/channel"}, "text": {"from": "body", "at": "/text"}}, "grant": ["channel"]}
      ]
    },
    "github": {
      "title": "GitHub",
      "operations": [
        {"id": "issues.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.github.com", "path": "/repos/{owner}/{repo}/issues", "scope": {"owner": {"from": "path", "at": "owner"}, "repo": {"from": "path", "at": "repo"}}},
        {"id": "issues.comment", "action": "send.comment", "effects": ["send"], "method": "POST", "origin": "https://api.github.com", "path": "/repos/{owner}/{repo}/issues/{number}/comments", "body": "json", "scope": {"owner": {"from": "path", "at": "owner"}, "repo": {"from": "path", "at": "repo"}}}
      ]
    },
    "notion": {
      "title": "Notion",
      "operations": [
        {"id": "search", "action": "read", "effects": ["read"], "method": "POST", "origin": "https://api.notion.com", "path": "/v1/search", "headers": {"Notion-Version": "2022-06-28"}, "body": "json", "scope": {}},
        {"id": "pages.create", "action": "write", "effects": ["write"], "method": "POST", "origin": "https://api.notion.com", "path": "/v1/pages", "headers": {"Notion-Version": "2022-06-28"}, "body": "json", "scope": {"database": {"from": "body", "at": "/parent/database_id"}}}
      ]
    },
    "linear": {
      "title": "Linear",
      "operations": [
        {"id": "issues", "action": "read", "effects": ["read"], "method": "POST", "origin": "https://api.linear.app", "path": "/graphql", "body": "graphql", "graphql": {"operation": "query", "field": "issues"}, "scope": {}},
        {"id": "issueCreate", "action": "write", "effects": ["write"], "method": "POST", "origin": "https://api.linear.app", "path": "/graphql", "body": "graphql", "graphql": {"operation": "mutation", "field": "issueCreate"}, "scope": {"team": {"from": "argument", "at": "/input/teamId"}}}
      ]
    },
    "outlook": {
      "title": "Outlook",
      "operations": [
        {"id": "messages.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://graph.microsoft.com", "path": "/v1.0/me/messages", "scope": {}},
        {"id": "sendMail", "action": "send.mail", "effects": ["send"], "method": "POST", "origin": "https://graph.microsoft.com", "path": "/v1.0/me/sendMail", "body": "json", "scope": {"mail": {"from": "body", "at": "", "type": "object"}}}
      ]
    },
    "airtable": {
      "title": "Airtable",
      "operations": [
        {"id": "records.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.airtable.com", "path": "/v0/{base}/{table}", "scope": {"base": {"from": "path", "at": "base"}, "table": {"from": "path", "at": "table"}}},
        {"id": "records.create", "action": "write", "effects": ["write"], "method": "POST", "origin": "https://api.airtable.com", "path": "/v0/{base}/{table}", "body": "json", "scope": {"base": {"from": "path", "at": "base"}, "table": {"from": "path", "at": "table"}}}
      ]
    },
    "jira": {
      "title": "Jira",
      "operations": [
        {"id": "issue.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://example.atlassian.net", "path": "/rest/api/3/issue/{issue}", "scope": {"issue": {"from": "path", "at": "issue"}}},
        {"id": "issue.comment", "action": "send.comment", "effects": ["send"], "method": "POST", "origin": "https://example.atlassian.net", "path": "/rest/api/3/issue/{issue}/comment", "body": "json", "scope": {"issue": {"from": "path", "at": "issue"}}}
      ]
    },
    "trello": {
      "title": "Trello",
      "operations": [
        {"id": "boards.cards", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.trello.com", "path": "/1/boards/{board}/cards", "scope": {"board": {"from": "path", "at": "board"}}, "params": ["fields"]}
      ]
    },
    "telegram": {
      "title": "Telegram",
      "operations": [
        {"id": "getUpdates", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.telegram.org", "path": "/bot{token}/getUpdates", "scope": {}},
        {"id": "sendMessage.query", "action": "send.message", "effects": ["send"], "method": "GET", "origin": "https://api.telegram.org", "path": "/bot{token}/sendMessage", "scope": {"chat": {"from": "query", "at": "chat_id"}}, "params": ["chat_id", "text"]},
        {"id": "sendMessage", "action": "send.message", "effects": ["send"], "method": "POST", "origin": "https://api.telegram.org", "path": "/bot{token}/sendMessage", "body": "json", "scope": {"chat": {"from": "body", "at": "/chat_id", "type": "number"}}}
      ]
    },
    "twilio": {
      "title": "Twilio",
      "operations": [
        {"id": "messages.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.twilio.com", "path": "/2010-04-01/Accounts/{account}/Messages.json", "scope": {"account": {"from": "path", "at": "account"}}},
        {"id": "messages.create", "action": "send.sms", "effects": ["send", "pay"], "method": "POST", "origin": "https://api.twilio.com", "path": "/2010-04-01/Accounts/{account}/Messages.json", "body": "form", "scope": {"account": {"from": "path", "at": "account"}, "to": {"from": "form", "at": "To"}, "from": {"from": "form", "at": "From"}}}
      ]
    },
    "stripe": {
      "title": "Stripe",
      "operations": [
        {"id": "charges.retrieve", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.stripe.com", "path": "/v1/charges/{charge}", "scope": {"charge": {"from": "path", "at": "charge"}}},
        {"id": "refunds.create", "action": "pay.refund", "effects": ["pay"], "method": "POST", "origin": "https://api.stripe.com", "path": "/v1/refunds", "body": "form", "scope": {"payment_intent": {"from": "form", "at": "payment_intent"}, "amount": {"from": "form", "at": "amount"}}}
      ]
    },
    "dropbox": {
      "title": "Dropbox",
      "operations": [
        {"id": "files.list_folder", "action": "read", "effects": ["read"], "method": "POST", "origin": "https://api.dropboxapi.com", "path": "/2/files/list_folder", "body": "json", "scope": {"path": {"from": "body", "at": "/path"}}},
        {"id": "files.download", "action": "read", "effects": ["read"], "method": "POST", "origin": "https://content.dropboxapi.com", "path": "/2/files/download", "scope": {"path": {"from": "header_json", "header": "Dropbox-Api-Arg", "at": "/path"}}},
        {"id": "files.upload", "action": "write", "effects": ["write"], "method": "POST", "origin": "https://content.dropboxapi.com", "path": "/2/files/upload", "headers": {"Content-Type": "application/octet-stream"}, "body": "any", "scope": {"path": {"from": "header_json", "header": "Dropbox-Api-Arg", "at": "/path"}}}
      ]
    },
    "openai": {
      "title": "OpenAI",
      "operations": [
        {"id": "chat.completions", "action": "generate", "effects": ["generate"], "method": "POST", "origin": "https://api.openai.com", "path": "/v1/chat/completions", "body": "json", "scope": {"model": {"from": "body", "at": "/model"}}}
      ]
    },
    "s3": {
      "title": "Amazon S3",
      "operations": [
        {"id": "objects.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://s3.us-east-1.amazonaws.com", "path": "/{bucket}", "query": {"list-type": "2"}, "params": ["prefix", "delimiter", "continuation-token", "max-keys", "start-after", "encoding-type"], "scope": {"bucket": {"from": "path", "at": "bucket"}}},
        {"id": "objects.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://s3.us-east-1.amazonaws.com", "path": "/{bucket}/{key*}", "params": ["versionId", "x-id"], "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
        {"id": "objects.head", "action": "read", "effects": ["read"], "method": "HEAD", "origin": "https://s3.us-east-1.amazonaws.com", "path": "/{bucket}/{key*}", "params": ["versionId"], "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
        {"id": "objects.put", "action": "write", "effects": ["write"], "method": "PUT", "origin": "https://s3.us-east-1.amazonaws.com", "path": "/{bucket}/{key*}", "params": ["x-id"], "headers": {"X-Amz-Copy-Source": null, "X-Amz-Acl": null, "X-Amz-Tagging": null, "X-Amz-Grant-Full-Control": null, "X-Amz-Grant-Read": null, "X-Amz-Grant-Read-Acp": null, "X-Amz-Grant-Write-Acp": null, "X-Amz-Website-Redirect-Location": null, "X-Amz-Object-Lock-Mode": null, "X-Amz-Object-Lock-Retain-Until-Date": null, "X-Amz-Object-Lock-Legal-Hold": null}, "body": "any", "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
        {"id": "objects.delete", "action": "delete", "effects": ["delete"], "method": "DELETE", "origin": "https://s3.us-east-1.amazonaws.com", "path": "/{bucket}/{key*}", "params": ["versionId", "x-id"], "headers": {"X-Amz-Bypass-Governance-Retention": null}, "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}}
      ]
    }
  }
}
