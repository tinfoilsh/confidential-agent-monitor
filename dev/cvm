#!/usr/bin/env bash
# Boots one sandbox as its CVM would, under Podman: dev/cvm-services stands in for the
# attested host key, attestation socket and workspace volume worker. ui/dev/local.ts runs it.
set -euo pipefail
cd "$(dirname "$0")/.."
name=${1:?usage: dev/cvm NAME MONITOR_SSH_PORT WORKSPACE} port=${2:?} workspace=${3:?}
: "${SANDBOX_INSTANCE_ID:?}" "${SANDBOX_OWNER_PUBLIC_KEY:?}"
src=$(realpath "${SANDBOX_SRC:-../confidential-agent-sandbox}")
toolchain=$(realpath "${SANDBOX_TOOLCHAIN:?set to a nix-closure pack.sh STAGE or STAGE/nix directory}")
if [[ ${toolchain##*/} == nix && -d $toolchain/store ]]; then
  toolchain=$(dirname "$toolchain")
fi
[[ -d $toolchain/nix/store ]] || { printf 'SANDBOX_TOOLCHAIN must point to STAGE or STAGE/nix; missing %s/nix/store\n' "$toolchain" >&2; exit 1; }

podman build -q -t confidential-agent-sandbox-dev "$src" > /dev/null
podman rm -f --ignore "$name" > /dev/null
podman run -d --name "$name" --hostname workspace --privileged --systemd=always \
  --userns=keep-id --user root --network "pasta:-T,$port" --dns 100.127.255.2 \
  -e SANDBOX_INSTANCE_ID -e SANDBOX_OWNER_PUBLIC_KEY -e SANDBOX_MONITOR_SSH -e MONITOR_PORT="$port" \
  -v "$workspace:/mnt/disk" -v "$workspace:/nix" -v "$toolchain:/tinfoil/models/nix:ro" \
  -v "$PWD/dev/cvm-services:/usr/local/libexec/cvm-services:ro" \
  --entrypoint bash confidential-agent-sandbox-dev -c '
    set -euo pipefail
    mkdir -p /nix/store /nix/store.upper /nix/store.work
    mount -t overlay overlay -o lowerdir=/tinfoil/models/nix/nix/store,upperdir=/nix/store.upper,workdir=/nix/store.work /nix/store
    nft -f - <<NFT
table inet egress {
  chain output { type filter hook output priority 0; oifname != { "lo", "monitor0" } drop; }
  chain forward { type filter hook forward priority 0; drop; }
}
NFT
    # pasta forwards this loopback port to the Monitor, which a CVM reaches at its egress alias.
    sed -i -e "s/^    HostName 10.254.0.1$/    HostName 127.0.0.1/" -e "s/^    Port 22$/    Port $MONITOR_PORT/" \
      /etc/ssh/monitor-reverse.conf /etc/ssh/ssh_config.d/monitor.conf
    /usr/local/libexec/cvm-services
    exec /entrypoint --dev' > /dev/null
