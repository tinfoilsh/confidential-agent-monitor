#!/usr/bin/env python3
"""Measure the built UI with a large synthetic request log; no real credentials."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import runpy
import statistics
import subprocess
import threading
import time
from http.server import ThreadingHTTPServer

Fixture = runpy.run_path(str(Path(__file__).with_name("perf-ui")))["Fixture"]

# Instrument only the fixture page, before the app's module executes. Measure
# synchronous input/clock work and date formatting without browser eval access.
INSTRUMENT = b"""<script>
const samples = { clock: {}, input: {}, dates: 0 };
const report = () => {
  samples.hidden = document.hidden;
  let output = document.getElementById('render-metrics');
  if (!output) {
    output = document.createElement('output');
    output.id = 'render-metrics';
    output.hidden = true;
    document.body.append(output);
  }
  output.dataset.metrics = JSON.stringify(samples);
};
const format = Date.prototype.toLocaleTimeString;
Date.prototype.toLocaleTimeString = function(...args) {
  samples.dates++;
  return format.apply(this, args);
};
const interval = window.setInterval;
window.setInterval = (callback, delay, ...args) => interval(() => {
  const start = performance.now();
  callback(...args);
  if (delay === 1000 && document.getElementById('tree')) {
    (samples.clock[location.hash] ??= []).push(performance.now() - start);
    report();
  }
}, delay);
document.addEventListener('input', event => {
  if (event.target.type !== 'search') return;
  const start = performance.now(), path = location.hash;
  queueMicrotask(() => {
    (samples.input[path] ??= []).push(performance.now() - start);
    report();
  });
}, true);
</script>"""


class RenderFixture(Fixture):
    def __init__(self, count):
        super().__init__(None)
        self.state = "pending"
        expires = (self.created + datetime.timedelta(minutes=10)).isoformat()
        self.history = [dict(
            id=f"request-{i:05}", state="pending" if i < 100 else "allowed",
            time=self.created.isoformat(), expires=expires, summary=True,
            facts=dict(principal=dict(name="sandbox-sb2"), account="anthropic",
                       title=f"GET api.example.test/request-{i:05}"),
        ) for i in range(count)]
        self.view["config"]["identities"].update({
            f"sandbox-{i:03}": {} for i in range(100)
        })
        self.view["config"]["accounts"].update({
            f"service-{i:03}": {"preset": "anthropic"} for i in range(100)
        })

    def asset(self, path):
        if path == "/api/connections/anthropic/browser":
            return json.dumps(dict(owner=False, url="https://example.test", tabs=[dict(
                id="tab", title="Synthetic browser tab", url="https://example.test", active=True,
            )])).encode(), "application/json"
        body, kind = super().asset(path)
        if kind.startswith("text/html"):
            body = body.replace(b"</head>", INSTRUMENT + b"</head>")
        return body, kind

    def read(self, path, summary=False):
        call, status, body = super().read(path, summary)
        if path == "/api/requests" and status == 200:
            body = json.dumps(self.history).encode()
        return call, status, body


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--records", type=int, default=10000)
    parser.add_argument("--assets", type=Path, help="serve an alternate production dist directory")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    if args.output.exists() or args.records < 200:
        parser.error("use a new output path and at least 200 records")
    fixture = RenderFixture(args.records)
    if args.assets:
        fixture.assets = {"app/" + path.relative_to(args.assets).as_posix(): path.read_bytes()
                          for path in args.assets.rglob("*") if path.is_file()}
    server = ThreadingHTTPServer(("127.0.0.1", 0), fixture.handler())
    threading.Thread(target=server.serve_forever, daemon=True).start()
    session = json.loads(subprocess.check_output([
        "pinchtab", "session", "create", "--agent-id", "monitor-render", "--json"
    ]))
    env = dict(os.environ, PINCHTAB_SESSION=session["sessionToken"])

    def browser(*command):
        result = subprocess.run(["pinchtab", *command], env=env, capture_output=True, text=True, timeout=40)
        if result.returncode or result.stderr.strip().startswith("Error "):
            raise RuntimeError(f"pinchtab {command[0]}: {result.stderr or result.stdout}")
        return result.stdout.strip()

    def wait(selector):
        result = json.loads(browser("wait", selector, "--json"))
        if not result.get("waited"):
            raise TimeoutError(selector)

    def metrics():
        return json.loads(browser("attr", "#render-metrics", "data-metrics"))

    checks, tab = {}, None
    try:
        tab = browser("nav", f"http://127.0.0.1:{server.server_port}/app/#session=render-fixture", "--snap").splitlines()[0]
        browser("tab", tab)
        wait("#tree a[href='#activity']")
        browser("click", "#tree a[href='#activity']")
        wait(".request-row")
        checks["page_bounded_to_50"] = browser("count", ".request-row") == "50"
        wait("#render-metrics")
        before = metrics()["dates"]
        time.sleep(5.2)
        idle_dates = metrics()["dates"] - before
        for query in ("099", "request-050", "request-000", "no match", "") * 3:
            browser("fill", "input[aria-label='Search activity']", query)
        checks["search_restores_page"] = browser("count", ".request-row") == "50"
        browser("click", "text:Next")
        checks["next_page"] = "51 to 100" in browser("text", ".pagination")
        browser("select", "select[aria-label='All statuses']", "allowed")
        checks["filter_resets_page"] = (
            "1 to 50" in browser("text", ".pagination")
            and browser("count", ".request-row .status-allowed") == "50")
        browser("select", "select[aria-label='All statuses']", "pending")
        # Change a deadline without changing the record count, then let the local
        # clock expire it before the next API poll can supply a different state.
        fixture.history[0]["expires"] = (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=3)).isoformat()
        browser("click", "button[aria-label='Refresh monitor']")
        time.sleep(4.2)
        checks["deadline_updates_count"] = "99" in browser("text", ".stats .stat:first-child strong")
        browser("select", "select[aria-label='All statuses']", "expired")
        checks["deadline_updates_filter"] = browser("count", ".request-row .status-expired") == "1"
        browser("click", "#tree a[href='#agents']")
        wait(".agent-item")
        for query in ("001", "sandbox", "no match", "") * 3:
            browser("fill", "input[aria-label='Search agents']", query)
        checks["agent_search_restores_list"] = browser("count", ".agent-item") == "101"
        time.sleep(2.2)
        browser("click", "#tree a[href='#accounts']")
        wait(".connection-item")
        for query in ("001", "service", "no match", "") * 3:
            browser("fill", "input[aria-label='Search connections']", query)
        checks["connection_search_restores_list"] = browser("count", ".connection-item") == "101"
        time.sleep(2.2)
        measured = metrics()
        checks["foreground_tab"] = measured["hidden"] is False
        fixture.view["config"]["accounts"]["anthropic"]["connections"] = {"": {"browser": {}}}
        browser("click", "button[aria-label='Refresh monitor']")
        browser("click", ".connection-item > summary:has(strong[title='anthropic'])")
        wait(".live-tabs button")
        checks["browser_panel_loads"] = browser("text", ".live-tabs button") == "Synthetic browser tab"
        browser("click", "#tree a[href='#settings']")
        wait(".settings-section")
        checks["settings_loads"] = browser("count", ".settings-section") != "0"
        fixture.history = []
        browser("click", "#tree a[href='#activity']")
        browser("click", "button[aria-label='Refresh monitor']")
        wait("#list .empty-state")
        checks["removed_requests_unmount"] = browser("count", ".request-row") == "0"
        result = dict(records=args.records, checks=checks, idle_row_date_formats=idle_dates,
                      samples=measured, complete=True,
                      app_sha256={path: hashlib.sha256(body).hexdigest()
                                  for path, body in fixture.assets.items() if path.endswith(".js")})
        for kind in ("clock", "input"):
            result[kind + "_median_ms"] = {path: round(statistics.median(values), 3)
                                          for path, values in measured[kind].items()}
        args.output.write_text(json.dumps(result, indent=2) + "\n")
        print(json.dumps({k: v for k, v in result.items() if k not in ("samples", "app_sha256")}, indent=2))
        return 0 if all(checks.values()) else 2
    finally:
        if tab:
            browser("tab", "close", tab)
        subprocess.run(["pinchtab", "session", "revoke", session["id"]], capture_output=True)
        server.shutdown()
        server.server_close()


if __name__ == "__main__":
    raise SystemExit(main())
