#!/usr/bin/env bash
# Builds one bunker image per ARCH, the base system plus every agent, into DIR and pins it in client/vm/assets.json.
# Publish DIR's files under base_url; until then, PERIMETER_ARTIFACTS=DIR makes the client use them.
set -euo pipefail
cd "$(dirname "$0")/.."
out=${1:?usage: dev/vm-artifacts DIR [ARCH...]}
shift
arches=("$@")
(( ${#arches[@]} )) || arches=(x86_64 aarch64)
mkdir -p "$out"
out=$(realpath "$out")
work=$(mktemp -d)
tag=localhost/perimeter-base-build
container=
trap 'rm -rf "$work"; [[ -z $container ]] || podman rm -f "$container" > /dev/null' EXIT

for arch in "${arches[@]}"; do
  case $arch in
    x86_64) platform=linux/amd64 ;;
    aarch64) platform=linux/arm64 ;;
    *) echo "dev/vm-artifacts: unknown ARCH $arch" >&2; exit 1 ;;
  esac
  mkdir "$work/$arch"
  podman build -q --platform "$platform" -t "$tag-$arch" client/vm > /dev/null
  container=$(podman create --platform "$platform" "$tag-$arch" /bin/true)
  podman export "$container" | gzip -n > "$work/$arch/image.tar.gz"
  podman rm -f "$container" > /dev/null
  container=
done

python3 - "$work" "$out" <<'PY'
import hashlib, json, sys
from pathlib import Path
work, out = map(Path, sys.argv[1:])
manifest_path = Path('client/vm/assets.json')
manifest = json.loads(manifest_path.read_text())

def pin(source):
    with source.open('rb') as stream:
        sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    stem, _, extension = source.name.partition('.')
    file = f'{stem}-{sha[:16]}.{extension}'
    source.replace(out / file)
    return {'file': file, 'sha256': sha}

for directory in sorted(work.iterdir()):
    manifest.setdefault(directory.name, {})['image'] = pin(directory / 'image.tar.gz')
manifest_path.write_text(json.dumps(manifest, indent=2) + '\n')
PY
