#!/usr/bin/env bash
# Builds one bunker image per ARCH, the base system plus every agent, into DIR and pins it in client/vm/assets.json.
# Publish DIR's files under base_url; until then, PERIMETER_ARTIFACTS=DIR makes the client use them.
set -euo pipefail
cd "$(dirname "$0")/.."
out=${1:?usage: dev/vm-artifacts DIR [ARCH...]}
shift
arches=("$@")
(( ${#arches[@]} )) || arches=(x86_64 aarch64)
mkdir -p "$out"
out=$(realpath "$out")
nixpkgs=github:NixOS/nixpkgs/ca1659429c950a11a565b5764e37a1b704e17ec8
declare -A oci=([x86_64]=amd64 [aarch64]=arm64)
work=$(mktemp -d)
tag=localhost/perimeter-base-build
container=
trap 'rm -rf "$work"; [[ -z $container ]] || podman rm -f "$container" > /dev/null' EXIT

for arch in "${arches[@]}"; do
  mkdir -p "$work/$arch/usr/local/bin"
  podman build -q --platform "linux/${oci[$arch]}" -t "$tag-$arch" client/vm > /dev/null
  paths=()
  while read -r package; do
    paths+=("$(NIXPKGS_ALLOW_UNFREE=1 nix build --impure --no-link --print-out-paths "$nixpkgs#legacyPackages.$arch-linux.$package")")
  done < <(python3 -c 'import json; [print(agent["package"]) for agent in json.load(open("client/vm/agents.json")).values()]')
  for path in "${paths[@]}"; do
    ln -sf "$path"/bin/* "$work/$arch/usr/local/bin/"
  done
  # Buildah's ADD follows hard links to symlinks, which nix's store optimisation makes.
  { nix-store -qR "${paths[@]}" | sed 's|^/||'; printf '%s\n' "--directory=$work/$arch" usr/local/bin; } |
    tar -C / --sort=name --mtime=@1 --owner=0 --group=0 --numeric-owner --hard-dereference -cf "$work/$arch/agents.tar" -T -
  image=$(printf 'FROM %s\nADD agents.tar /\n' "$tag-$arch" | podman build -q --platform "linux/${oci[$arch]}" -f - "$work/$arch")
  container=$(podman create --platform "linux/${oci[$arch]}" "$image" /bin/true)
  podman export "$container" | gzip -n > "$work/$arch/image.tar.gz"
  podman rm -f "$container" > /dev/null
  container=
  podman rmi -f "$image" > /dev/null
done

python3 - "$work" "$out" <<'PY'
import hashlib, json, sys
from pathlib import Path
work, out = map(Path, sys.argv[1:])
manifest_path = Path('client/vm/assets.json')
manifest = json.loads(manifest_path.read_text())

def pin(source):
    with source.open('rb') as stream:
        sha = hashlib.file_digest(stream, 'sha256').hexdigest()
    stem, _, extension = source.name.partition('.')
    file = f'{stem}-{sha[:16]}.{extension}'
    source.replace(out / file)
    return {'file': file, 'sha256': sha}

for directory in sorted(work.iterdir()):
    manifest.setdefault(directory.name, {})['image'] = pin(directory / 'image.tar.gz')
manifest_path.write_text(json.dumps(manifest, indent=2) + '\n')
PY
