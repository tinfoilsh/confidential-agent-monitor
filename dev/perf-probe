#!/usr/bin/env python3
"""Time credential-free Anthropic probes in an existing sandbox and owner panel."""
import argparse
from collections import Counter
import datetime
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time
import urllib.request

# Sent on stdin: no upload, packages, credentials, policy edits, or inference.
REMOTE = r'''
import json, os, platform, subprocess, sys
samples, timeout = int(sys.argv[1]), float(sys.argv[2])
fields = ['http_code', 'remote_ip', 'time_namelookup', 'time_connect',
          'time_appconnect', 'time_starttransfer', 'time_total', 'size_download', 'num_connects']
format = json.dumps({k:'%{'+k+'}' for k in fields})+'\n'
print(json.dumps({'environment': {'system': platform.platform(),
    'ca_configured': any(os.environ.get(k) for k in ('CURL_CA_BUNDLE','SSL_CERT_FILE')),
    'curl': subprocess.check_output(['curl','--version'],text=True).splitlines()[0]}}), flush=True)
for name, method, path, headers in [
    ('hello_head','HEAD','/api/hello',[]),
    ('hello_get','GET','/api/hello',[]),
    ('models','GET','/v1/models',['-H','Anthropic-Version: 2023-06-01'])]:
    for i in range(samples):
        cmd = ['curl','--silent','--show-error','--output','/dev/null','--max-time',str(timeout),
               '--write-out',format,*headers]
        if method == 'HEAD': cmd.append('--head')
        result = subprocess.run([*cmd,'https://api.anthropic.com'+path],capture_output=True,text=True,timeout=timeout+5)
        timing = json.loads(result.stdout)
        timing.update(name=name, sample=i, exit_code=result.returncode)
        print(json.dumps(timing),flush=True)
'''


def owner_probes(log_path, output):
    # The session capability stays in memory and is never included in artifacts.
    match = re.search(r"(http://127\.0\.0\.1:\d+)/app/#session=([^\s]+)", log_path.read_text())
    if not match:
        raise ValueError("no local owner panel URL found in the supplied log")
    base, token = match.groups()
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    catalog = ""
    for path in ("/api/healthz", "/api/", "/api/", "/api/requests", "/api/healthz"):
        cached = path == "/api/" and bool(catalog)
        url = base + path + ("?catalog=" + catalog if cached else "")
        request = urllib.request.Request(url, headers={"X-Tinfoil-Session": token})
        start = time.monotonic()
        with opener.open(request, timeout=30) as response:
            headers_at = time.monotonic()
            data = response.read(32 * 1024 * 1024 + 1)
        result = dict(path=path, cached=cached, headers_ms=1000*(headers_at-start),
                      total_ms=1000*(time.monotonic()-start), bytes=len(data))
        if len(data) > 32 * 1024 * 1024:
            result["truncated"] = True
        else:
            value = json.loads(data)
            if path == "/api/":
                catalog = value.get("catalog_id", "")
                result["field_bytes"] = {k: len(json.dumps(v, separators=(",", ":")).encode()) for k,v in value.items()}
            if path == "/api/requests":
                # Only aggregate states and recognition. Do not export prompts,
                # tool arguments, URLs, credentials, or arbitrary policy text.
                result["records"] = len(value)
                result["states"] = dict(Counter(r.get("state") for r in value))
                result["unrecognized"] = sum(not r.get("facts", {}).get("operation") for r in value)
                result["hello_get"] = [dict(state=r.get("state"), recognized=bool(r.get("facts",{}).get("operation")),
                    requirements=[q.get("id") for q in r.get("requirements",[])]) for r in value
                    if r.get("facts",{}).get("details",{}).get("http",{}).get("path") == "/api/hello"
                    and r.get("facts",{}).get("details",{}).get("http",{}).get("method") == "GET"]
        output["owner"].append(result)
        print(json.dumps(result), flush=True)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--ssh", help="existing pinned SSH alias, e.g. sb2; omit to probe locally")
    p.add_argument("--samples", type=int, default=3)
    p.add_argument("--timeout", type=float, default=11)
    p.add_argument("--owner-panel-log", type=Path, help="stdout from an already running 'tinfoil monitor open'")
    p.add_argument("--output", type=Path, required=True)
    args = p.parse_args()
    if args.samples < 1 or not 0 < args.timeout <= 60:
        p.error("samples must be positive and timeout must be in (0,60]")
    if args.ssh and (args.ssh.startswith("-") or not re.fullmatch(r"[\w.@-]+", args.ssh)):
        p.error("use a plain SSH alias")
    output = dict(schema=1, complete=False, timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                  ssh=args.ssh, samples=args.samples, timeout=args.timeout, probes=[], owner=[])
    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open("x") as artifact:
        os.chmod(args.output, 0o600)
        cmd = ["python3", "-", str(args.samples), str(args.timeout)]
        if args.ssh:
            cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "--", args.ssh, shlex.join(cmd)]
        process = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        try:
            process.stdin.write(REMOTE)
            process.stdin.close()
            for line in process.stdout:
                row = json.loads(line)
                output["probes"].append(row)
                print(json.dumps(row), flush=True)
            if process.wait():
                raise RuntimeError("sandbox probe command failed")
            if args.owner_panel_log:
                owner_probes(args.owner_panel_log, output)
            output["complete"] = True
        finally:
            if process.poll() is None:
                process.terminate()
                process.wait()
            json.dump(output, artifact, indent=2)
            artifact.write("\n")
    # A timed-out probe is an observed result, not a harness execution failure.
    return 0


if __name__ == "__main__":
    sys.exit(main())
