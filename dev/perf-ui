            browser("click", "[aria-label='Access for sandbox-sb2'] button:nth-child(3)")
            results["checks"]["selecting_agent_access_expands_actions"] = browser("attr", "button[aria-label='Actions for sandbox-sb2']", "aria-expanded").stdout.strip() == "true"
            results["checks"]["agent_effects_collapsed_initially"] = (
