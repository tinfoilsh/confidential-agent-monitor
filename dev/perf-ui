#!/usr/bin/env python3
"""Exercise the real Monitor UI with slow, synthetic owner API responses."""
import argparse
import datetime
import hashlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import mimetypes
import os
from pathlib import Path
import subprocess
import threading
import time
from urllib.parse import unquote, urlsplit
from urllib.request import urlopen

ROOT = Path(__file__).resolve().parent.parent


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT)


class Fixture:
    def __init__(self, ref, dev_url=None, assets_dir=None):
        self.ref = ref
        self.dev_url = dev_url
        self.assets_dir = assets_dir or ROOT / "ui/dist"
        self.content_types = {}
        self.condition = threading.Condition()
        self.delay = 0
        self.state = None
        self.fail_reads = False
        self.calls = []
        self.active = self.peak = 0
        self.decided = None
        self.created = datetime.datetime.now(datetime.timezone.utc)
        self.assets = {}
        self.writes = []
        self.fail_writes = 0
        self.write_gate = threading.Event()
        self.write_gate.set()
        self.view = dict(generation=1, config=dict(
            data=dict(onboarding=dict(completed=True)),
            identities={"sandbox-sb2": {"accounts": {"anthropic": {"level": "allow"}}}},
            accounts={"anthropic": {"preset": "anthropic"}},
            lattices={"confidentiality": False, "integrity": False}),
            labels={}, status={}, fields={}, vocabulary={}, presets={name: dict(title=name.title(), fields=[], actions={}, operations={})
                                           for name in ("anthropic", "custom")})

    def asset(self, path):
        relative = Path(unquote(path).lstrip("/"))
        if not relative.parts or relative.parts[0] != "app" or ".." in relative.parts:
            raise FileNotFoundError(path)
        if str(relative) == "app":
            relative /= "index.html"
        name = relative.as_posix()
        if name not in self.assets:
            if self.dev_url:
                with urlopen(self.dev_url.rstrip("/") + "/" + name) as response:
                    self.assets[name] = response.read()
                    self.content_types[name] = response.headers.get("Content-Type", "application/octet-stream")
            else:
                self.assets[name] = git("show", f"{self.ref}:{name}") if self.ref else (self.assets_dir / relative.relative_to("app")).read_bytes()
            if not self.ref and name.endswith(".html"):
                # Observe actual intermediate heights, not just CSS declarations.
                self.assets[name] = self.assets[name].replace(b"</body>", b'''<script>
                  document.addEventListener("click", event => {
                    if (event.target.closest("button, a, input, select, textarea")) return;
                    const summary = event.target.closest("summary");
                    const element = summary?.parentElement;
                    if (!(element instanceof HTMLDetailsElement)) return;
                    const opening = !element.open, heights = new Set(), samples = [], start = performance.now();
                    const summaryY = summary.getBoundingClientRect().y;
                    let summaryShift = 0;
                    const duration = element.classList.contains("request-item") ? 1250 : 300;
                    const workspace = document.getElementById("workspace");
                    delete element.dataset[opening ? "openMotion" : "closeMotion"];
                    delete element.dataset[opening ? "openSummaryShift" : "closeSummaryShift"];
                    function sample() {
                      const height = Math.round(element.getBoundingClientRect().height);
                      heights.add(height);
                      summaryShift = Math.max(summaryShift, Math.abs(summary.getBoundingClientRect().y - summaryY));
                      samples.push([Math.round(performance.now() - start), height, element.open, element.getAnimations().length, Math.round(summary.getBoundingClientRect().y), Math.round(workspace?.scrollTop ?? 0)]);
                      if (performance.now() - start < duration) requestAnimationFrame(sample);
                      else {
                        element.dataset[opening ? "openMotion" : "closeMotion"] = String(heights.size > 2);
                        element.dataset[opening ? "openSummaryShift" : "closeSummaryShift"] = String(summaryShift);
                        element.dataset.motionSamples = JSON.stringify(samples);
                      }
                    }
                    sample();
                  }, true);
                  new MutationObserver(records => {
                    for (const {target, attributeName} of records) {
                      if (attributeName !== "data-closing" || !target.hasAttribute("data-closing")) continue;
                      const opacity = new Set(), backdrop = new Set(), start = performance.now();
                      function sample() {
                        if (target.open) {
                          opacity.add(Number(getComputedStyle(target).opacity).toFixed(2));
                          backdrop.add(getComputedStyle(target, "::backdrop").backgroundColor);
                        }
                        if (performance.now() - start < 300) requestAnimationFrame(sample);
                        else {
                          target.dataset.exitMotion = String(opacity.size > 2);
                          target.dataset.backdropMotion = String(backdrop.size > 2);
                        }
                      }
                      sample();
                    }
                  }).observe(document.body, {subtree: true, attributes: true, attributeFilter: ["data-closing"]});
                </script></body>''')
        return self.assets[name], self.content_types.get(name) or mimetypes.guess_type(name)[0] or "application/octet-stream"

    def read(self, path, summary=False):
        with self.condition:
            self.active += 1
            self.peak = max(self.peak, self.active)
            call = dict(path=path, started=time.monotonic(), state=self.state)
            self.calls.append(call)
            delay, failed = self.delay, self.fail_reads
            call["status"] = 503 if failed else 200
            now = self.created
            record = dict(id="synthetic-approval", state=self.state, time=now.isoformat(),
                          expires=(now + datetime.timedelta(seconds=120)).isoformat(),
                          facts=dict(principal=dict(name="sandbox-sb2"), account="anthropic",
                                     title="GET api.anthropic.com/api/hello",
                                     parameters=dict(message="Synthetic request payload", body="x" * 262144),
                                     details=dict(http=dict(method="GET", host="api.anthropic.com", path="/api/hello"))),
                          requirements=[dict(id="ask", message="This request has no recognized operation on anthropic.")])
            if summary:
                record = {key: record[key] for key in ("id", "state", "time", "expires")} | {
                    "summary": True, "facts": {key: record["facts"][key] for key in ("principal", "account", "title")}}
            # Capture at request start so an approval can make this response stale.
            value = self.view if path == "/api/" else record if path.startswith("/api/requests/") else [record] if self.state else []
            body = json.dumps(value).encode()
            self.condition.notify_all()
        time.sleep(delay)
        return call, (503 if failed else 200), (b"Synthetic read failure" if failed else body)

    def until(self, predicate, timeout):
        with self.condition:
            if not self.condition.wait_for(predicate, timeout):
                raise TimeoutError("Fixture did not reach the expected API state")

    def handler(self):
        fixture = self

        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *_):
                pass

            def respond(self, body, content_type="application/json", status=200, tag=None):
                self.send_response(status)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                if tag:
                    self.send_header("ETag", tag)
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                path = urlsplit(self.path).path
                if path == "/app/auth.json":
                    return self.respond(b'{"mode":"ssh"}')
                if path in ("/api/", "/api/requests", "/api/requests/synthetic-approval"):
                    call, status, body = fixture.read(path, summary=urlsplit(self.path).query == "summary")
                    tag = 'W/"' + hashlib.sha256(body).hexdigest() + '"' if status == 200 else None
                    if tag and self.headers.get("If-None-Match") == tag:
                        status, body = 304, b""
                    call["status"], call["bytes"] = status, len(body)
                    try:
                        self.respond(body, status=status, tag=tag)
                    except (BrokenPipeError, ConnectionResetError):
                        pass
                    finally:
                        with fixture.condition:
                            call["finished"] = time.monotonic()
                            fixture.active -= 1
                            fixture.condition.notify_all()
                    return
                try:
                    body, content_type = fixture.asset(path)
                except (FileNotFoundError, subprocess.CalledProcessError):
                    return self.respond(b"Not found", status=404)
                self.respond(body, content_type)

            def do_POST(self):
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                path = unquote(urlsplit(self.path).path)
                with fixture.condition:
                    call = dict(path=path, body=body)
                    fixture.writes.append(call)
                    failed = fixture.fail_writes > 0
                    fixture.fail_writes = max(0, fixture.fail_writes - 1)
                    fixture.condition.notify_all()
                if not fixture.write_gate.wait(20):
                    return self.respond(b"Fixture write timed out", status=503)
                with fixture.condition:
                    if failed:
                        result, status = b"Synthetic save failure", 503
                    elif path == "/api/policy/edits":
                        for change in body["changes"]:
                            parent = fixture.view["config"]
                            for key in change["path"][:-1]:
                                parent = parent.setdefault(key, {})
                            key = change["path"][-1]
                            if change.get("delete"):
                                parent.pop(key, None)
                            else:
                                parent[key] = change["value"]
                        fixture.view["generation"] += 1
                        result, status = json.dumps(fixture.view).encode(), 200
                    elif path.startswith("/api/labels/"):
                        fixture.view["labels"][path.removeprefix("/api/labels/")] = body
                        result, status = json.dumps(fixture.view).encode(), 200
                    elif path == "/api/requests/synthetic-approval" and body == {"decision": "once"}:
                        fixture.state = "approved"
                        fixture.decided = time.monotonic()
                        result, status = b"null", 200
                    else:
                        result, status = b"Unexpected fixture write", 400
                    call["finished"] = True
                    fixture.condition.notify_all()
                self.respond(result, status=status)

        return Handler


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ref", help="serve app assets from this Git ref instead of the working tree")
    parser.add_argument("--dev-url", help="read app assets from the running development server")
    parser.add_argument("--assets", type=Path, help="serve an alternate production dist directory")
    parser.add_argument("--delay", type=float, default=6.5, help="owner response latency in seconds")
    parser.add_argument("--output", type=Path, required=True, help="new JSON result file")
    args = parser.parse_args()
    if not 0.5 <= args.delay <= 12:
        parser.error("--delay must be between 0.5 and 12 seconds")
    if args.output.exists():
        parser.error("output file already exists")
    ref = git("rev-parse", "--verify", args.ref + "^{commit}").decode().strip() if args.ref else None
    fixture = Fixture(ref, args.dev_url, args.assets)
    if not ref:
        fixture.view["config"]["lattices"] = dict(confidentiality=True, integrity=True)
        fixture.view["presets"]["anthropic"]["actions"] = {
            "messages.read": {"title": "Read messages", "effects": ["read", "admin"]},
            "messages.delete": {"title": "Delete messages", "effects": ["delete"]}}
        fixture.view["vocabulary"] = {"read": {}, "delete": {"change": True}, "admin": {}}
        fixture.view["config"]["accounts"]["anthropic"]["connections"] = {
            "": {"http": {"slots": [
                dict(value="token", origin="https://api.example.test", header="Authorization", prefix="Bearer "),
                dict(value="token", origin="https://api.example.test", header="Authorization", prefix="token "),
                dict(value="token", origin="https://example.test", basic="password")] }},
            "secondary": {"http": {"slots": [dict(value="key", origin="https://secondary.example.test", query="api_key")]}}}
        fixture.view["fields"]["anthropic"] = [
            dict(path=["connections", "", "http", "secrets", "token"], kind="unset", placeholder="monitor_test_token"),
            dict(path=["connections", "secondary", "http", "secrets", "key"], kind="unset", placeholder="monitor_test_secondary")]
    results = dict(schema=1, source=ref or "working-tree", head=git("rev-parse", "HEAD").decode().strip(),
                   timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                   harness_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
                   delay_seconds=args.delay, checks={}, complete=False)
    session = json.loads(subprocess.check_output(["pinchtab", "session", "create", "--agent-id", "monitor-perf", "--json"]))
    env = dict(os.environ, PINCHTAB_SESSION=session["sessionToken"])

    def browser(*command, check=True):
        if command[0] == "wait":
            command = (*command, "--json")
        response = subprocess.run(["pinchtab", *command], env=env, capture_output=True, text=True, timeout=40)
        # PinchTab reports a timed-out wait as JSON with exit status zero.
        if command[0] == "wait" and not response.returncode:
            response.returncode = 0 if json.loads(response.stdout).get("waited") is True else 1
        if response.stderr.strip().startswith("Error "):
            response.returncode = 1
        if check and response.returncode:
            raise RuntimeError(f"pinchtab {command[0]} failed: {response.stderr.strip() or response.stdout.strip()}")
        return response

    server = ThreadingHTTPServer(("127.0.0.1", 0), fixture.handler())
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    tab = None
    try:
        address = f"http://127.0.0.1:{server.server_port}/app/#session=perf-fixture"
        tab = browser("nav", address, "--snap").stdout.splitlines()[0].strip()
        browser("tab", tab)
        browser("wait", "#tree a[href='#activity']")
        if not ref:
            browser("click", "#tree a[href='#agents']")
            browser("fill", "input[aria-label='Search agents']", "sandbox")
            browser("click", "summary.resource-row")
            browser("wait", ".agent-item[data-open-motion]")
            results["checks"]["agent_expansion_animates_height"] = browser("count", ".agent-item[data-open-motion='true']").stdout.strip() == "1"
            browser("click", ".agent-item > summary")
            browser("wait", ".agent-item[data-close-motion]")
            results["checks"]["agent_collapse_animates_height"] = browser("count", ".agent-item[data-close-motion='true']").stdout.strip() == "1"
            browser("click", ".agent-item > summary")
            results["checks"]["collapsed_access_actions_not_mounted"] = browser("count", ".acct .access-actions").stdout.strip() == "0"
            results["checks"]["agent_connection_icon"] = browser("attr", "button[aria-label='Actions for anthropic'] .light-icon", "src").stdout.strip().endswith("/anthropic.svg")
            browser("click", "button[aria-label='Refresh monitor']")
            results["checks"]["permission_survives_refresh"] = browser("attr", "[aria-label='Default access for anthropic'] button:nth-child(4)", "aria-pressed").stdout.strip() == "true"
            audience = "select[aria-label='Audience']"
            trust = "select[aria-label='Trust']"
            access = "[aria-label='Default access for anthropic']"
            access_ask = access + " button:nth-child(3)"
            box = lambda selector: json.loads(browser("box", selector, "--json").stdout)["box"]
            audience_box, trust_box = box(audience), box(trust)
            results["checks"]["labels_aligned"] = audience_box["y"] == trust_box["y"] and audience_box["height"] == trust_box["height"]
            results["checks"]["agent_uses_panel_width"] = box(".agent-access")["width"] == box(".agent-inline")["width"] - 40
            # Keep the first write pending while making two more edits, then fail
            # it. The later edits must remain visible and save in order.
            fixture.fail_writes = 1
            fixture.write_gate.clear()
            browser("select", audience, "me")
            fixture.until(lambda: len(fixture.writes) == 1, 5)
            browser("select", trust, "untrusted")
            browser("click", access_ask)
            results["checks"]["optimistic_edits"] = (
                browser("value", audience).stdout.strip() == "me"
                and browser("value", trust).stdout.strip() == "untrusted"
                and browser("attr", access_ask, "aria-pressed").stdout.strip() == "true")
            results["checks"]["writes_serialized"] = len(fixture.writes) == 1
            fixture.write_gate.set()
            fixture.until(lambda: len(fixture.writes) == 3 and all(c.get("finished") for c in fixture.writes), 5)
            browser("wait", "#saving", "--state", "hidden")
            results["checks"]["failed_edit_rolls_back_only_itself"] = (
                browser("value", audience).stdout.strip() == "anyone"
                and browser("value", trust).stdout.strip() == "untrusted"
                and browser("attr", access_ask, "aria-pressed").stdout.strip() == "true")
