            results["checks"]["selecting_connection_access_expands_actions"] = browser("attr", "button[aria-label='Actions for anthropic']", "aria-expanded").stdout.strip() == "true"
            results["checks"]["collapsed_nested_actions_not_mounted"] = browser("count", ".access-children .access-action").stdout.strip() == "0"
            browser("click", "summary[aria-label='Messages']")
            fixture.write_gate.clear()
            browser("click", "button[aria-label='Deny messages.delete']")
            fixture.until(lambda: len(fixture.writes) == 4, 5)
            browser("click", "button[aria-label='Ask messages.read']")
            results["checks"]["individual_actions_optimistic"] = (
                browser("attr", "button[aria-label='Deny messages.delete']", "aria-pressed").stdout.strip() == "true"
                and browser("attr", "button[aria-label='Ask messages.read']", "aria-pressed").stdout.strip() == "true")
            fixture.write_gate.set()
            fixture.until(lambda: len(fixture.writes) == 5 and all(c.get("finished") for c in fixture.writes), 5)
            browser("wait", "#saving", "--state", "hidden")
            browser("click", "button[aria-label='Refresh monitor']")
            results["checks"]["individual_actions_survive_refresh"] = (
                browser("attr", "button[aria-label='Deny messages.delete']", "aria-pressed").stdout.strip() == "true"
                and browser("attr", "button[aria-label='Ask messages.read']", "aria-pressed").stdout.strip() == "true")
            browser("click", "button[aria-label='Deny messages.delete']")
            fixture.until(lambda: len(fixture.writes) == 6 and fixture.writes[-1].get("finished"), 5)
            browser("wait", "#saving", "--state", "hidden")
            results["checks"]["unset_action_keeps_other_overrides"] = (
                "messages.delete" not in fixture.view["config"]["identities"]["sandbox-sb2"]["accounts"]["anthropic"]["actions"]
                and browser("attr", "button[aria-label='Ask messages.read']", "aria-pressed").stdout.strip() == "true")
            results["checks"]["settings_inside_expanded_agent"] = (
                browser("visible", ".agent-item[open] .agent-settings").stdout.strip() == "true"
                and browser("count", ".agent-inline a[href^='#agent/']").stdout.strip() == "0")
            results["checks"]["advanced_agent_settings_hidden_initially"] = browser("count", "textarea[aria-label='Replacement public key']").stdout.strip() == "0"
            browser("click", ".agent-settings input[role='switch']")
            fixture.until(lambda: fixture.view["config"]["identities"]["sandbox-sb2"].get("routes") is True, 5)
            browser("wait", "#saving", "--state", "hidden")
            results["checks"]["inline_agent_settings_save"] = "Sandbox connectivity enabled" in browser("text", ".agent-item > summary").stdout
            browser("click", ".agent-maintenance > summary")
            browser("wait", "textarea[aria-label='Replacement public key']")
            browser("fill", "textarea[aria-label='Replacement public key']", "unfinished key draft")
            browser("click", ".agent-item > summary")
            browser("wait", ".agent-item:not([open])")
            browser("click", ".agent-item > summary")
            results["checks"]["agent_settings_draft_survives_collapse"] = browser("value", "textarea[aria-label='Replacement public key']").stdout.strip() == "unfinished key draft"
            header_height = json.loads(browser("box", "a[href='#pair']", "--json").stdout)["box"]["height"]
            results["checks"]["header_button_heights_match"] = header_height == box("button[aria-label='Refresh monitor']")["height"]
            fixture.write_gate.clear()
            browser("click", ".agent-settings input[role='switch']")
            browser("click", "a[href='#pair']")
            fixture.write_gate.set()
            browser("wait", "#saving", "--state", "hidden")
            results["checks"]["page_save_notice_stays_out_of_dialog"] = browser("count", ".dialog-notice").stdout.strip() == "0"
            results["checks"]["pair_keeps_page_search"] = (
                browser("count", "input[aria-label='Search agents']").stdout.strip() == "1"
                and browser("value", "input[aria-label='Search agents']").stdout.strip() == "sandbox")
            deadline = time.monotonic() + 2
            while time.monotonic() < deadline and abs(box("dialog button.primary")["height"] - header_height) > .01:
                time.sleep(.02)
            results["checks"]["consistent_button_height"] = abs(box("dialog button.primary")["height"] - header_height) < .01
            browser("click", "button[aria-label='Close dialog']")
            browser("wait", "dialog[open]", "--state", "hidden")
            browser("wait", "dialog[data-exit-motion]")
            results["checks"]["dialog_fades_out"] = browser("attr", "dialog", "data-exit-motion").stdout.strip() == "true"
            results["checks"]["dialog_backdrop_fades_out"] = browser("attr", "dialog", "data-backdrop-motion").stdout.strip() == "true"
            results["checks"]["pair_restores_search"] = browser("value", "input[aria-label='Search agents']").stdout.strip() == "sandbox"
            browser("click", "a[href='#pair']")
            browser("press", "Escape")
            browser("wait", "dialog[open]", "--state", "hidden")
            results["checks"]["escape_restores_focus"] = browser("count", "a[href='#pair']:focus").stdout.strip() == "1"
            browser("click", "#tree a[href='#accounts']")
            browser("fill", "input[aria-label='Search connections']", "anth")
            browser("click", ".connection-item > summary")
            browser("wait", ".connection-detail")
            results["checks"]["connection_expands_in_list"] = (
                browser("url").stdout.strip().endswith("#accounts")
                and browser("count", ".connection-item[open] .connection-detail").stdout.strip() == "1")
            results["checks"]["connection_uses_panel_width"] = box(".connection-detail")["width"] == box(".connection-inline")["width"] - 40
            browser("wait", ".connection-item[data-open-motion]")
            results["checks"]["connection_expansion_animates_height"] = browser("count", ".connection-item[data-open-motion='true']").stdout.strip() == "1"
            results["checks"]["all_credential_placeholders_visible"] = (
                browser("count", ".agent-setup-item").stdout.strip() == "2"
                and browser("value", ".agent-setup-item:first-of-type input").stdout.strip() == "monitor_test_token"
                and browser("value", ".agent-setup-item:last-of-type input").stdout.strip() == "monitor_test_secondary")
            results["checks"]["credential_formats_collapsed_initially"] = browser("count", ".agent-setup-usage[open]").stdout.strip() == "0"
            browser("click", ".agent-setup-item:first-of-type .agent-setup-usage > summary")
            browser("click", ".agent-setup-item:last-of-type .agent-setup-usage > summary")
            browser("click", ".connection-advanced > summary")
            setup_text = browser("text", ".connection-detail").stdout
            results["checks"]["connection_sharing_and_effects_under_advanced"] = setup_text.index("Agent setup") < setup_text.index("Connection settings") < setup_text.index("Advanced") < setup_text.index("Data sharing") < setup_text.index("Effects") < setup_text.index("Custom policy")
