#!/usr/bin/env python3
"""Reproducible Monitor performance experiments; no real provider credentials."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def integers(value):
    result = [int(v) for v in value.split(",")]
    if not result or min(result) < 0 or result != sorted(set(result)):
        raise argparse.ArgumentTypeError("use sorted, unique nonnegative integers")
    return result


def capture(*args):
    return subprocess.check_output(args, cwd=ROOT, text=True).strip()


def compare(before, after, threshold):
    if not before.get("complete") or not after.get("complete"):
        raise ValueError("comparison requires two completed runs")
    keys = ("Modes", "Sizes", "Histories", "Samples", "HistoryBodyBytes")
    if any(before["config"][k] != after["config"][k] for k in keys):
        raise ValueError("scenario configurations differ; rerun with matching arguments")
    if before["gomaxprocs"] != after["gomaxprocs"]:
        raise ValueError("GOMAXPROCS differs")
    if before.get("metadata", {}).get("memory_limit") != after.get("metadata", {}).get("memory_limit"):
        raise ValueError("parent memory limits differ")
    for key in ("platform", "affinity", "harness_sha256"):
        if before.get("metadata", {}).get(key) != after.get("metadata", {}).get(key):
            print(f"Comparison note: {key} changed; review comparability.", file=sys.stderr)
    old = {r["name"]: r for r in before["results"]}
    new = {r["name"]: r for r in after["results"]}
    if old.keys() != new.keys():
        raise ValueError("scenario sets differ")
    failed = False
    print("\nComparison (candidate / baseline):")
    for name, row in new.items():
        ratios = {k: row[k] / old[name][k] if old[name][k] else 1.0
                  for k in ("p50_ms", "p95_ms", "alloc_bytes_per_op", "heap_bytes")}
        print(f"{name:52} p50 {ratios['p50_ms']:6.2f}x  p95 {ratios['p95_ms']:6.2f}x  "
              f"alloc {ratios['alloc_bytes_per_op']:6.2f}x  heap {ratios['heap_bytes']:6.2f}x")
        failed |= ratios["p95_ms"] > 1 + threshold / 100
    return failed


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--output", type=Path, required=True, help="new artifact directory")
    p.add_argument("--modes", default="direct,inprocess,worker")
    p.add_argument("--sizes", type=integers, default=integers("0,4096,65536,524288"))
    p.add_argument("--histories", type=integers, default=integers("0,25,100"))
    p.add_argument("--history-body", type=int, default=262144)
    p.add_argument("--samples", type=int, default=20)
    p.add_argument("--cpus", type=int, default=2, help="Go parallelism and shared process CPU affinity on Linux")
    p.add_argument("--memory", default="1536MiB", help="parent Go soft memory limit, not a cgroup limit")
    p.add_argument("--scenario", default="TestPerformance", help="Go test subtest expression")
    p.add_argument("--compare", type=Path, help="baseline results.json")
    p.add_argument("--fail-regression", type=float, help="exit 2 if any p95 grows by this percentage")
    args = p.parse_args()
    modes = args.modes.split(",") if args.modes else []
    if set(modes) - {"direct", "inprocess", "worker"} or args.samples < 1 or args.cpus < 1:
        p.error("invalid mode, sample count, or CPU count")
    if max(args.sizes) > 1000000 or not 0 <= args.history_body <= 1000000:
        p.error("bodies must fit the connector's 1 MiB inspection limit")
    if args.fail_regression is not None and (args.compare is None or args.fail_regression < 0):
        p.error("--fail-regression requires --compare and a nonnegative percentage")
    if "worker" in modes and not shutil.which("bwrap"):
        p.error("worker mode requires bubblewrap (or use --modes inprocess)")
    out = args.output.resolve()
    out.mkdir(parents=True, exist_ok=False)
    affinity = None
    if hasattr(os, "sched_getaffinity"):
        affinity = sorted(os.sched_getaffinity(0))[:args.cpus]
        if len(affinity) != args.cpus:
            p.error("not enough CPUs in this process's allowed affinity")
        os.sched_setaffinity(0, affinity)
    worker_root = out / "worker-root"
    for name in ("etc/ssl/certs", "dev", "proc", "tmp"):
        (worker_root / name).mkdir(parents=True)
    for name in ("worker", "broker.sock"):
        (worker_root / name).touch()
    config = dict(Output=str(out / "results.json"), WorkerExecutable=str(out / "monitor"),
                  WorkerRoot=str(worker_root), Modes=modes, Sizes=args.sizes,
                  Histories=args.histories, Samples=args.samples, HistoryBodyBytes=args.history_body)
    (out / "config.json").write_text(json.dumps(config, indent=2) + "\n")
    env = dict(os.environ, GOWORK="off", CGO_ENABLED="0", GOMAXPROCS=str(args.cpus),
               GOMEMLIMIT=args.memory, MONITOR_PERF_CONFIG=str(out / "config.json"))
    metadata = dict(timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                    checkout=str(ROOT), head=capture("git", "rev-parse", "HEAD"),
                    upstream=capture("git", "rev-parse", "origin/main"),
                    status=capture("git", "status", "--porcelain=v1", "--untracked-files=all"),
                    diff_sha256=hashlib.sha256(subprocess.check_output(["git", "diff", "HEAD"], cwd=ROOT)).hexdigest(),
                    harness_sha256=hashlib.sha256((ROOT / "performance_test.go").read_bytes()).hexdigest(),
                    platform=platform.platform(), cpu_count=os.cpu_count(), memory_limit=args.memory,
                    affinity=affinity,
                    bubblewrap=capture("bwrap", "--version") if "worker" in modes else None,
                    command=sys.argv)
    (out / "metadata.json").write_text(json.dumps(metadata, indent=2) + "\n")
    subprocess.run(["go", "build", "-mod=readonly", "-o", str(out / "monitor"), "."], cwd=ROOT, env=env, check=True)
    subprocess.run(["go", "test", "-mod=readonly", "-c", "-tags", "performance", "-o", str(out / "harness"), "."],
                   cwd=ROOT, env=env, check=True)
    cmd = [str(out / "harness"), "-test.v", "-test.run", args.scenario, "-test.timeout", "20m",
           "-test.cpuprofile", str(out / "cpu.pprof"), "-test.memprofile", str(out / "heap.pprof"),
           "-test.mutexprofile", str(out / "mutex.pprof"), "-test.blockprofile", str(out / "block.pprof")]
    with (out / "run.log").open("w") as log:
        process = subprocess.Popen(cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        try:
            for line in process.stdout:
                print(line, end="", flush=True)
                log.write(line)
                log.flush()
            code = process.wait()
        except KeyboardInterrupt:
            process.terminate()
            process.wait()
            raise
    if code:
        print(f"Experiment failed; partial artifacts: {out}", file=sys.stderr)
        return code
    if not (out / "results.json").exists():
        print("No performance scenarios ran; check --scenario", file=sys.stderr)
        return 1
    results = json.loads((out / "results.json").read_text())
    results["complete"] = True
    results["metadata"] = metadata
    (out / "results.json").write_text(json.dumps(results, indent=2) + "\n")
    print(f"\nArtifacts: {out}\nCPU profile: go tool pprof -top {out / 'harness'} {out / 'cpu.pprof'}")
    if args.compare:
        failed = compare(json.loads(args.compare.read_text()), results,
                         25 if args.fail_regression is None else args.fail_regression)
        if failed and args.fail_regression is not None:
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
