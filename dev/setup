#!/usr/bin/env bash
# Writes .dev/ so stock ssh, proxied tools, and a throwaway Firefox profile reach the
# monitor without touching ~/.ssh, /etc, or the system trust store.
set -euo pipefail
cd "$(dirname "$0")/.."
dev=$PWD/.dev
socks_host=127.0.0.1 socks_port=1080
listen=${MONITOR_LISTEN:-127.0.0.1:2223} api=${MONITOR_API:-http://127.0.0.1:8080}
host=${listen%:*} port=${listen##*:}

umask 077
mkdir -p "$dev/firefox"
[[ -f $dev/id ]] || ssh-keygen -q -t ed25519 -N '' -C monitor-dev -f "$dev/id"
[[ -f $dev/owner.key ]] || head -c32 /dev/urandom | base64 > "$dev/owner.key"
if ! curl --max-time 1 -fs "$api/healthz" > /dev/null; then
  CGO_ENABLED=0 setsid bun dev/run.ts -listen "$listen" -api "${api#http://}" \
    > "$dev/monitor.log" 2>&1 < /dev/null &
  monitor_pid=$!
  deadline=$((SECONDS + 30))
  until curl --max-time 1 -fs "$api/healthz" > /dev/null; do
    if ! kill -0 "$monitor_pid" 2>/dev/null || ((SECONDS >= deadline)); then
      cat "$dev/monitor.log" >&2
      echo "Monitor did not become ready at $api" >&2
      exit 1
    fi
    sleep 0.1
  done
fi
# The header file keeps the owner secret out of curl's arguments.
owner() { curl -sS --fail-with-body --retry 10 --retry-connrefused -H @<(echo "Authorization: Bearer $(<"$dev/owner.key")") "$api$1" "${@:2}"; }
owner /unlock -d '{"generation": 0}' > "$dev/state.next.json" || {
  echo "Cannot unlock $api with $dev/owner.key:" >&2
  cat "$dev/state.next.json" >&2
  exit 1
}
mv "$dev/state.next.json" "$dev/state.json"
# Seed a fresh store with just Web. Import a custom config only when explicitly
# requested; subsequent runs keep the connections and credentials edited in the app.
if jq -e '.generation == 1 and ((.config.connections // {}) | length == 0) and ((.config.identities // {}) | length == 0)' "$dev/state.json" > /dev/null; then
  if [[ -n ${MONITOR_CONFIG:-} ]]; then
    cp "$MONITOR_CONFIG" "$dev/seed.json"
  else
    jq '{connections: {web: ({preset: "web"} + .catalog.defaults)}}' \
      presets/web.json > "$dev/seed.json"
  fi
  jq '{changes: [to_entries[] | {path: [.key], value: .value}]}' "$dev/seed.json" | owner /policy/edits -d @- > "$dev/state.json"
fi
jq --arg key "$(<"$dev/id.pub")" \
  '.config as $config | ($config.identities.dev // {}) as $dev |
   {identities: {dev: ($dev + {key: $key,
     connections: (($config.connections // {}) | with_entries(.value = ($dev.connections[.key] // {level: "allow"})))})}}' "$dev/state.json" |
  jq '{changes: [{path: ["identities", "dev"], value: .identities.dev}]}' | owner /policy/edits -d @- > "$dev/state.next.json"
mv "$dev/state.next.json" "$dev/state.json"
echo "perimeter,*.perimeter,[$host]:$port $(jq -r .host_key "$dev/state.json")" > "$dev/known_hosts"
jq -r .ca "$dev/state.json" > "$dev/ca.pem"

cat > "$dev/ssh_config" <<CONF
Host perimeter
  HostName $host
  Port $port
Host *.perimeter
  ProxyJump perimeter
Host *
  User monitor
  IdentityFile $dev/id
  IdentitiesOnly yes
  IdentityAgent none
  UserKnownHostsFile $dev/known_hosts
  GlobalKnownHostsFile /dev/null
  StrictHostKeyChecking yes
  ControlPath none
CONF

cat > "$dev/proxychains.conf" <<CONF
strict_chain
proxy_dns
quiet_mode
[ProxyList]
socks5 $socks_host $socks_port
CONF

{
  proxy=socks5h://$socks_host:$socks_port
  echo "export ALL_PROXY=$proxy HTTPS_PROXY=$proxy HTTP_PROXY=$proxy NO_PROXY="
  for var in SSL_CERT_FILE CURL_CA_BUNDLE NODE_EXTRA_CA_CERTS REQUESTS_CA_BUNDLE GIT_SSL_CAINFO PGSSLROOTCERT; do
    echo "export $var=$dev/ca.pem"
  done
} > "$dev/env"

cat > "$dev/firefox/user.js" <<CONF
user_pref("network.proxy.type", 1);
user_pref("network.proxy.socks", "$socks_host");
user_pref("network.proxy.socks_port", $socks_port);
user_pref("network.proxy.socks_version", 5);
user_pref("network.proxy.socks_remote_dns", true);
user_pref("network.http.http3.enable", false);
user_pref("network.trr.mode", 5);
CONF
certutil() { nix shell nixpkgs#nss.tools -c certutil "$@"; }
[[ -f $dev/firefox/cert9.db ]] || certutil -N -d "sql:$dev/firefox" --empty-password
certutil -A -d "sql:$dev/firefox" -n monitor -t C,, -i "$dev/ca.pem"

cat <<USAGE
ssh -F .dev/ssh_config -N -D $socks_host:$socks_port perimeter &
source .dev/env
ssh -F .dev/ssh_config <name>.perimeter
ssh -F .dev/ssh_config <name>.perimeter <command>
ssh -F .dev/ssh_config -N -L /tmp/agent.sock:<name>.perimeter:1 perimeter &
nix run nixpkgs#proxychains-ng -- -f .dev/proxychains.conf psql postgres://x:x@<name>.perimeter/x
firefox --no-remote --profile .dev/firefox
USAGE
