#!/usr/bin/env bash
# Boots the sandbox's local mode under Podman, using its normal Monitor network service.
set -euo pipefail
cd "$(dirname "$0")/.."
dev=$PWD/.dev
src=$(realpath "${SANDBOX_SRC:-../confidential-agent-sandbox}")
[[ -f $src/Dockerfile ]] || { printf 'SANDBOX_SRC must contain a Dockerfile: %s\n' "$src" >&2; exit 1; }
name=${SANDBOX_NAME:-sandbox-dev}
listen=${MONITOR_LISTEN:-127.0.0.1:2223}
toolchain=$(realpath "${SANDBOX_TOOLCHAIN:?set to a nix-closure pack.sh STAGE or STAGE/nix directory}")
# Mount the full stage, including its Nix database and default profile.
if [[ ${toolchain##*/} == nix && -d $toolchain/store ]]; then
  toolchain=$(dirname "$toolchain")
fi
[[ -d $toolchain/nix/store ]] || { printf 'SANDBOX_TOOLCHAIN must point to STAGE or STAGE/nix; missing %s/nix/store\n' "$toolchain" >&2; exit 1; }

podman build -q -t "$name" "$src" > /dev/null
podman rm -f --ignore "$name" > /dev/null
pkill -f "^$dev/monitor " && pidwait -f "^$dev/monitor " || true
dev/setup > /dev/null
printf 'Monitor UI with hot reload: %s/app/\n' "${MONITOR_API:-http://127.0.0.1:8080}"
# Mount only the agent identity and public configuration, never the owner's key/store.
sed -e 's|IdentityFile .*|IdentityFile /run/monitor/id|' \
    -e 's|UserKnownHostsFile .*|UserKnownHostsFile /run/monitor/known_hosts|' \
    "$dev/ssh_config" > "$dev/sandbox-ssh.conf"
# The reverse service publishes the sandbox's SSH for Monitor shells.
printf 'Host monitor\n  ExitOnForwardFailure yes\n  RemoteForward 127.0.0.1:22 127.0.0.1:22\n' |
  cat "$dev/sandbox-ssh.conf" - > "$dev/sandbox-reverse.conf"
podman run -d --name "$name" --hostname workspace --privileged --systemd=always \
  --userns=keep-id --user root --network "pasta:-T,${listen##*:}" --dns 100.127.255.2 \
  -v "$name:/mnt/disk" -v "$name:/nix" -v "$toolchain:/tinfoil/models/nix:ro" \
  -v "$dev/id:/run/monitor/id:ro" -v "$dev/id.pub:/run/monitor/id.pub:ro" \
  -v "$dev/known_hosts:/run/monitor/known_hosts:ro" \
  -v "$dev/monitor_authorized_keys:/run/monitor/authorized_keys:ro" \
  -v "$dev/sandbox-ssh.conf:/etc/ssh/ssh_config.d/monitor.conf:ro" \
  -v "$dev/sandbox-reverse.conf:/etc/ssh/monitor-reverse.conf:ro" \
  --entrypoint bash "$name" -c '
    set -euo pipefail
    # The CVM mounts the writable toolchain overlay and enforces egress outside the guest.
    mkdir -p /nix/store /nix/store.upper /nix/store.work
    mount -t overlay overlay -o lowerdir=/tinfoil/models/nix/nix/store,upperdir=/nix/store.upper,workdir=/nix/store.work /nix/store
    nft -f - <<NFT
table inet egress {
  chain output { type filter hook output priority 0; oifname != { "lo", "monitor0" } drop; }
  chain forward { type filter hook forward priority 0; drop; }
}
NFT
    exec /entrypoint --local' > /dev/null
# Wait for routing, not merely systemd: the shell must have a working Monitor connection.
deadline=$((SECONDS + 60))
while ((SECONDS < deadline)); do
  if podman exec "$name" ip link show monitor0 > /dev/null 2>&1; then
    [[ $# != 0 ]] || set -- bash -l
    terminal=()
    [[ ! -t 0 || ! -t 1 ]] || terminal=(-t)
    exec podman exec -i "${terminal[@]}" -u sandbox -w /workspace "$name" "$@"
  fi
  [[ $(podman inspect -f '{{.State.Running}}' "$name") == true ]] || { podman logs "$name"; exit 1; }
  sleep 0.5
done
podman logs --tail 30 "$name"
podman exec "$name" journalctl -b -u monitor-network --no-pager -n 30
echo 'Sandbox Monitor network did not become ready within 60 seconds' >&2
exit 1
