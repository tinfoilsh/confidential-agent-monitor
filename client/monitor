def foreground(group):
    if sys.stdin.isatty():
        previous = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
        try:
            os.tcsetpgrp(sys.stdin.fileno(), group)
        finally:
            signal.signal(signal.SIGTTOU, previous)


def run_child(session, command, env):
    parent_group = os.tcgetpgrp(sys.stdin.fileno()) if sys.stdin.isatty() else None
    child = subprocess.Popen(command, env=env, process_group=0)
    previous = {}
    stopped = []
    try:
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            def forward(signum, frame):
                if not stopped:
                    stopped.extend([time.monotonic(), signum])
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(child.pid, signum)
            previous[signum] = signal.signal(signum, forward)
        foreground(child.pid)
        with contextlib.suppress(ProcessLookupError):
            os.killpg(child.pid, signal.SIGCONT)
        while child.poll() is None:
            session.check()
            if stopped and time.monotonic() - stopped[0] > 2:
                return 128 + stopped[1]
            time.sleep(0.05)
        return child.returncode if child.returncode >= 0 else 128 - child.returncode
    finally:
        # SIGHUP asks interactive shells to close jobs in their own process groups.
        with contextlib.suppress(ProcessLookupError):
            os.killpg(child.pid, signal.SIGHUP)
        try:
            child.wait(timeout=1)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(child.pid, signal.SIGKILL)
            child.wait()
        with contextlib.suppress(ProcessLookupError):
            os.killpg(child.pid, signal.SIGKILL)
        if parent_group is not None:
            foreground(parent_group)
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def shell_command(session, env, shell):
    name = Path(shell).name
    if name not in ("bash", "zsh"):
        raise MonitorError("monitor shell supports bash and zsh; use --shell /path/to/bash")
    label = re.sub(r"[^a-zA-Z0-9_.-]", "_", env["MONITOR_CLIENT_PROFILE"])
    # User startup files are deliberately skipped so they cannot silently change
    # account selection or routing. zsh always reads its system zshenv first.
    exports = "\n".join(f"export {key}={shlex.quote(value)}" for key, value in env.items()
                        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key))
    if name == "bash":
        rc = session.directory / "bashrc"
        rc.write_text(exports + f"\nPS1='[monitor:{label}] \\w\\$ '\n" +
                      "trap 'jobs -pr | while read -r pid; do kill -HUP -- -\"$pid\" 2>/dev/null; done' EXIT\n")
        return [shell, "--noprofile", "--rcfile", str(rc), "-i"]
    (session.directory / ".zshenv").write_text("unsetopt GLOBAL_RCS\n")
    (session.directory / ".zshrc").write_text(exports + f"\nPROMPT='[monitor:{label}] %~%# '\n")
    env["ZDOTDIR"] = str(session.directory)
    return [shell, "-d", "-i"]


def mcp_probe(host, port, timeout):
    headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream"}
    sequence = 0

    def request(method, params=None, notification=False):
        nonlocal sequence
        sequence += 1
        message = {"jsonrpc": "2.0", "method": method}
        if not notification:
            message["id"] = sequence
        if params is not None:
            message["params"] = params
        connection = http.client.HTTPConnection(host, port, timeout=timeout)
        try:
            connection.request("POST", "/", json.dumps(message), headers)
            response = connection.getresponse()
            if response.status >= 300:
                raise MonitorError(f"MCP {method} failed: HTTP {response.status}")
            if notification:
                response.read()
                return
            if response.getheader("Mcp-Session-Id"):
                headers["Mcp-Session-Id"] = response.getheader("Mcp-Session-Id")
            if "text/event-stream" in response.getheader("Content-Type", ""):
                data = []
                while True:
                    line = response.readline(1 << 20)
                    if not line:
                        raise MonitorError(f"MCP {method} stream ended before its reply")
                    if line.rstrip(b"\r\n") == b"":
                        if data:
                            result = json.loads(b"\n".join(data))
                            if result.get("id") == sequence:
                                break
                            data = []
                    elif line.startswith(b"data:"):
                        data.append(line[5:].strip())
            else:
                result = json.loads(response.read(16 << 20))
            if result.get("id") != sequence or "error" in result or "result" not in result:
                raise MonitorError(f"MCP {method} failed: {result.get('error', 'invalid response')}")
            return result["result"]
        finally:
            connection.close()

    initialized = request("initialize", {"protocolVersion": "2025-11-25", "capabilities": {},
                                         "clientInfo": {"name": "monitor-client", "version": "1"}})
    version = initialized.get("protocolVersion")
    if version not in ("2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"):
        raise MonitorError(f"unsupported MCP protocol version: {version}")
    headers["MCP-Protocol-Version"] = version
    request("notifications/initialized", notification=True)
    count, cursor, seen = 0, None, set()
    while True:
        result = request("tools/list", {"cursor": cursor} if cursor else {})
        if not isinstance(result.get("tools"), list):
            raise MonitorError("MCP tools/list returned an invalid tool list")
        count += len(result["tools"])
        cursor = result.get("nextCursor")
        if not cursor:
            return count
        if cursor in seen or len(seen) >= 1000:
            raise MonitorError("MCP tools/list pagination did not finish")
        seen.add(cursor)


def mcp_servers(session, address=("127.0.0.1", 0)):
    connections = [c for c in session.client.connections() if c["kind"] in ("mcp", "tinfoil-mcp")]
    if not connections:
        raise MonitorError("no reachable MCP connections; an HTTP API account alone does not provide MCP tools")
    servers, tools = {}, 0
    for connection in connections:
        name = connection["name"]
        if connection["state"] != "ready":
            print(f"monitor: MCP connection {name} is {connection['state']}", file=sys.stderr)
            continue
        port = address[1] + len(servers) if address[1] else 0
        if port > 65535:
            raise MonitorError("not enough consecutive ports; use --listen with port 0")
        port = session.listen((address[0], port), functools.partial(ForwardHandler, host=f"{name}.monitor"))
        count = mcp_probe(address[0], port, session.client.timeout)
        host = f"[{address[0]}]" if ":" in address[0] else address[0]
        url = f"http://{host}:{port}/"
        servers[name] = {"type": "http", "url": url}
        tools += count
        print(f"monitor: MCP {name} ready at {url} ({count} tools)", file=sys.stderr, flush=True)
    if not servers:
        raise MonitorError("no MCP connections are ready")
    return servers, tools


def managed_command(client, args):
    if args.command == "run":
        command = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
        if not command:
            raise MonitorError("usage: monitor run [--connection NAME] -- COMMAND [ARG ...]")
    elif args.command == "mcp":
        address = loopback_address(args.listen)
    with Session(client) as session:
        if args.command == "mcp":
            _, count = mcp_servers(session, address)
            if not count:
                print("monitor: no tools are visible; check account access and tool review in the web app", file=sys.stderr)
            while True:
                session.check()
                time.sleep(0.1)
        env = session.environment(args.connection, args.profile)
        if args.command == "shell":
            command = shell_command(session, env, args.shell)
        return run_child(session, command, env)


def private_read(path):
    """Read host credentials/state without following a final-component symlink."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, encoding="utf-8", newline="") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise MonitorError(f"{path} must be an owner-only regular file (chmod 600)")
        return source.read()


def private_write(path, text):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix=".monitor-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as output:
            output.write(text)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


@contextlib.contextmanager
def launch_lock(path):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise MonitorError("another Monitor setup or launch is using this state") from error
        yield


def owner_token(value):
    """Preserve supplied text; recognize old random keys and CLI key records."""
    try:
        record = json.loads(value)
    except (ValueError, TypeError):
        record = None
    if isinstance(record, dict) and record.get("version") == 2:
        raise MonitorError("owner signing requires an attested client; use tinfoil monitor open")
    if isinstance(record, dict) and {"version", "key"} <= record.keys():
        if record.get("version") != 1 or not isinstance(record.get("key"), str):
            raise MonitorError("invalid owner key record")
        try:
            raw = base64.b64decode(record["key"], validate=True)
        except (ValueError, TypeError) as error:
            raise MonitorError("invalid owner key record") from error
    else:
        legacy = value.strip()
        try:
            raw = base64.b64decode(legacy, validate=True)
            if len(raw) == 32 and base64.b64encode(raw).decode() == legacy:
                return legacy
        except (ValueError, TypeError):
            pass
        raw = value.encode("utf-8")
    if not 16 <= len(raw) <= 4096:
        raise MonitorError("use an owner key or passphrase between 16 and 4096 UTF-8 bytes")
    return base64.b64encode(raw).decode()


class OwnerClient:
    """Use the existing owner API. Owner credentials never enter the VM."""
    def __init__(self, url, key, timeout=30):
        self.url = urlsplit(url)
        self.key = owner_token(key)
        self.timeout = timeout
        if self.url.username or self.url.password or self.url.query or self.url.fragment or not self.url.hostname:
            raise MonitorError("owner URL must be an HTTP(S) URL without credentials, query or fragment")
        try:
            loopback = ipaddress.ip_address(self.url.hostname).is_loopback
        except ValueError:
            loopback = self.url.hostname == "localhost"
        if self.url.scheme != "https" and not (self.url.scheme == "http" and loopback):
            raise MonitorError("use HTTPS for a remote owner API, or HTTP on loopback through a trusted tunnel")

    def request(self, method="GET", body=None, path="/"):
        cls = http.client.HTTPSConnection if self.url.scheme == "https" else http.client.HTTPConnection
        connection = cls(self.url.hostname, self.url.port, timeout=self.timeout)
        try:
            # http.client neither follows redirects nor uses proxy environment variables.
            connection.request(method, self.url.path.rstrip("/") + path,
                               body=json.dumps(body).encode() if body is not None else None,
                               headers={"Authorization": "Bearer " + self.key, "Content-Type": "application/json"})
            response = connection.getresponse()
            data = response.read(16 * 1024 * 1024 + 1)
            if response.status != 200:
                raise MonitorError(f"owner API returned HTTP {response.status}: {data.decode(errors='replace').strip()}")
            if len(data) > 16 * 1024 * 1024:
                raise MonitorError("owner API response is too large")
            return json.loads(data)
        finally:
            connection.close()

    def edit(self, changes):
        return self.request("POST", {"changes": changes}, path="/policy/edits")


def profile_name(args):
    name = args.profile or "default"
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}", name):
        raise MonitorError("profile name must contain only letters, digits, underscores and hyphens")
    return name


def setup_value(value, prompt, default=None):
    if value is not None:
        return value
    if not sys.stdin.isatty():
        if default is not None:
            return default
        raise MonitorError(f"{prompt} is required; use monitor setup --help for noninteractive options")
    answer = input(prompt + (f" [{default}]" if default else "") + ": ").strip()
    return answer or default


def endpoint_address(value):
    parsed = urlsplit("ssh://" + value)
    if not parsed.hostname or not parsed.port or parsed.username or parsed.password or parsed.path or parsed.query or parsed.fragment:
        raise MonitorError("SSH endpoint must be HOST:PORT or [IPv6]:PORT")
    addresses = socket.getaddrinfo(parsed.hostname, parsed.port, type=socket.SOCK_STREAM)
    address = addresses[0][4][0]
    return f"[{address}]:{parsed.port}" if ":" in address else f"{address}:{parsed.port}"


def safe_host_environment():
    return {name: value for name, value in os.environ.items()
            if name in {"PATH", "HOME", "USER", "LOGNAME", "TERM", "LANG", "TMPDIR", "TZ"} or name.startswith("LC_")}


def vm_module():
    if "monitor_vm" not in sys.modules:
        path = Path(__file__).with_name("monitor_vm.py")
        if path.is_file():
            spec = importlib.util.spec_from_file_location("monitor_vm", path)
            module = importlib.util.module_from_spec(spec)
            sys.modules["monitor_vm"] = module
            spec.loader.exec_module(module)
        else:
            importlib.import_module("monitor_vm")
    return sys.modules["monitor_vm"]


def setup_launch(args):
    if sys.platform != "linux":
        raise MonitorError("Monitor VM launch currently requires Linux/Firecracker")
    name = profile_name(args)
    config_path = Path(args.client_config).expanduser().resolve()
    with launch_lock(config_path.with_suffix(".lock")):
        config = json.loads(private_read(config_path)) if config_path.exists() else {}
        if name in config.get("launch_profiles", {}):
            raise MonitorError(f"launch profile {name!r} already exists; choose a new --profile to change its server or permissions")
        root = config_path.parent / "launch" / name
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        if not 1 <= args.cpus <= 32 or not 512 <= args.memory <= 65536:
            raise MonitorError("choose 1–32 CPUs and 512–65536 MiB of memory")
        image = str(vm_module().preflight(args.image))
        owner_url = setup_value(args.owner_url, "Monitor owner URL", "http://127.0.0.1:8080")
        endpoint = setup_value(args.endpoint, "Monitor SSH endpoint as reached by this host", "127.0.0.1:2223")
        endpoint_address(endpoint)
        if args.owner_key_file:
            key = private_read(Path(args.owner_key_file).expanduser())
        elif sys.stdin.isatty():
            key = getpass.getpass("Monitor owner key or passphrase (saved only on this host): ")
        else:
            raise MonitorError("pass --owner-key-file pointing to an owner-only file")
        owner = OwnerClient(owner_url, key)
        view = owner.request()
        accounts = view["config"].get("accounts", {})
        candidates = []
        for account, settings in accounts.items():
            if settings.get("preset") == "anthropic":
                candidates.extend(account + ("-" + suffix if suffix else "")
                                  for suffix, kinds in settings.get("connections", {}).items() if "http" in kinds)
        connection = setup_value(args.connection, "Anthropic HTTP connection", candidates[0] if len(candidates) == 1 else None)
        matching = [account for account, settings in accounts.items()
                    for suffix, kinds in settings.get("connections", {}).items()
                    if "http" in kinds and account + ("-" + suffix if suffix else "") == connection]
        if len(matching) != 1:
            raise MonitorError("choose an existing HTTP connection for the Anthropic API")
        access_spec = args.account or [item.strip() for item in setup_value(
            None, "Account access, comma-separated name=read|ask|allow", matching[0] + "=allow").split(",")]
        access = {}
        for item in access_spec:
            account, sep, level = item.partition("=")
            if not sep or account not in accounts or level not in ("read", "ask", "allow"):
                raise MonitorError(f"invalid account access {item!r}; use an existing account and read, ask or allow")
            access[account] = {"level": level}
        if matching[0] not in access:
            raise MonitorError("the model account must be included in --account")
        host_key = view["host_key"].strip()
        if "\n" in host_key or not host_key.startswith(("ssh-", "ecdsa-")):
            raise MonitorError("owner API returned an invalid SSH host key")
        private_write(root / "owner.key", key)
        private_write(root / "host_key", host_key + "\n")
        profile = {"version": 2, "id": uuid.uuid4().hex, "owner_url": owner_url, "endpoint": endpoint,
                   "root": str(root), "image": image, "cpus": args.cpus, "memory": args.memory,
                   "connection": connection, "accounts": access, "mcp": args.mcp}
        config.setdefault("launch_profiles", {})[name] = profile
        private_write(config_path, json.dumps(config, indent=2) + "\n")
        print(f"Saved launch profile {name!r}. Owner key stays in {root / 'owner.key'}.")
        prefix = "monitor" + (" --profile " + name if name != "default" else "")
        print(f"From a project directory, run: {prefix} launch claude")
    return 0


def enroll_identity(owner, state, state_path, public_key, accounts):
    view = owner.request()
    existing = view["config"].get("identities", {}).get(state["name"])
    if existing:
        if existing["key"].strip() != public_key.strip():
            raise MonitorError("this VM's Monitor identity has a different key; refusing to replace it")
        # Never replay initial access over permissions edited in the web app.
    elif state["enrolled"]:
        raise MonitorError("this VM's Monitor identity was revoked; destroy the VM before creating a new identity")
    else:
        # Record the attempt first. A lost response followed by owner revocation
        # must not cause a later launch to restore the initial grant.
        state["enrolled"] = True
        private_write(state_path, json.dumps(state, indent=2) + "\n")
        owner.edit([{"path": ["identities", state["name"]], "value": {"key": public_key, "accounts": accounts}}])
    state["enrolled"] = True
    private_write(state_path, json.dumps(state, indent=2) + "\n")


def revoke_identity(owner, name, public_key):
    ids = owner.request()["config"].get("identities", {})
    if name not in ids:
        return
    if ids[name]["key"].strip() != public_key.strip():
        raise MonitorError("this VM's Monitor identity has a different key; refusing to revoke it")
    owner.edit([{"path": ["identities", name], "delete": True}])


def launch_vm(args):
    if sys.platform != "linux":
        raise MonitorError("Monitor VM launch currently requires Linux/Firecracker")
    name = profile_name(args)
    config_path = Path(args.client_config).expanduser().resolve()
    try:
        profile = json.loads(private_read(config_path))["launch_profiles"][name]
    except (FileNotFoundError, KeyError) as error:
        raise MonitorError("run monitor setup first for this profile") from error
    if profile["version"] != 2:
        raise MonitorError("this launch profile uses an older VM backend; run monitor setup with a new --profile")
    root = Path(profile["root"])
    workspace = Path(args.workspace).expanduser().resolve()
    if workspace == Path.home().resolve() or workspace.parent == workspace:
        raise MonitorError("choose a project directory, not your home or filesystem root")
    if args.command == "launch" and not workspace.is_dir():
        raise MonitorError("choose an existing project directory")
    if workspace == root.resolve() or workspace in root.resolve().parents:
        raise MonitorError("the project contains Monitor's host credentials; choose a project outside the launch configuration directory")
    identity = "vm-" + hashlib.sha256((profile["id"] + "\0" + str(workspace)).encode()).hexdigest()[:32]
    directory = root / "instances" / identity
    if args.command == "stop":
        vm_module().stop(directory)
        print("Requested VM shutdown; its disk and identity will be retained.")
        return 0
    with launch_lock(root / "locks" / identity):
        state_path = directory / "state.json"
        if state_path.exists():
            state = json.loads(private_read(state_path))
            if state["workspace"] != str(workspace) or state["name"] != identity:
                raise MonitorError("VM state does not match this project")
        elif args.command != "launch":
            raise MonitorError("no Monitor VM is recorded for this project")
        else:
            directory.mkdir(parents=True, exist_ok=True, mode=0o700)
            if not (directory / "id").exists():
                result = subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "monitor-vm", "-f", str(directory / "id")],
                                        env=safe_host_environment(), capture_output=True, timeout=15)
                if result.returncode:
                    raise MonitorError("could not generate the VM's SSH identity")
            state = {"name": identity, "workspace": str(workspace), "enrolled": False, "revoked": False}
            private_write(state_path, json.dumps(state) + "\n")
        private_read(directory / "id")
        public = subprocess.run(["ssh-keygen", "-y", "-f", str(directory / "id")], capture_output=True, timeout=15)
        if public.returncode:
            raise MonitorError("cannot read the VM's SSH public key")
        public_key = public.stdout.decode().strip() + "\n"
        if args.command in ("launch", "destroy"):
            owner = OwnerClient(profile["owner_url"], private_read(root / "owner.key"))
        if args.command == "destroy":
            vm_module().ensure_stopped(directory)
            revoke_identity(owner, identity, public_key)
            state["revoked"] = True
            private_write(state_path, json.dumps(state) + "\n")
            shutil.rmtree(directory)
            print("Revoked the Monitor identity and destroyed the VM.")
            return 0
        if args.command == "launch" and state.get("revoked"):
            raise MonitorError("this VM is being destroyed; retry monitor destroy")
        driver = vm_module()
        driver.preflight(profile["image"])
        if args.command == "launch":
            enroll_identity(owner, state, state_path, public_key, profile["accounts"])
        elif not (directory / "initialized").exists():
            raise MonitorError("this VM has no initialized workspace to export")
        endpoint = None
        if args.command == "launch":
            address = urlsplit("ssh://" + endpoint_address(profile["endpoint"]))
            endpoint = (address.hostname, address.port)
        with driver.VM(profile, directory, workspace, __file__, endpoint) as vm:
            if args.command == "export":
                driver.export(vm, args.output)
                print(f"Saved workspace archive to {args.output}")
                return 0
            arguments = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
            return run_child(vm, vm.agent(arguments, profile.get("mcp", False)), safe_host_environment())


def guest_agent(client, args):
    with Session(client) as session:
        env = session.environment([], None)
        if not any(c["name"] == args.connection and c["state"] == "ready" for c in client.connections()):
            raise MonitorError("the model connection is not ready; check its access and status in Monitor")
        connection = next((c for c in session.routes if c["name"] == args.connection), None)
        if connection is None:
            raise MonitorError("the model connection is not accessible to this VM")
        values = connection["placeholders"]
        variable = next((key for key in ("ANTHROPIC_API_KEY", "token") if key in values), None)
        if variable is None:
            raise MonitorError("model connection needs a token or ANTHROPIC_API_KEY credential slot")
        for name in ("ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_BASE_URL"):
            env.pop(name, None)
        env["ANTHROPIC_API_KEY"] = values[variable]
        env["DISABLE_AUTOUPDATER"] = "1"
        env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
        arguments = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
        command = ["claude", "--dangerously-skip-permissions"]
        if args.mcp:
            servers, count = mcp_servers(session)
            if not count:
                raise MonitorError("no MCP tools are available; review account access and tools in Monitor")
            mcp_config = session.directory / "mcp.json"
            mcp_config.write_text(json.dumps({"mcpServers": servers}))
            # These endpoints live in the guest. Sending them through the HTTP
            # proxy would ask the Monitor server to connect to its own loopback.
            env["NO_PROXY"] = env["no_proxy"] = "127.0.0.1,localhost,::1"
            command += ["--mcp-config", str(mcp_config)]
        return run_child(session, command + arguments, env)


def load_profile(args):
    if not args.profile:
        return
    try:
        config = json.loads(Path(args.client_config).expanduser().read_text())
        profile = config["profiles"][args.profile]
        if not isinstance(profile, dict):
            raise ValueError()
        for key in ("ssh_host", "ssh_config"):
            if key in profile and not isinstance(profile[key], str):
                raise ValueError()
        connections = profile.get("connections", [])
        if not isinstance(connections, list) or any(not isinstance(c, str) for c in connections):
            raise ValueError()
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise MonitorError(f"cannot load profile {args.profile!r} from {args.client_config}: {error}") from error
    args.ssh_host = args.ssh_host or profile.get("ssh_host", "monitor")
    args.ssh_config = args.ssh_config or profile.get("ssh_config")
    if hasattr(args, "connection") and args.command in ("run", "shell"):
        args.connection = args.connection or connections


def policy_command(client, args):
    owner = None
    if args.owner_url or args.owner_key_file:
        if not args.owner_url or not args.owner_key_file:
            raise MonitorError("provide both --owner-url and --owner-key-file")
        owner = OwnerClient(args.owner_url, private_read(Path(args.owner_key_file).expanduser()))
    if args.policy_action in ("diff", "apply") and owner is None:
        raise MonitorError("policy diff and apply require owner authentication")
    if args.policy_action in ("propose", "status") and owner is not None:
        raise MonitorError("proposal commands use the agent's SSH identity; omit owner options")
    if args.policy_action == "show":
        if args.effective and owner is None:
            raise MonitorError("the complete effective policy requires owner authentication")
        result = owner.request(path="/policy?effective" if args.effective else "/policy") if owner else json.loads(client.request("agent.monitor", "GET", "/policy"))
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(result["effective" if args.effective else "source"], end="")
        return 0
    if args.policy_action == "status":
        if not re.fullmatch(r"[A-Z2-7]{26,}", args.id):
            raise MonitorError("proposal ID must be at least 26 base32 characters")
        result = json.loads(client.request("agent.monitor", "GET", f"/policy/proposals/{args.id}"))
        if (not isinstance(result, dict) or result.get("id") != args.id
                or result.get("state") not in ("pending", "approved", "denied", "outdated")):
            raise MonitorError("invalid proposal status from the monitor")
        print(json.dumps(result, indent=2))
        return 0
    if args.policy_action == "propose":
        if bool(args.file) == bool(args.changes):
            raise MonitorError("provide exactly one TOML file or --changes JSON file")
        if args.changes:
            if args.delete:
                raise MonitorError("put deletions in the structured changes file, not --delete")
            raw = sys.stdin.read() if args.changes == "-" else Path(args.changes).read_text()
            try:
                changes = json.loads(raw)
            except json.JSONDecodeError as err:
                raise MonitorError(f"invalid structured changes JSON: {err}") from err
            if not isinstance(changes, list) or not changes:
                raise MonitorError("structured changes must be a non-empty JSON array")
            body = {"reason": args.reason, "changes": changes}
        else:
            source = sys.stdin.read() if args.file == "-" else Path(args.file).read_text()
            deletions = []
            for pointer in args.delete:
                if not pointer.startswith("/") or re.search(r"~(?![01])", pointer):
                    raise MonitorError("--delete requires a JSON Pointer, for example /accounts/github")
                deletions.append([part.replace("~1", "/").replace("~0", "~") for part in pointer[1:].split("/")])
            body = {"source": source, "reason": args.reason, "delete": deletions}
        result = json.loads(client.request("agent.monitor", "POST", "/policy/proposals", body))
        print(json.dumps(result, indent=2))
        return 0
    else:
        source = sys.stdin.read() if args.file == "-" else Path(args.file).read_text()
        body = {"source": source}
    if args.policy_action == "diff":
        preview = owner.request("POST", body, path="/policy/preview")
        print(preview["source_diff"] or "No source changes.")
        print("Effective policy changes:")
        print(preview["effective_diff"] or "No effective changes.")
    else:
        owner.request("POST", body, path="/policy")
        print("Policy applied")
    return 0


def parser():
    p = argparse.ArgumentParser(
        prog="monitor",
        description="Discover and use the external services available to this agent.",
        epilog="Local commands use your paired SSH identity. VM setup and enrollment use owner authentication on the host. Requests follow Monitor policy.",
    )
    p.add_argument("--ssh-host", help="SSH host alias (default: MONITOR_SSH_HOST or monitor)")
    p.add_argument("--ssh-config", help="SSH configuration file (default: MONITOR_SSH_CONFIG)")
    p.add_argument("--profile", help="local profile in the client configuration")
    p.add_argument("--client-config", default=str(Path.home() / ".config/monitor/client.json"), help="client profiles JSON file")
    p.add_argument("--timeout", type=float, default=300, help="request timeout in seconds (default: 300)")
    commands = p.add_subparsers(dest="command", required=True)
    policy = commands.add_parser("policy", help="inspect policy views and propose TOML edits")
    policy.add_argument("--owner-url", help="owner API URL for the full source, diff and apply")
    policy.add_argument("--owner-key-file", help="owner key or passphrase file; never needed for agent proposals")
    policy_commands = policy.add_subparsers(dest="policy_action", required=True)
    show_policy = policy_commands.add_parser("show", help="show the policy view available to this identity as TOML")
    show_policy.add_argument("--json", action="store_true", help="show the response as JSON")
    show_policy.add_argument("--effective", action="store_true", help="expand presets and defaults; requires owner authentication")
    status_policy = policy_commands.add_parser("status", help="show the current state of one submitted proposal")
    status_policy.add_argument("id", help="proposal ID returned by policy propose")
    for action in ("propose", "diff", "apply"):
        command = policy_commands.add_parser(action, help={"propose": "submit connection changes for owner review", "diff": "validate and preview a replacement policy", "apply": "apply a replacement policy"}[action])
        command.add_argument("file", nargs="?" if action == "propose" else None, help="TOML file, or - for stdin")
        if action == "propose":
            command.add_argument("--changes", metavar="FILE", help="structured Change[] JSON file, or - for stdin")
            command.add_argument("--reason", required=True, help="explain why the connection change is needed")
            command.add_argument("--delete", action="append", default=[], help="connection-scoped JSON Pointer to remove; repeat for multiple deletions")
    setup = commands.add_parser("setup", help="configure one-command Linux VM launch")
    setup.add_argument("--owner-url", help="unlocked Monitor owner API URL")
    setup.add_argument("--owner-key-file", help="owner-only file containing a key or passphrase; otherwise prompt privately")
    setup.add_argument("--endpoint", help="Monitor SSH HOST:PORT as reached by this host")
    setup.add_argument("--image", default=str(Path.home() / ".local/share/monitor/images/default"), help="prepared VM image directory")
    setup.add_argument("--cpus", type=int, default=2, help="VM CPU count (default: 2)")
    setup.add_argument("--memory", type=int, default=4096, help="VM memory in MiB (default: 4096)")
    setup.add_argument("--connection", help="Anthropic HTTP connection name")
    setup.add_argument("--account", action="append", help="initial account access NAME=read|ask|allow; repeat for several")
    setup.add_argument("--mcp", action="store_true", help="also connect Claude to Monitor's MCP connections")
    launch = commands.add_parser("launch", help="launch an agent in a Monitor-connected Linux VM")
    launch.add_argument("--workspace", default=".", help="project directory (default: current directory)")
    launch.add_argument("agent", choices=["claude"])
    launch.add_argument("argv", nargs=argparse.REMAINDER, help="-- ARGUMENTS passed to Claude")
    destroy = commands.add_parser("destroy", help="revoke the project's Monitor identity and destroy its VM")
    destroy.add_argument("--workspace", default=".", help="project directory (default: current directory)")
    stop = commands.add_parser("stop", help="stop the project's running VM and retain its disk")
    stop.add_argument("--workspace", default=".", help="project directory (default: current directory)")
    export = commands.add_parser("export", help="save the stopped VM's workspace as a tar archive")
    export.add_argument("--workspace", default=".", help="project directory (default: current directory)")
    export.add_argument("--output", required=True, help="new archive file to create on this host")
    image = commands.add_parser("image", help="prepare a Firecracker guest image")
    build = image.add_subparsers(dest="action", required=True).add_parser("build", help="build the image with Podman or Docker")
    build.add_argument("--output", default=str(Path.home() / ".local/share/monitor/images/default"))
    build.add_argument("--engine", help="container engine executable (default: podman or docker)")
    build.add_argument("--firecracker", help="use a local static Firecracker binary")
    build.add_argument("--kernel", help="use a local Firecracker-compatible guest kernel")
    build.add_argument("--claude-version", default="stable", help="Claude release to install (default: stable)")
    build.add_argument("--claude-binary", help="use an existing native Linux Claude binary instead of downloading")
    build.add_argument("--disk-size", type=int, default=8, help="VM disk size in GiB (default: 8)")
    proxy = commands.add_parser("_vm-connect")
    proxy.add_argument("socket")
    agent = commands.add_parser("_agent")
    agent.add_argument("--connection", required=True)
    agent.add_argument("--mcp", action="store_true")
    agent.add_argument("argv", nargs=argparse.REMAINDER)
    run = commands.add_parser("run", help="run a local command through Monitor")
    run.add_argument("--connection", action="append", default=[], metavar="NAME", help="HTTP connection to use; repeat for several")
    run.add_argument("argv", nargs=argparse.REMAINDER, help="-- COMMAND [ARG ...]")
    shell = commands.add_parser("shell", help="start a local bash or zsh with Monitor routing")
    shell.add_argument("--connection", action="append", default=[], metavar="NAME", help="HTTP connection to use; repeat for several")
    shell.add_argument("--shell", default=os.environ.get("SHELL", "/bin/bash"), help="bash or zsh executable; startup files are skipped")
    mcp = commands.add_parser("mcp", help="connect MCP clients to Monitor")
    serve = mcp.add_subparsers(dest="action", required=True).add_parser("serve", help="serve each ready MCP connection on loopback")
    serve.add_argument("--listen", default="127.0.0.1:8400", help="loopback IP:first port; uses consecutive ports, or free ports with port 0")
    connections = commands.add_parser("connections", help="list reachable connections and their current status")
    connections.add_argument("--json", action="store_true", help="include account, host and access settings as JSON")
    catalog = commands.add_parser("catalog", help="list connection types available for owner-reviewed setup")
    catalog.add_argument("--json", action="store_true", help="show complete safe catalog metadata as JSON")
    commands.metavar = "{" + ",".join(name for name in commands.choices if not name.startswith("_")) + "}"
    return p


def main(argv=None):
    p = parser()
    args = p.parse_args(argv)
    if not 0 < args.timeout < float("inf"):
        p.error("--timeout must be a positive, finite number")
    previous = {}
    try:
        if args.command in ("launch", "export", "image"):
            def interrupted(signum, frame):
                raise Interrupted(signum)
            for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                previous[signum] = signal.signal(signum, interrupted)
        if args.command == "setup":
            return setup_launch(args)
        if args.command == "image":
            with launch_lock(Path(args.output).expanduser().resolve().with_suffix(".lock")):
                return vm_module().build_image(args)
        if args.command == "_vm-connect":
            return vm_module().proxy(args.socket)
        if args.command in ("launch", "destroy", "stop", "export"):
            return launch_vm(args)
        load_profile(args)
        args.ssh_host = args.ssh_host or os.environ.get("MONITOR_SSH_HOST", "monitor")
        args.ssh_config = args.ssh_config or os.environ.get("MONITOR_SSH_CONFIG")
        if args.ssh_config:
            args.ssh_config = os.path.abspath(os.path.expanduser(args.ssh_config))
        client = Client(args.ssh_host, args.ssh_config, args.timeout)
        if args.command == "policy":
            return policy_command(client, args)
        if args.command in ("run", "shell", "mcp", "_agent"):
            if sys.version_info < (3, 11):
                raise MonitorError("run, shell and mcp serve require Python 3.11 or newer")
            def interrupted(signum, frame):
                raise Interrupted(signum)
            for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                previous[signum] = signal.signal(signum, interrupted)
            return guest_agent(client, args) if args.command == "_agent" else managed_command(client, args)
        if args.command == "connections":
            connections = client.connections()
            if args.json:
                print(json.dumps({"connections": connections}, indent=2))
            elif connections:
                rows = [("KIND", "NAME", "STATE", "HOST")] + [
                    (c["kind"], c["name"], c["state"], c["host"]) for c in connections
                ]
                widths = [max(len(row[i]) for row in rows) for i in range(4)]
                for row in rows:
                    print("  ".join(value.ljust(width) for value, width in zip(row, widths)).rstrip())
            else:
                print("No connections are available to this agent. Ask the owner to grant access.")
            return 0
        if args.command == "catalog":
            catalog = client.catalog()
            if args.json:
                print(json.dumps(catalog, indent=2))
            else:
                presets = catalog["presets"]
                group_order = {"api": 0, "mcp": 1, "protocol": 2, "generic": 99}
                rows = [("GROUP", "NAME", "TITLE")] + [
                    (entry.get("group", "api"), name, entry.get("title", name))
                    for name, entry in sorted(presets.items(), key=lambda item: (
                        group_order.get(item[1].get("group", "api"), 50),
                        item[1].get("title", item[0])))
                ]
                widths = [max(len(str(row[i])) for row in rows) for i in range(3)]
                for row in rows:
                    print("  ".join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip())
            return 0
    except (MonitorError, OSError, http.client.HTTPException, subprocess.TimeoutExpired, ValueError, KeyError, EOFError) as error:
        print(f"monitor: {error}", file=sys.stderr)
        return 1
    except Interrupted as error:
        return 128 + error.signum
    except KeyboardInterrupt:
        return 130
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


if __name__ == "__main__":
    sys.exit(main())
