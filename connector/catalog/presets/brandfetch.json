  "title": "Brandfetch",
  "http": {
    "operations": {
      "getAgentAccessOffer": {"action":"agents.access.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/agents/access","scope":{}},
      "getBrandBatch": {"action":"brands.read","body":"json","effects":["read"],"method":"POST","origin":"https://api.brandfetch.io","path":"/v2/brands/batch","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "getBrandContext": {"action":"context.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["cachedOnly"],"path":"/v2/context/{domain}","scope":{"domain":{"at":"domain","from":"path"}}},
      "getBrandData": {"action":"brands.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["allowNsfw","cachedOnly","palette","typography"],"path":"/v2/brands/{identifier}","scope":{"identifier":{"at":"identifier","from":"path"},"query":{"at":"","from":"query","type":"object"}}},
      "getBrandDataByCrypto": {"action":"brands.crypto.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["allowNsfw","cachedOnly","palette","typography"],"path":"/v2/brands/crypto/{symbol}","scope":{"query":{"at":"","from":"query","type":"object"},"symbol":{"at":"symbol","from":"path"}}},
      "getBrandDataByDomain": {"action":"brands.domain.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["allowNsfw","cachedOnly","palette","typography"],"path":"/v2/brands/domain/{domain}","scope":{"domain":{"at":"domain","from":"path"},"query":{"at":"","from":"query","type":"object"}}},
      "getBrandDataByIsin": {"action":"brands.isin.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["allowNsfw","cachedOnly","palette","typography"],"path":"/v2/brands/isin/{isin}","scope":{"isin":{"at":"isin","from":"path"},"query":{"at":"","from":"query","type":"object"}}},
      "getBrandDataByTicker": {"action":"brands.ticker.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["allowNsfw","cachedOnly","palette","typography"],"path":"/v2/brands/ticker/{ticker}","scope":{"query":{"at":"","from":"query","type":"object"},"ticker":{"at":"ticker","from":"path"}}},
      "getBrandFromTransaction": {"action":"brands.transaction.read","body":"json","effects":["read"],"method":"POST","origin":"https://api.brandfetch.io","path":"/v2/brands/transaction","scope":{}},
      "getViewer": {"action":"viewer.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/viewer","scope":{}},
      "prefetchBrand": {"action":"brands.read","effects":["read"],"method":"HEAD","origin":"https://api.brandfetch.io","path":"/v2/brands/{identifier}","scope":{"identifier":{"at":"identifier","from":"path"}}},
      "prefetchBrandByDomain": {"action":"brands.domain.read","effects":["read"],"method":"HEAD","origin":"https://api.brandfetch.io","path":"/v2/brands/domain/{domain}","scope":{"domain":{"at":"domain","from":"path"}}},
      "purchaseAgentAccess": {"action":"agents.access.pay","effects":["pay"],"method":"POST","origin":"https://api.brandfetch.io","params":["usd","rotateKey"],"path":"/v2/agents/access","scope":{}},
      "searchBrands": {"action":"search.read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","params":["c"],"path":"/v2/search/{name_clientId}","scope":{"name_clientId":{"at":"name_clientId","from":"path"}}}
    }
  }
