    "connection": {
      "http": {
        "slots": [
          {
            "header": "X-Figma-Token",
            "origin": "https://api.figma.com",
            "path": "/",
            "value": "access_token"
          },
          {
            "header": "Authorization",
            "origin": "https://api.figma.com",
            "path": "/",
            "prefix": "Bearer ",
            "value": "access_token"
          }
        ]
      }
    },
