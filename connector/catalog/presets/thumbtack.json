{
  "title": "Thumbtack",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]},
      "use.create_preset_job": {"title": "Create preset job", "effects": ["pay", "send"]}
    },
    "connection": {"mcp": {"url": "https://mcp.thumbtack.com/mcp"}},
    "fields": [
      {"key": "client_id", "label": "OAuth client ID", "paths": []},
      {"key": "client_secret", "label": "OAuth client secret", "paths": [], "secret": true},
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "https://mcp.thumbtack.com/mcp", "client_id": "{client_id}", "client_secret": "{client_secret}"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
