  "http": {
    "operations": {
      "ActionExecuted": {"action":"subscriptions.admin","body":"json","effects":["admin"],"method":"POST","origin":"https://api.pushcut.io","path":"/v1/subscriptions","scope":{"actionName":{"at":"/actionName","from":"body"},"url":{"at":"/url","from":"body"}}},
      "CancelExecution": {"action":"execution.write","effects":["write"],"method":"POST","origin":"https://api.pushcut.io","params":["identifier"],"path":"/v1/cancelExecution","scope":{"query":{"at":"","from":"query","type":"object"}}},
      "CancelNotification": {"action":"submitted_notifications.delete","effects":["delete"],"method":"DELETE","origin":"https://api.pushcut.io","params":["devices","onlyScheduled"],"path":"/v1/submittedNotifications/{notificationId}","scope":{"notificationId":{"at":"notificationId","from":"path"},"query":{"at":"","from":"query","type":"object"}}},
      "DeleteSubscription": {"action":"subscriptions.delete","effects":["delete"],"method":"DELETE","origin":"https://api.pushcut.io","path":"/v1/subscriptions/{subscriptionId}","scope":{"subscriptionId":{"at":"subscriptionId","from":"path"}}},
      "Execute": {"action":"execute.execute","body":"json","effects":["execute"],"method":"POST","origin":"https://api.pushcut.io","params":["shortcut","homekit","timeout","delay","identifier","input","serverId"],"path":"/v1/execute","scope":{"query":{"at":"","from":"query","type":"object"},"request":{"at":"","from":"body","type":"object"}}},
      "Execute.none": {"action":"execute.execute","effects":["execute"],"method":"POST","origin":"https://api.pushcut.io","params":["shortcut","homekit","timeout","delay","identifier","input","serverId"],"path":"/v1/execute","scope":{"query":{"at":"","from":"query","type":"object"}}},
      "GetDevices": {"action":"devices.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/devices","scope":{}},
      "GetNotifications": {"action":"notifications.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/notifications","scope":{}},
      "GetSubscriptions": {"action":"subscriptions.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/subscriptions","scope":{}},
      "GetWidgetDesign": {"action":"widget_designs.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/widgetDesigns/{designId}","scope":{"designId":{"at":"designId","from":"path"}}},
      "GetWidgetDesigns": {"action":"widget_designs.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/widgetDesigns","scope":{}},
      "GetWidgets": {"action":"widgets.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/widgets","scope":{}},
      "ListLoggedNotifications": {"action":"logged_notifications.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v2/loggedNotifications","scope":{}},
      "ListServers": {"action":"servers.read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v2/servers","scope":{}},
      "MoveImage": {"action":"images.write","body":"json","effects":["write"],"method":"POST","origin":"https://api.pushcut.io","path":"/v1/images/{imageName}/move","scope":{"imageName":{"at":"imageName","from":"path"},"request":{"at":"","from":"body","type":"object"}}},
      "SendNotification": {"action":"notifications.send","body":"json","effects":["send"],"grant":["notificationName"],"method":"POST","origin":"https://api.pushcut.io","path":"/v1/notifications/{notificationName}","scope":{"notificationName":{"at":"notificationName","from":"path"},"request":{"at":"","from":"body","type":"object"}}},
      "UpdateWidget": {"action":"widgets.write","body":"json","effects":["write"],"method":"POST","origin":"https://api.pushcut.io","path":"/v1/widgets/{widgetName}","scope":{"request":{"at":"","from":"body","type":"object"},"widgetName":{"at":"widgetName","from":"path"}}},
      "UploadImage": {"action":"images.write","body":"json","effects":["write"],"method":"PUT","origin":"https://api.pushcut.io","path":"/v1/images/{imageName}","scope":{"imageName":{"at":"imageName","from":"path"},"request":{"at":"","from":"body","type":"object"}}}
    }
  }
