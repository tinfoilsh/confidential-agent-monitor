      "ConverseStream": {"action":"model.converse_stream.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/model/{modelId}/converse-stream","scope":{"modelId":{"at":"modelId","from":"path"}}},
      "CountTokens": {"action":"model.count_tokens.read","body":"any","effects":["read"],"method":"POST","origin":"{origin}","path":"/model/{modelId}/count-tokens","scope":{"modelId":{"at":"modelId","from":"path"}}},
      "GetAsyncInvoke": {"action":"async_invoke.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/async-invoke/{invocationArn}","scope":{"invocationArn":{"at":"invocationArn","from":"path"}}},
      "InvokeGuardrailChecks": {"action":"guardrail_checks.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/guardrail-checks/invoke","scope":{}},
      "InvokeModel": {"action":"model.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/model/{modelId}/invoke","scope":{"modelId":{"at":"modelId","from":"path"}}},
      "InvokeModelWithBidirectionalStream": {"action":"model.with_bidirectional_stream.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/model/{modelId}/invoke-with-bidirectional-stream","scope":{"modelId":{"at":"modelId","from":"path"}}},
      "InvokeModelWithResponseStream": {"action":"model.with_response_stream.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/model/{modelId}/invoke-with-response-stream","scope":{"modelId":{"at":"modelId","from":"path"}}},
      "ListAsyncInvokes": {"action":"async_invoke.read","effects":["read"],"method":"GET","origin":"{origin}","params":["maxResults","nextToken","sortBy","sortOrder","statusEquals","submitTimeAfter","submitTimeBefore"],"path":"/async-invoke","scope":{}},
      "StartAsyncInvoke": {"action":"async_invoke.generate","body":"any","effects":["generate","write"],"method":"POST","origin":"{origin}","path":"/async-invoke","scope":{}}
    }
