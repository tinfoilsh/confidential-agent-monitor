  "http": {
    "origins": {"origin":["https://bedrock-runtime-fips.{region}.amazonaws.com","https://bedrock-runtime.{region}.amazonaws.com"]},
    "operations": {
      "ApplyGuardrail": {"action":"guardrail.version.apply.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/guardrail/{guardrailIdentifier}/version/{guardrailVersion}/apply","scope":{"guardrailIdentifier":{"at":"guardrailIdentifier","from":"path"},"guardrailVersion":{"at":"guardrailVersion","from":"path"}}},
