{
  "title": "Stripe",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]},
      "use.convert_currency": {"title": "Convert currency", "effects": ["pay"]},
      "use.send_money": {"title": "Send money", "effects": ["pay"]},
      "use.stripe_api_write": {"title": "Stripe api write", "effects": ["delete", "pay", "send", "write"]},
      "use.transfer_money": {"title": "Transfer money", "effects": ["pay"]}
    },
    "connection": {"mcp": {"url": "https://mcp.stripe.com"}},
    "fields": [
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "https://mcp.stripe.com"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
