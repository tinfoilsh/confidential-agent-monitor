        "credential": true,
        "key": "secret_key",
        "label": "Secret access key",
        "secret": true
      },
      {
        "credential": true,
        "key": "session_token",
        "label": "Session token (temporary credentials only)",
        "secret": true
      }
    ],
    "group": "api",
    "replaced_by": "aws"
  },
