        "paths": []
      },
      {
        "key": "client_secret",
        "label": "OAuth client secret",
        "paths": [],
        "secret": true
      },
      {
        "credential": true,
        "key": "token",
        "label": "Calendly account",
        "oauth": {
          "auth_url": "https://auth.calendly.com/oauth/authorize",
          "client_id": "{client_id}",
          "client_secret": "{client_secret}",
          "scope": "availability:write event_types:write locations:read routing_forms:read shares:write scheduled_events:write scheduling_links:write groups:read organizations:write users:read webhooks:write activity_log:read data_compliance:write outgoing_communications:read contacts:write meeting_recaps:write",
          "token_url": "https://auth.calendly.com/oauth/token"
        },
        "secret": true
      }
    ],
