    "connection": {
      "http": {
        "slots": [
          {
            "header": "X-Gotify-Key",
            "origin": "https://example.com",
            "path": "/",
            "value": "app_api_token"
          },
          {
            "header": "Authorization",
            "origin": "https://example.com",
            "path": "/",
            "prefix": "Bearer ",
            "value": "app_api_token"
          },
