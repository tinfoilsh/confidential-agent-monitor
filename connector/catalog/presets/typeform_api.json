          "issuer": "https://api.typeform.com",
          "scope": "offline_access accounts:read forms:read forms:write responses:read responses:write workspaces:read workspaces:write themes:read themes:write images:read images:write webhooks:read webhooks:write"
        },
        "secret": true
      }
    ],
