{
  "catalog": {
    "actions": {
      "shipments": {
        "title": "Shipments"
      },
      "shipments.read": {
        "title": "Read"
      }
    },
    "connection": {
      "http": {
        "slots": [
          {
            "header": "DHL-API-Key",
            "origin": "https://api-eu.dhl.com",
            "path": "/track",
            "value": "api_key"
          },
          {
            "header": "DHL-API-Key",
            "origin": "https://api-sandbox.dhl.com",
            "path": "/track",
            "value": "api_key"
          }
        ]
      }
    },
    "defaults": {
      "contents": "team",
      "sends": "anyone",
      "strangers": true
    },
    "fields": [
      {
        "credential": true,
        "key": "api_key",
        "label": "API Key",
        "secret": true
      }
    ],
    "group": "api"
  },
  "title": "DHL",
  "http": {
    "origins": {"dhl":["https://api-eu.dhl.com","https://api-sandbox.dhl.com"]},
    "operations": {
      "getTrackingShipment": {"action":"shipments.read","effects":["read"],"method":"GET","origin":"{dhl}","params":["trackingNumber","service","requesterCountryCode","originCountryCode","recipientPostalCode","language","offset","limit"],"path":"/track/shipments","scope":{}}
    }
  }
}
