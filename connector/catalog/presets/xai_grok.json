      "handle_image_generation_models_list_request": {"action":"image_generation_models.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/image-generation-models","scope":{}},
      "handle_language_model_get_request": {"action":"language_models.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/language-models/{model_id}","scope":{"model_id":{"at":"model_id","from":"path"}}},
      "handle_language_models_list_request": {"action":"language_models.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/language-models","scope":{}},
      "handle_list_files_request": {"action":"files.read","effects":["read"],"method":"GET","origin":"{api}","params":["limit","order","sort_by","pagination_token","after","filter"],"path":"/v1/files","scope":{}},
