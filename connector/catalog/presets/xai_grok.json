  "title": "xAI Grok Chat Model",
  "http": {
    "origins": {"api":["https://api.x.ai","https://us.api.x.ai"]},
    "operations": {
      "handle_compact_request": {"action":"responses.compact.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{api}","path":"/v1/responses/compact","scope":{"request":{"at":"","from":"body","type":"object"}}},
