      "handle_sample_request": {"action":"completions.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{api}","path":"/v1/completions","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "handle_tokenize_text_request": {"action":"tokenize_text.read","body":"json","effects":["read"],"method":"POST","origin":"{api}","path":"/v1/tokenize-text","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "handle_upload_file_request": {"action":"files.write","body":"any","effects":["write"],"method":"POST","origin":"{api}","path":"/v1/files","scope":{}},
      "handle_upload_skill_request": {"action":"skills.write","body":"any","effects":["write"],"method":"POST","origin":"{api}","path":"/v1/skills","scope":{}},
      "handle_video_generation_model_get_request": {"action":"video_generation_models.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/video-generation-models/{model_id}","scope":{"model_id":{"at":"model_id","from":"path"}}},
      "handle_video_generation_models_list_request": {"action":"video_generation_models.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/video-generation-models","scope":{}}
    }
