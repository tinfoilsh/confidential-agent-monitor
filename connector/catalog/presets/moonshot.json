  "title": "Moonshot Kimi",
  "http": {
    "origins": {"api":["https://api.moonshot.ai","https://api.moonshot.cn"]},
    "operations": {
      "DELETE /v1/files/{file_id}": {"action":"files.delete","effects":["delete"],"method":"DELETE","origin":"{api}","path":"/v1/files/{file_id}","scope":{"file_id":{"at":"file_id","from":"path"}}},
      "GET /v1/batches": {"action":"batches.read","effects":["read"],"method":"GET","origin":"{api}","params":["after","limit"],"path":"/v1/batches","scope":{}},
      "GET /v1/batches/{batch_id}": {"action":"batches.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/batches/{batch_id}","scope":{"batch_id":{"at":"batch_id","from":"path"}}},
      "GET /v1/files": {"action":"files.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/files","scope":{}},
      "GET /v1/files/{file_id}": {"action":"files.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/files/{file_id}","scope":{"file_id":{"at":"file_id","from":"path"}}},
      "GET /v1/files/{file_id}/content": {"action":"files.content.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/files/{file_id}/content","scope":{"file_id":{"at":"file_id","from":"path"}}},
      "GET /v1/models": {"action":"models.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/models","scope":{}},
      "GET /v1/users/me/balance": {"action":"users.me.balance.read","effects":["read"],"method":"GET","origin":"{api}","path":"/v1/users/me/balance","scope":{}},
      "POST /anthropic/v1/messages": {"action":"anthropic.messages.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{api}","path":"/anthropic/v1/messages","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/batches": {"action":"batches.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{api}","path":"/v1/batches","scope":{"input_file_id":{"at":"/input_file_id","from":"body"},"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/batches/{batch_id}/cancel": {"action":"batches.write","effects":["write"],"method":"POST","origin":"{api}","path":"/v1/batches/{batch_id}/cancel","scope":{"batch_id":{"at":"batch_id","from":"path"}}},
      "POST /v1/chat/completions": {"action":"chat.completions.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{api}","path":"/v1/chat/completions","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/files": {"action":"files.write","body":"any","effects":["write"],"method":"POST","origin":"{api}","path":"/v1/files","scope":{}},
      "POST /v1/responses": {"action":"responses.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{api}","path":"/v1/responses","scope":{"prompt_cache_key":{"at":"/prompt_cache_key","from":"body","optional":true},"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/signatures/verify": {"action":"signatures.read","body":"json","effects":["read"],"method":"POST","origin":"{api}","path":"/v1/signatures/verify","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/tokenizers/estimate-token-count": {"action":"tokenizers.estimate_token_count.read","body":"json","effects":["read"],"method":"POST","origin":"{api}","path":"/v1/tokenizers/estimate-token-count","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/tools/fetch": {"action":"tools.fetch.read","body":"json","effects":["read"],"method":"POST","origin":"{api}","path":"/v1/tools/fetch","scope":{"request":{"at":"","from":"body","type":"object"},"url":{"at":"/url","from":"body"}}},
      "POST /v1/tools/search": {"action":"tools.read","body":"json","effects":["read"],"method":"POST","origin":"{api}","path":"/v1/tools/search","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "POST /v1/tools/search_pro": {"action":"tools.pro.read","body":"json","effects":["read"],"method":"POST","origin":"{api}","path":"/v1/tools/search_pro","scope":{"request":{"at":"","from":"body","type":"object"},"sites":{"at":"/sites","from":"body","optional":true,"type":"array"}}}
    }
  }
