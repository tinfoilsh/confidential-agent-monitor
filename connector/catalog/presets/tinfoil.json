    "connection": {
      "tinfoil": {
        "enclave": "inference.tinfoil.sh",
        "repo": "tinfoilsh/confidential-model-router"
      }
    },
    "fields": [
      {
        "key": "TINFOIL_API_KEY",
        "label": "Tinfoil API key",
        "credential": true,
        "secret": true
      }
    ],
    "defaults": {
      "contents": "me",
      "sends": "me",
      "strangers": true
    }
  },
