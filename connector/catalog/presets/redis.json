{
  "title": "Redis",
  "catalog": {
    "group": "protocol",
    "actions": {
      "publish": {"title": "Publish messages", "effects": ["send"]},
      "read": {"title": "Read keys", "effects": ["read"]},
      "write": {"title": "Change keys and the server", "effects": ["write", "delete", "admin", "execute"]}
    },
    "connection": {"redis": {"url": "{url}"}},
    "fields": [
      {"hint": "rediss://user@host:6379", "key": "url", "label": "Connection URL", "path": ["redis", "url"]},
      {"default": "", "key": "password", "label": "Password", "credential": true, "secret": true}
    ],
    "defaults": {"contents": "me", "sends": "me", "strangers": true}
  }
}
