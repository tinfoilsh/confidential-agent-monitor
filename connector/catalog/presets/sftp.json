{
  "title": "SFTP files",
  "catalog": {
    "group": "protocol",
    "actions": {
      "read": {"title": "Read files and directories", "effects": ["read"]},
      "write": {"title": "Create and change files", "effects": ["write"]},
      "readwrite": {"title": "Open files for reading and writing", "effects": ["read", "write"]},
      "delete": {"title": "Delete files and directories", "effects": ["delete"]},
      "rename": {"title": "Move files and directories", "effects": ["write", "delete"]},
      "metadata": {"title": "Change file attributes and permissions", "effects": ["write", "admin"]}
    },
    "connection": {"sftp": {"host": "{host}", "host_key": "{host_key}", "user": "{user}", "root": "{root}"}},
    "fields": [
      {"key": "host", "label": "Host", "path": ["sftp", "host"]},
      {"key": "port", "label": "Port", "number": true, "min": 1, "max": 65535, "default": 22, "hint": "22", "help": "Leave empty to use port 22.", "path": ["sftp", "port"]},
      {"key": "user", "label": "User", "path": ["sftp", "user"]},
      {"key": "host_key", "label": "Host key", "hint": "A line from ssh-keyscan, verified with the server owner", "path": ["sftp", "host_key"]},
      {"key": "key", "label": "Private key", "multiline": true, "secret": true, "credential": true},
      {"key": "root", "label": "Remote directory", "default": "/", "path": ["sftp", "root"]}
    ],
    "defaults": {"contents": "me", "sends": "me", "strangers": true}
  }
}
