{
  "title": "SurveyMonkey",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]},
      "use.create_weblink_collector": {"title": "Create weblink collector", "effects": ["share"]},
      "use.delete_question": {"title": "Delete question", "effects": ["delete"]}
    },
    "connection": {"mcp": {"url": "https://mcp.surveymonkey.com/mcp"}},
    "fields": [
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "https://mcp.surveymonkey.com/mcp"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
