      "use.enable_member": {"title": "Enable member", "effects": ["admin"]},
      "use.invite_member": {"title": "Invite member", "effects": ["admin", "send"]},
      "use.merge_department": {"title": "Merge department", "effects": ["delete"]},
      "use.share_review": {"title": "Share review", "effects": ["send", "share"]},
      "use.update_member": {"title": "Update member", "effects": ["admin"]}
