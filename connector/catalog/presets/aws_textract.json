{
  "catalog": {
    "actions": {
      "textract": {
        "title": "Textract"
      },
      "textract.delete": {
        "title": "Delete"
      },
      "textract.generate": {
        "title": "Generate"
      },
      "textract.read": {
        "title": "Read"
      },
      "textract.write": {
        "title": "Create and edit"
      }
    },
    "connection": {
      "http": {
        "slots": [
          {
            "origin": "https://example.com",
            "path": "/",
            "sigv4": {
              "region": "us-east-1",
              "secret": "secret_key",
              "service": "textract",
              "session": "session_token"
            },
            "value": "access_key"
          }
        ]
      }
    },
    "defaults": {
      "contents": "team",
      "sends": "anyone",
      "strangers": true
    },
    "fields": [
      {
        "key": "origin",
        "label": "Service endpoint (https://service.region.amazonaws.com)",
        "paths": [
          [
            "policy_options",
            "origin"
          ],
          [
            "http",
            "slots",
            0,
            "origin"
          ]
        ]
      },
      {
        "key": "region",
        "label": "Region (e.g. us-east-1)",
        "path": [
          "http",
          "slots",
          0,
          "sigv4",
          "region"
        ]
      },
      {
        "credential": true,
        "key": "access_key",
        "label": "Access key ID",
        "secret": true
      },
      {
        "credential": true,
        "key": "secret_key",
        "label": "Secret access key",
        "secret": true
      },
      {
        "credential": true,
        "key": "session_token",
        "label": "Session token (temporary credentials only)",
        "secret": true
      }
    ],
    "group": "api",
    "replaced_by": "aws"
  },
  "title": "AWS Textract",
