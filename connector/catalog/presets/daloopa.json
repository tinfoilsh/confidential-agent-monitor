{
  "title": "Daloopa",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]}
    },
    "connection": {"mcp": {"url": "https://mcp.daloopa.com/server/mcp"}},
    "fields": [
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "https://mcp.daloopa.com/server/mcp"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  },
  "mcp": {"token": {"header": "X-API-KEY"}}
}
