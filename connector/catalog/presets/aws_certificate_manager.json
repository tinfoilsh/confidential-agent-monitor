    "connection": {
      "http": {
        "slots": [
          {
            "origin": "https://example.com",
            "path": "/",
            "sigv4": {
              "region": "us-east-1",
              "secret": "secret_key",
              "service": "acm",
              "session": "session_token"
            },
            "value": "access_key"
          }
        ]
      }
    },
    "fields": [
      {
        "key": "origin",
        "label": "Service endpoint (https://service.region.amazonaws.com)",
        "paths": [
          [
            "policy_options",
            "origin"
          ],
          [
            "http",
            "slots",
            0,
            "origin"
          ]
        ]
      },
      {
        "key": "region",
        "label": "Region (e.g. us-east-1)",
        "path": [
          "http",
          "slots",
          0,
          "sigv4",
          "region"
        ]
      },
      {
        "credential": true,
        "key": "access_key",
        "label": "Access key ID",
        "secret": true
      },
      {
        "credential": true,
        "key": "secret_key",
        "label": "Secret access key",
        "secret": true
      },
      {
        "credential": true,
        "key": "session_token",
        "label": "Session token (temporary credentials only)",
        "secret": true
      }
    ],
    "group": "api",
    "replaced_by": "aws"
  },
