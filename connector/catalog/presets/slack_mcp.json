{
  "title": "Slack",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]},
      "use.slack_schedule_message": {"title": "Slack schedule message", "effects": ["send"]},
      "use.slack_send_message": {"title": "Slack send message", "effects": ["send"]}
    },
    "connection": {"mcp": {"url": "https://mcp.slack.com/mcp"}},
    "fields": [
      {"key": "client_id", "label": "OAuth client ID", "paths": []},
      {"key": "client_secret", "label": "OAuth client secret", "paths": [], "secret": true},
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "https://mcp.slack.com/mcp", "client_id": "{client_id}", "client_secret": "{client_secret}", "token_type": "user"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
