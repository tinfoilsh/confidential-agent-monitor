{
  "title": "Mixpanel",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]},
      "use.Delete-Cohort": {"title": "Delete cohort", "effects": ["delete"]},
      "use.Delete-Dashboard": {"title": "Delete dashboard", "effects": ["delete"]},
      "use.Delete-Tag": {"title": "Delete tag", "effects": ["delete"]},
      "use.Delete-Tracking-Plan": {"title": "Delete tracking plan", "effects": ["delete"]}
    },
    "connection": {"mcp": {"url": "{url}"}},
    "fields": [
      {"key": "url", "label": "Server URL", "default": "https://mcp.mixpanel.com/mcp", "hint": "Use https://mcp-eu.mixpanel.com/mcp for EU or https://mcp-in.mixpanel.com/mcp for India data residency.", "path": ["mcp", "url"]},
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "{url}"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
