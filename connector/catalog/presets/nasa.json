      "donki.list": {"action":"donki.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key","startDate","endDate","mostAccurateOnly","completeEntryOnly","speed","halfAngle","catalog","keyword","location","type"],"path":"/DONKI/{type}","scope":{"type":{"at":"type","from":"path"}}},
      "epic.get": {"action":"epic.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key"],"path":"/EPIC/{path*}","scope":{"path":{"at":"path","from":"path"}}},
