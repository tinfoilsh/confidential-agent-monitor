      "neo.browse": {"action":"neo.neo.browse.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key","page","size"],"path":"/neo/rest/v1/neo/browse","scope":{}},
      "neo.feed": {"action":"neo.feed.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key","start_date","end_date","detailed"],"path":"/neo/rest/v1/feed","scope":{}},
      "neo.feed.today": {"action":"neo.feed.today.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key","detailed"],"path":"/neo/rest/v1/feed/today","scope":{}},
      "neo.get": {"action":"neo.neo.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key"],"path":"/neo/rest/v1/neo/{asteroid_id}","path_patterns":{"asteroid_id":"[0-9]+"},"scope":{"asteroid_id":{"at":"asteroid_id","from":"path"}}},
