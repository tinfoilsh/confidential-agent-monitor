    "operations": {
      "GET /planetary/apod": {"action":"apod.read","effects":["read"],"method":"GET","origin":"https://api.nasa.gov","params":["api_key","date","start_date","end_date","count","concept_tags","hd","thumbs"],"path":"/planetary/apod","scope":{}},
