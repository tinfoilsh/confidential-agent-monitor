    "operations": {
      "addCustomDocDomain": {"action":"docs.domains.admin","body":"json","effects":["admin"],"method":"POST","origin":"{api}","path":"/apis/v1/docs/{docId}/domains","scope":{"docId":{"at":"docId","from":"path"}}},
