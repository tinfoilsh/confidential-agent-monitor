    "operations": {
      "GET /api/v2/agents/fetch": {"action":"agents.fetch.read","effects":["read"],"method":"GET","origin":"https://api.phantombuster.com","params":["id","withManifest","withAgentObject","withCode","withSlaves","withSubSlaves"],"path":"/api/v2/agents/fetch","scope":{"id":{"at":"id","from":"query"}}},
