{
  "title": "zoominfo-mcp-plugin",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]},
      "use.account_research": {"title": "Account research", "effects": ["generate"]},
      "use.contact_research": {"title": "Contact research", "effects": ["generate"]},
      "use.conversation_intelligence": {"title": "Conversation intelligence", "effects": ["generate"]},
      "use.submit_feedback": {"title": "Submit feedback", "effects": ["send"]},
      "use.update_gtm_context": {"title": "Update gtm context", "effects": ["admin", "generate"]}
    },
    "connection": {"mcp": {"url": "https://mcp.zoominfo.com/mcp"}},
    "fields": [
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"resource": "https://mcp.zoominfo.com/mcp"}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
