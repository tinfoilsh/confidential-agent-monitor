    "operations": {
      "anthropic.messages": {"action":"messages.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/messages","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "balance": {"action":"balance.read","effects":["read"],"method":"GET","origin":"https://ollama.com","path":"/api/balance","scope":{}},
