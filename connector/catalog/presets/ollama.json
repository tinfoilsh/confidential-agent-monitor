      "delete": {"action":"delete.delete","body":"json","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/api/delete","scope":{}},
      "embed": {"action":"embed.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/embed","scope":{}},
      "generate": {"action":"generate.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/generate","scope":{}},
      "headBlob": {"action":"blobs.read","effects":["read"],"method":"HEAD","origin":"{origin}","path":"/api/blobs/{digest}","scope":{"digest":{"at":"digest","from":"path"}}},
      "list": {"action":"tags.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/api/tags","scope":{}},
      "openai.audio.speech": {"action":"audio.speech.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/audio/speech","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "openai.audio.transcriptions": {"action":"audio.transcriptions.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/audio/transcriptions","scope":{}},
      "openai.audio.translations": {"action":"audio.translations.generate","body":"any","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/audio/translations","scope":{}},
      "openai.chat.completions": {"action":"chat.completions.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/chat/completions","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "openai.completions": {"action":"completions.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/completions","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "openai.embeddings": {"action":"embeddings.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/embeddings","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "openai.models.list": {"action":"models.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/v1/models","scope":{}},
      "openai.models.retrieve": {"action":"models.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/v1/models/{model*}","scope":{"model":{"at":"model","from":"path"}}},
      "openai.responses": {"action":"responses.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/responses","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "ps": {"action":"ps.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/api/ps","scope":{}},
