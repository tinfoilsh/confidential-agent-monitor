      "show": {"action":"show.read","body":"json","effects":["read"],"method":"POST","origin":"{origin}","path":"/api/show","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "systemone": {"action":"systemone.generate","body":"json","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/systemone","scope":{}},
      "usage": {"action":"usage.read","effects":["read"],"method":"GET","origin":"https://ollama.com","params":["range","scope","group_by"],"path":"/api/usage","scope":{"query":{"at":"","from":"query","type":"object"}}},
      "version": {"action":"version.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/api/version","scope":{}},
