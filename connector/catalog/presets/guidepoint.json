{
  "title": "Guidepoint",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]}
    },
    "connection": {"mcp": {"url": "https://clapi.guidepoint.io/mcp-server/v1/mcp"}},
    "fields": [
      {"key": "client_id", "label": "OAuth client ID", "paths": []},
      {"key": "client_secret", "label": "OAuth client secret", "paths": [], "secret": true},
      {"key": "token", "label": "Token", "credential": true, "secret": true, "oauth": {"auth_url": "https://auth0.guidepoint.com/authorize", "token_url": "https://auth0.guidepoint.com/oauth/token", "client_id": "{client_id}", "client_secret": "{client_secret}", "scope": "openid profile email offline_access", "authorize_params": {"audience": "https://clapi.guidepoint.io/mcp-server/v1/mcp"}}}
    ],
    "defaults": {"contents": "team", "sends": "me", "strangers": true}
  }
}
