    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tinfoilsh/tinfoil-icons": "2.3.5",
    "@types/bun": "1.3.13",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
