{
  "name": "@tinfoilsh/confidential-agent-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "build:hosted": "bun --bun tsc --noEmit && bun --bun vite build --mode hosted",
    "build:static": "bun --bun tsc --noEmit && bun --bun vite build --mode static",
    "check": "bun --bun tsc --noEmit",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@clerk/clerk-js": "6.42.0",
    "@freedomofpress/sigstore-browser": "0.1.15",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@panva/hpke-noble": "1.1.7",
    "@solidjs/router": "1.0.1",
    "@tinfoilsh/noise": "https://github.com/tinfoilsh/noise/releases/download/v0.1.0-rc.1/tinfoilsh-noise-0.1.0-rc.1.tgz",
    "@tinfoilsh/passkey-kit": "0.2.4",
    "@tinfoilsh/verifier": "2.0.0-rc.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@zag-js/solid": "1.47.0",
    "@zag-js/tags-input": "1.47.0",
    "hpke": "1.1.7",
    "solid-js": "1.9.17",
    "solid-sonner": "0.3.3",
    "tinfoil": "2.0.0-rc.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "1.3.13",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-sri-gen": "1.7.5"
  },
  "patchedDependencies": {
    "tinfoil@2.0.0-rc.1": "patches/tinfoil@2.0.0-rc.1.patch"
  }
}
