{
  "name": "@tinfoilsh/confidential-agent-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "check": "bun --bun tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "exports": {
    ".": {
      "types": "./src/owner.d.ts",
      "default": "./src/owner.js"
    }
  },
  "dependencies": {
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14"
  }
}
