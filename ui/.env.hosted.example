# Copy to .env.hosted.local, or set these in your hosting environment, for `bun run build:hosted`.
# Values are public and compiled into the bundle.

# The Clerk instance Tinfoil Chat uses (its NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
VITE_CLERK_PUBLISHABLE_KEY=

# Default. A host outside *.tinfoil.sh also needs connect-src in your host's Content-Security-Policy.
# VITE_API_BASE_URL=https://api.tinfoil.sh

# Local Monitors and Podman sandboxes from ui/dev/local.ts instead of api.tinfoil.sh, for
# `bun run dev --mode hosted` behind https://local.tinfoil.sh. Sandboxes need
# SANDBOX_TOOLCHAIN in the dev server's environment; see dev/cvm.
# VITE_API_BASE_URL=https://local.tinfoil.sh
# VITE_LOCAL_MONITORS=1

# Dev console without Clerk or passkeys, on plain http://127.0.0.1:5173: a fixed
# signed-in account named by this email, whose console key is kept in localStorage.
# Needs VITE_LOCAL_MONITORS=1 and VITE_API_BASE_URL=http://127.0.0.1:5173.
# VITE_DEV_ACCOUNT=you@example.com
