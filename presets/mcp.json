{
  "title": "Custom MCP server",
  "catalog": {
    "group": "generic",
    "warning": "The server supplies its own instructions and tool definitions. Review them carefully before accepting.",
    "actions": {
      "read": { "title": "Use read-only tools", "effects": ["read"] },
      "use": { "title": "Use tools that change things", "effects": ["write"] }
    },
    "connection": { "mcp": { "url": "{url}" } },
    "defaults": { "contents": "team", "sends": "me", "strangers": true },
    "fields": [
      {
        "key": "url",
        "label": "Server URL",
        "path": ["mcp", "url"]
      },
      {
        "hint": "Leave empty to sign in",
        "key": "token",
        "label": "Token",
        "oauth": { "resource": "{url}" },
        "credential": true,
        "secret": true
      }
    ]
  }
}
