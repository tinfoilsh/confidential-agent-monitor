      "": {
        "http": {
          "slots": [
            {
              "value": "token",
              "origin": "https://sheets.googleapis.com",
              "path": "/v4/spreadsheets",
              "header": "Authorization",
              "prefix": "Bearer "
            }
          ]
        }
      }
    },
    "defaults": {
      "contents": "me",
      "strangers": true,
      "sends": "anyone"
    },
    "actions": {
      "read": {
        "title": "Read spreadsheets and ranges"
      },
      "write": {
        "title": "Edit values entered as raw text"
      },
      "execute.formulas": {
        "title": "Create spreadsheets and enter values parsed as formulas, which can fetch URLs"
      },
      "delete": {
        "title": "Clear ranges"
      },
      "admin.structure": {
        "title": "Change sheets, protection and structure (batch update)"
      },
      "write.sheets": {
        "title": "write: sheets"
      },
      "delete.values": {
        "title": "delete: values"
      },
      "write.values": {
        "title": "write: values"
      }
    }
  },
