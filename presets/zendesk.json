      {"value": "apitoken", "origin": "https://example.zendesk.com", "path": "/api/v2", "basic": "password"}
    ]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "read": {"title": "Read tickets"},
      "write.tickets": {"title": "Create and edit tickets, including public replies and sharing"},
