    {"id": "tickets.update", "action": "write.tickets", "effects": ["write", "send", "share"], "method": "PUT", "origin": "{origin}", "path": "/api/v2/tickets/{ticket}", "body": "json", "scope": {"ticket": {"from": "path", "at": "ticket"}, "changes": {"from": "body", "at": "", "type": "object"}}},
    {"id": "tickets.delete", "action": "delete", "effects": ["delete"], "method": "DELETE", "origin": "{origin}", "path": "/api/v2/tickets/{ticket}", "scope": {"ticket": {"from": "path", "at": "ticket"}}},
    {"id": "tickets.comments.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/api/v2/tickets/{ticket}/comments", "params": ["page[size]", "page[after]", "page[before]"], "scope": {"ticket": {"from": "path", "at": "ticket"}}}
  ]
