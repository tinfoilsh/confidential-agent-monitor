  "operations": [
    {"id": "tickets.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/api/v2/tickets", "params": ["page[size]", "page[after]", "page[before]", "sort"], "scope": {}},
    {"id": "tickets.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/api/v2/tickets/{ticket}", "scope": {"ticket": {"from": "path", "at": "ticket"}}},
