{
  "title": "Stackby",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "api_key", "origin": "https://stackby.com", "path": "/", "header": "api-key"}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete": {"title": "Delete"},
      "read": {"title": "Read everything the account can see"},
      "write": {"title": "Write"}
    }
  },
  "http": {
    "operations": {
      "DELETE /": {"action":"delete","effects":["delete"],"method":"DELETE","origin":"https://stackby.com","path":"/","body":"any","scope":{}},
      "GET /": {"action":"read","effects":["read"],"method":"GET","origin":"https://stackby.com","path":"/","scope":{}},
      "PATCH /": {"action":"write","effects":["write"],"method":"PATCH","origin":"https://stackby.com","path":"/","body":"any","scope":{}},
      "POST /": {"action":"write","effects":["write"],"method":"POST","origin":"https://stackby.com","path":"/","body":"any","scope":{}}
    }
  }
}
