{
  "title": "Supabase",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "origin", "label": "Your project URL (https://yourproject.supabase.co)",
       "paths": [["policy_options", "origin"], ["connections", "", "http", "slots", 0, "origin"], ["connections", "", "http", "slots", 1, "origin"]]},
      {"key": "apikey", "label": "Anon or publishable API key (avoid service_role; prefer a user JWT for the Authorization field below under RLS)", "secret": true, "path": ["connections", "", "http", "values", "apikey"]},
      {"key": "jwt", "label": "User access token (JWT), so row level security applies", "secret": true, "path": ["connections", "", "http", "values", "jwt"]}
    ],
    "connections": {"": {"http": {"slots": [
      {"value": "apikey", "origin": "https://example.supabase.co", "path": "/", "header": "Apikey"},
      {"value": "jwt", "origin": "https://example.supabase.co", "path": "/", "header": "Authorization", "prefix": "Bearer "}
    ]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "read": {"title": "Read table rows and storage objects"},
      "write": {"title": "Insert and update table rows, and upload storage objects"},
      "delete": {"title": "Delete table rows"},
      "execute.rpc": {"title": "Call database functions (may have elevated authority; not ordinary CRUD)"}
    }
  },
  "operations": [
    {"id": "rest.select", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/rest/v1/{table}", "open_params": true, "headers": {"Accept-Profile": null, "Content-Profile": null}, "scope": {"table": {"from": "path", "at": "table"}}},
    {"id": "rest.insert", "action": "write", "effects": ["write"], "method": "POST", "origin": "{origin}", "path": "/rest/v1/{table}", "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": null}, "body": "json", "scope": {"table": {"from": "path", "at": "table"}, "rows": {"from": "body", "at": "", "type": "object"}}},
    {"id": "rest.insert.returning", "action": "write", "effects": ["write"], "method": "POST", "origin": "{origin}", "path": "/rest/v1/{table}", "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": "return=representation"}, "body": "json", "scope": {"table": {"from": "path", "at": "table"}, "rows": {"from": "body", "at": "", "type": "object"}}},
    {"id": "rest.update", "action": "write", "effects": ["write"], "method": "PATCH", "origin": "{origin}", "path": "/rest/v1/{table}", "open_params": true, "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": null}, "body": "json", "scope": {"table": {"from": "path", "at": "table"}, "filter": {"from": "query", "at": "", "type": "object"}, "changes": {"from": "body", "at": "", "type": "object"}}},
    {"id": "rest.update.returning", "action": "write", "effects": ["write"], "method": "PATCH", "origin": "{origin}", "path": "/rest/v1/{table}", "open_params": true, "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": "return=representation"}, "body": "json", "scope": {"table": {"from": "path", "at": "table"}, "filter": {"from": "query", "at": "", "type": "object"}, "changes": {"from": "body", "at": "", "type": "object"}}},
    {"id": "rest.delete", "action": "delete", "effects": ["delete"], "method": "DELETE", "origin": "{origin}", "path": "/rest/v1/{table}", "open_params": true, "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": null}, "scope": {"table": {"from": "path", "at": "table"}, "filter": {"from": "query", "at": "", "type": "object"}}},
    {"id": "rest.delete.returning", "action": "delete", "effects": ["delete"], "method": "DELETE", "origin": "{origin}", "path": "/rest/v1/{table}", "open_params": true, "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": "return=representation"}, "scope": {"table": {"from": "path", "at": "table"}, "filter": {"from": "query", "at": "", "type": "object"}}},
    {"id": "rpc.call", "action": "execute.rpc", "effects": ["execute"], "method": "POST", "origin": "{origin}", "path": "/rest/v1/rpc/{function}", "headers": {"Accept-Profile": null, "Content-Profile": null, "Prefer": null}, "body": "json", "scope": {"function": {"from": "path", "at": "function"}, "arguments": {"from": "body", "at": "", "type": "object"}}},
    {"id": "storage.object.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/storage/v1/object/{bucket}/{key*}", "headers": {"Accept-Profile": null, "Content-Profile": null}, "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
    {"id": "storage.object.upload", "action": "write", "effects": ["write"], "method": "POST", "origin": "{origin}", "path": "/storage/v1/object/{bucket}/{key*}", "headers": {"Accept-Profile": null, "Content-Profile": null, "X-Upsert": null}, "body": "any", "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}}
  ]
}
