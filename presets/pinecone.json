{
  "title": "Pinecone Vector Store",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "origin", "label": "Your Pinecone Vector Store origin (https://host)", "paths": [["policy_options", "origin"], ["http", "slots", 1, "origin"]]},
      {"key": "api_key", "label": "API Key", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "api_key", "origin": "https://api.pinecone.io", "path": "/", "header": "Api-Key"}, {"value": "api_key", "origin": "https://example.com", "path": "/", "header": "Api-Key"}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete.backup_schedules": {"title": "Delete: backup schedules"},
      "delete.backups": {"title": "Delete: backups"},
      "delete.collections": {"title": "Delete: collections"},
      "delete.delete": {"title": "Delete: delete"},
      "delete.imports": {"title": "Delete: imports"},
      "delete.indexes": {"title": "Delete: indexes"},
      "delete.namespace_aliases": {"title": "Delete: namespace aliases"},
      "delete.namespaces": {"title": "Delete: namespaces"},
      "generate.backup_schedules": {"title": "Generate: backup schedules"},
      "generate.backups": {"title": "Generate: backups"},
      "generate.collections": {"title": "Generate: collections"},
      "generate.create_for_model": {"title": "Generate: create for model"},
      "generate.create_index": {"title": "Generate: create index"},
      "generate.imports": {"title": "Generate: imports"},
      "generate.indexes": {"title": "Generate: indexes"},
      "generate.namespace_aliases": {"title": "Generate: namespace aliases"},
      "generate.namespaces": {"title": "Generate: namespaces"},
      "generate.update": {"title": "Generate: update"},
      "generate.upsert": {"title": "Generate: upsert"},
      "read": {"title": "Read everything the account can see"},
      "write.backup_schedules": {"title": "Write: backup schedules"},
      "write.indexes": {"title": "Write: indexes"},
      "write.namespace_aliases": {"title": "Write: namespace aliases"}
    }
  },
  "http": {
    "operations": {
      "cancelBulkImport": {"action":"delete.imports","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/bulk/imports/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "configure_index": {"action":"write.indexes","effects":["write"],"method":"PATCH","origin":"https://api.pinecone.io","path":"/indexes/{index_name}","body":"json","scope":{"index_name":{"from":"path","at":"index_name"}}},
      "createNamespace": {"action":"generate.namespaces","effects":["generate"],"method":"POST","origin":"{origin}","path":"/namespaces","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "createNamespaceAlias": {"action":"generate.namespace_aliases","effects":["generate"],"method":"POST","origin":"{origin}","path":"/namespace-aliases","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "create_backup": {"action":"generate.backups","effects":["generate"],"method":"POST","origin":"https://api.pinecone.io","path":"/indexes/{index_name}/backups","body":"json","scope":{"index_name":{"from":"path","at":"index_name"}}},
      "create_backup_schedule": {"action":"generate.backup_schedules","effects":["generate"],"method":"POST","origin":"https://api.pinecone.io","path":"/indexes/{index_name}/backup-schedules","body":"json","scope":{"index_name":{"from":"path","at":"index_name"},"name":{"from":"body","at":"/name"}}},
      "create_collection": {"action":"generate.collections","effects":["generate"],"method":"POST","origin":"https://api.pinecone.io","path":"/collections","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "create_index": {"action":"generate.indexes","effects":["generate"],"method":"POST","origin":"https://api.pinecone.io","path":"/indexes","body":"json","scope":{}},
      "create_index_for_model": {"action":"generate.create_for_model","effects":["generate"],"method":"POST","origin":"https://api.pinecone.io","path":"/indexes/create-for-model","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "create_index_from_backup_operation": {"action":"generate.create_index","effects":["generate"],"method":"POST","origin":"https://api.pinecone.io","path":"/backups/{backup_id}/create-index","body":"json","scope":{"backup_id":{"from":"path","at":"backup_id"},"name":{"from":"body","at":"/name"}}},
      "deleteDocuments": {"action":"delete.delete","effects":["delete"],"method":"POST","origin":"{origin}","path":"/namespaces/{namespace}/documents/delete","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "deleteNamespace": {"action":"delete.namespaces","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/namespaces/{namespace}","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "deleteNamespaceAlias": {"action":"delete.namespace_aliases","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/namespace-aliases/{alias_name}","scope":{"alias_name":{"from":"path","at":"alias_name"}}},
      "deleteVectors": {"action":"delete.delete","effects":["delete"],"method":"POST","origin":"{origin}","path":"/vectors/delete","body":"json","scope":{}},
      "delete_backup": {"action":"delete.backups","effects":["delete"],"method":"DELETE","origin":"https://api.pinecone.io","path":"/backups/{backup_id}","scope":{"backup_id":{"from":"path","at":"backup_id"}}},
      "delete_backup_schedule": {"action":"delete.backup_schedules","effects":["delete"],"method":"DELETE","origin":"https://api.pinecone.io","path":"/backup-schedules/{schedule_id}","scope":{"schedule_id":{"from":"path","at":"schedule_id"}}},
      "delete_collection": {"action":"delete.collections","effects":["delete"],"method":"DELETE","origin":"https://api.pinecone.io","path":"/collections/{collection_name}","scope":{"collection_name":{"from":"path","at":"collection_name"}}},
      "delete_index": {"action":"delete.indexes","effects":["delete"],"method":"DELETE","origin":"https://api.pinecone.io","path":"/indexes/{index_name}","scope":{"index_name":{"from":"path","at":"index_name"}}},
      "describeBulkImport": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/bulk/imports/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "describeIndexStats": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/describe_index_stats","body":"json","scope":{}},
      "describeNamespace": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/namespaces/{namespace}","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "describeNamespaceAlias": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/namespace-aliases/{alias_name}","scope":{"alias_name":{"from":"path","at":"alias_name"}}},
      "describe_backup": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/backups/{backup_id}","scope":{"backup_id":{"from":"path","at":"backup_id"}}},
      "describe_backup_schedule": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/backup-schedules/{schedule_id}","scope":{"schedule_id":{"from":"path","at":"schedule_id"}}},
      "describe_collection": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/collections/{collection_name}","scope":{"collection_name":{"from":"path","at":"collection_name"}}},
      "describe_index": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/indexes/{index_name}","scope":{"index_name":{"from":"path","at":"index_name"}}},
      "describe_restore_job": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/restore-jobs/{job_id}","scope":{"job_id":{"from":"path","at":"job_id"}}},
      "fetchDocuments": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/namespaces/{namespace}/documents/fetch","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "fetchVectors": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/vectors/fetch","params":["ids","namespace"],"scope":{"ids":{"from":"query","at":"ids"}}},
      "fetch_vectors_by_metadata": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/vectors/fetch_by_metadata","body":"json","scope":{}},
      "listBulkImports": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/bulk/imports","params":["limit","paginationToken"],"scope":{}},
      "listDocuments": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/namespaces/{namespace}/documents/list","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "listNamespaceAliases": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/namespace-aliases","params":["limit","paginationToken","prefix","target_namespace"],"scope":{}},
      "listNamespacesOperation": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/namespaces","params":["limit","paginationToken","prefix"],"scope":{}},
      "listVectors": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/vectors/list","params":["prefix","limit","paginationToken","namespace"],"scope":{}},
      "list_backup_schedule_history": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/backup-schedules/{schedule_id}/history","params":["limit","paginationToken"],"scope":{"schedule_id":{"from":"path","at":"schedule_id"}}},
      "list_backup_schedules": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/indexes/{index_name}/backup-schedules","params":["limit","paginationToken"],"scope":{"index_name":{"from":"path","at":"index_name"}}},
      "list_collections": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/collections","scope":{}},
      "list_index_backups": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/indexes/{index_name}/backups","params":["include_deleted","limit","paginationToken"],"scope":{"index_name":{"from":"path","at":"index_name"}}},
      "list_indexes": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/indexes","scope":{}},
      "list_project_backups": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/backups","params":["limit","paginationToken"],"scope":{}},
      "list_restore_jobs": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pinecone.io","path":"/restore-jobs","params":["limit","paginationToken"],"scope":{}},
      "queryVectors": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/query","body":"json","scope":{}},
      "repointNamespaceAlias": {"action":"write.namespace_aliases","effects":["write"],"method":"PATCH","origin":"{origin}","path":"/namespace-aliases/{alias_name}","body":"json","scope":{"alias_name":{"from":"path","at":"alias_name"}}},
      "searchDocuments": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/namespaces/{namespace}/documents/search","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "searchRecordsNamespace": {"action":"read","effects":["read"],"method":"POST","origin":"{origin}","path":"/records/namespaces/{namespace}/search","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "startBulkImport": {"action":"generate.imports","effects":["generate"],"method":"POST","origin":"{origin}","path":"/bulk/imports","body":"json","scope":{}},
      "updateDocuments": {"action":"generate.update","effects":["generate"],"method":"POST","origin":"{origin}","path":"/namespaces/{namespace}/documents/update","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "updateVector": {"action":"generate.update","effects":["generate"],"method":"POST","origin":"{origin}","path":"/vectors/update","body":"json","scope":{}},
      "update_backup_schedule": {"action":"write.backup_schedules","effects":["write"],"method":"PATCH","origin":"https://api.pinecone.io","path":"/backup-schedules/{schedule_id}","body":"json","scope":{"schedule_id":{"from":"path","at":"schedule_id"}}},
      "upsertDocuments": {"action":"generate.upsert","effects":["generate"],"method":"POST","origin":"{origin}","path":"/namespaces/{namespace}/documents/upsert","body":"json","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "upsertRecordsNamespace": {"action":"generate.upsert","effects":["generate"],"method":"POST","origin":"{origin}","path":"/records/namespaces/{namespace}/upsert","body":"any","scope":{"namespace":{"from":"path","at":"namespace"}}},
      "upsertVectors": {"action":"generate.upsert","effects":["generate"],"method":"POST","origin":"{origin}","path":"/vectors/upsert","body":"json","scope":{}}
    }
  }
}
