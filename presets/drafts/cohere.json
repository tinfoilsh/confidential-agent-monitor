{
  "title": "Embeddings Cohere",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "path": ["connections", "", "http", "values", "api_key"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "api_key", "origin": "https://api.cohere.com", "path": "/", "header": "Authorization", "prefix": "Bearer "}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete.connectors": {"title": "Delete: connectors"},
      "delete.datasets": {"title": "Delete: datasets"},
      "delete.finetuned_models": {"title": "Delete: finetuned models"},
      "generate.authorize": {"title": "Generate: authorize"},
      "generate.batches": {"title": "Generate: batches"},
      "generate.classify": {"title": "Generate: classify"},
      "generate.connectors": {"title": "Generate: connectors"},
      "generate.datasets": {"title": "Generate: datasets"},
      "generate.detokenize": {"title": "Generate: detokenize"},
      "generate.embed": {"title": "Generate: embed"},
      "generate.embed_jobs": {"title": "Generate: embed jobs"},
      "generate.finetuned_models": {"title": "Generate: finetuned models"},
      "generate.generate": {"title": "Generate: generate"},
      "generate.parse": {"title": "Generate: parse"},
      "generate.rerank": {"title": "Generate: rerank"},
      "generate.summarize": {"title": "Generate: summarize"},
      "generate.tokenize": {"title": "Generate: tokenize"},
      "generate.transcriptions": {"title": "Generate: transcriptions"},
      "read": {"title": "Read everything the account can see"},
      "send.chat": {"title": "Send: chat"},
      "write.connectors": {"title": "Write: connectors"},
      "write.finetuned_models": {"title": "Write: finetuned models"}
    }
  },
  "operations": [
    {"id": "chat", "action": "send.chat", "effects": ["send"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/chat", "body": "any", "scope": {}},
    {"id": "checkAPIKey", "action": "read", "effects": ["read"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/check-api-key", "scope": {}},
    {"id": "classify", "action": "generate.classify", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/classify", "body": "any", "scope": {}},
    {"id": "create-connector", "action": "generate.connectors", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/connectors", "body": "json", "scope": {"name": {"from": "body", "at": "/name"}, "url": {"from": "body", "at": "/url"}}},
    {"id": "list-connectors", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/connectors", "params": ["limit", "offset"], "scope": {}},
    {"id": "delete-connector", "action": "delete.connectors", "effects": ["delete"], "method": "DELETE", "origin": "https://api.cohere.com", "path": "/v1/connectors/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "get-connector", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/connectors/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "update-connector", "action": "write.connectors", "effects": ["write"], "method": "PATCH", "origin": "https://api.cohere.com", "path": "/v1/connectors/{id}", "body": "json", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "oAuthAuthorize-connector", "action": "generate.authorize", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/connectors/{id}/oauth/authorize", "params": ["after_token_redirect"], "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "create-dataset", "action": "generate.datasets", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/datasets", "params": ["name", "type", "keep_original_file", "skip_malformed_input", "keep_fields", "optional_fields", "text_separator", "csv_delimiter"], "body": "any", "scope": {"name": {"from": "query", "at": "name"}}},
    {"id": "list-datasets", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/datasets", "params": ["datasetType", "before", "after", "limit", "offset", "validationStatus"], "scope": {}},
    {"id": "delete-dataset", "action": "delete.datasets", "effects": ["delete"], "method": "DELETE", "origin": "https://api.cohere.com", "path": "/v1/datasets/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "get-dataset", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/datasets/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "detokenize", "action": "generate.detokenize", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/detokenize", "body": "any", "scope": {}},
    {"id": "embed", "action": "generate.embed", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/embed", "body": "any", "scope": {}},
    {"id": "create-embed-job", "action": "generate.embed_jobs", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/embed-jobs", "body": "any", "scope": {}},
    {"id": "list-embed-jobs", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/embed-jobs", "scope": {}},
    {"id": "get-embed-job", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/embed-jobs/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "cancel-embed-job", "action": "generate.embed_jobs", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/embed-jobs/{id}/cancel", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "ListFinetunedModels", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models", "params": ["page_size", "page_token", "order_by"], "scope": {}},
    {"id": "CreateFinetunedModel", "action": "generate.finetuned_models", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models", "body": "json", "scope": {"name": {"from": "body", "at": "/name"}}},
    {"id": "ListEvents", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models/{finetuned_model_id}/events", "params": ["page_size", "page_token", "order_by"], "scope": {"finetuned_model_id": {"from": "path", "at": "finetuned_model_id"}}},
    {"id": "ListTrainingStepMetrics", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models/{finetuned_model_id}/training-step-metrics", "params": ["page_size", "page_token"], "scope": {"finetuned_model_id": {"from": "path", "at": "finetuned_model_id"}}},
    {"id": "GetFinetunedModel", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "UpdateFinetunedModel", "action": "write.finetuned_models", "effects": ["write"], "method": "PATCH", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models/{id}", "body": "json", "scope": {"id": {"from": "path", "at": "id"}, "name": {"from": "body", "at": "/name"}}},
    {"id": "DeleteFinetunedModel", "action": "delete.finetuned_models", "effects": ["delete"], "method": "DELETE", "origin": "https://api.cohere.com", "path": "/v1/finetuning/finetuned-models/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "generate", "action": "generate.generate", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/generate", "body": "any", "scope": {}},
    {"id": "list-models", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/models", "params": ["page_size", "page_token", "endpoint", "default_only"], "scope": {}},
    {"id": "get-model", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v1/models/{model}", "scope": {"model": {"from": "path", "at": "model"}}},
    {"id": "rerank", "action": "generate.rerank", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/rerank", "body": "any", "scope": {}},
    {"id": "summarize", "action": "generate.summarize", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/summarize", "body": "any", "scope": {}},
    {"id": "tokenize", "action": "generate.tokenize", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v1/tokenize", "body": "any", "scope": {}},
    {"id": "create-transcription", "action": "generate.transcriptions", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/audio/transcriptions", "body": "any", "scope": {}},
    {"id": "ListBatches", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v2/batches", "params": ["page_size", "page_token", "order_by"], "scope": {}},
    {"id": "CreateBatch", "action": "generate.batches", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/batches", "body": "json", "scope": {"name": {"from": "body", "at": "/name"}, "input_dataset_id": {"from": "body", "at": "/input_dataset_id"}}},
    {"id": "GetBatch", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.cohere.com", "path": "/v2/batches/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "CancelBatch", "action": "generate.batches", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/batches/{id}:cancel", "scope": {"id": {"from": "path", "at": "id"}}},
    {"id": "chatv2", "action": "send.chat", "effects": ["send"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/chat", "body": "any", "scope": {}},
    {"id": "embedv2", "action": "generate.embed", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/embed", "body": "any", "scope": {}},
    {"id": "parsev2", "action": "generate.parse", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/parse", "body": "json", "scope": {}},
    {"id": "rerankv2", "action": "generate.rerank", "effects": ["generate"], "method": "POST", "origin": "https://api.cohere.com", "path": "/v2/rerank", "body": "any", "scope": {}}
  ]
}
