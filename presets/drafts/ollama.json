{
  "title": "Ollama",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "origin", "label": "Your Ollama origin (https://host)", "paths": [["policy_options", "origin"], ["connections", "", "http", "slots", 0, "origin"]]},
      {"key": "api_key", "label": "API Key", "secret": true, "path": ["connections", "", "http", "secrets", "api_key"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "api_key", "origin": "https://example.com", "path": "/", "header": "Authorization", "prefix": "Bearer "}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete.delete": {"title": "Delete: delete"},
      "generate.blobs": {"title": "Generate: blobs"},
      "generate.copy": {"title": "Generate: copy"},
      "generate.create": {"title": "Generate: create"},
      "generate.embed": {"title": "Generate: embed"},
      "generate.generate": {"title": "Generate: generate"},
      "generate.pull": {"title": "Generate: pull"},
      "generate.push": {"title": "Generate: push"},
      "generate.show": {"title": "Generate: show"},
      "generate.systemone": {"title": "Generate: systemone"},
      "read": {"title": "Read everything the account can see"},
      "send.chat": {"title": "Send: chat"}
    }
  },
  "http": {
    "operations": {
      "chat": {"action":"send.chat","effects":["send"],"method":"POST","origin":"{origin}","path":"/api/chat","body":"json","scope":{"request":{"from":"body","at":"","type":"object"}}},
      "copy": {"action":"generate.copy","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/copy","body":"json","scope":{}},
      "create": {"action":"generate.create","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/create","body":"json","scope":{}},
      "createBlob": {"action":"generate.blobs","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/blobs/{digest}","body":"any","scope":{"digest":{"from":"path","at":"digest"}}},
      "delete": {"action":"delete.delete","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/api/delete","body":"json","scope":{}},
      "embed": {"action":"generate.embed","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/embed","body":"json","scope":{}},
      "generate": {"action":"generate.generate","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/generate","body":"json","scope":{}},
      "headBlob": {"action":"read","effects":["read"],"method":"HEAD","origin":"{origin}","path":"/api/blobs/{digest}","scope":{"digest":{"from":"path","at":"digest"}}},
      "list": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/api/tags","scope":{}},
      "ps": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/api/ps","scope":{}},
      "pull": {"action":"generate.pull","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/pull","body":"json","scope":{}},
      "push": {"action":"generate.push","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/push","body":"json","scope":{}},
      "show": {"action":"generate.show","effects":["generate"],"method":"POST","origin":"{origin}","path":"/api/show","body":"json","scope":{}},
      "systemone": {"action":"generate.systemone","effects":["generate"],"method":"POST","origin":"{origin}","path":"/v1/systemone","body":"json","scope":{}},
      "version": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/api/version","scope":{}}
    }
  }
}
