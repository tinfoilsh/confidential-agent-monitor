{
  "title": "Qdrant Vector Store",
  "catalog": {
    "fields": [
      {"key": "origin", "label": "Your Qdrant Vector Store origin (https://host)", "paths": [["policy_options", "origin"], ["connections", "", "http", "slots", 0, "origin"]]},
      {"key": "api_key", "label": "API Key", "secret": true, "path": ["connections", "", "http", "values", "api_key"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "api_key", "origin": "https://example.com", "path": "/", "header": "api-key"}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete.clear": {"title": "Delete: clear"},
      "delete.collections": {"title": "Delete: collections"},
      "delete.delete": {"title": "Delete: delete"},
      "delete.index": {"title": "Delete: index"},
      "delete.issues": {"title": "Delete: issues"},
      "delete.peer": {"title": "Delete: peer"},
      "delete.snapshots": {"title": "Delete: snapshots"},
      "delete.vectors": {"title": "Delete: vectors"},
      "generate.aliases": {"title": "Generate: aliases"},
      "generate.batch": {"title": "Generate: batch"},
      "generate.cluster": {"title": "Generate: cluster"},
      "generate.facet": {"title": "Generate: facet"},
      "generate.payload": {"title": "Generate: payload"},
      "generate.recover": {"title": "Generate: recover"},
      "generate.scroll": {"title": "Generate: scroll"},
      "generate.snapshots": {"title": "Generate: snapshots"},
      "read": {"title": "Read everything the account can see"},
      "write.collections": {"title": "Write: collections"},
      "write.index": {"title": "Write: index"},
      "write.payload": {"title": "Write: payload"},
      "write.points": {"title": "Write: points"},
