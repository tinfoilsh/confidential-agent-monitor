{
  "title": "Pushcut",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "path": ["connections", "", "http", "values", "api_key"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "api_key", "origin": "https://api.pushcut.io", "path": "/v1", "header": "API-Key"}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "admin.subscriptions": {"title": "Admin: subscriptions"},
      "delete.subscriptions": {"title": "Delete: subscriptions"},
      "read": {"title": "Read everything the account can see"},
      "send.notifications": {"title": "Send: notifications"}
    }
  },
  "http": {
    "operations": [
    {"id": "GetDevices", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.pushcut.io", "path": "/v1/devices", "scope": {}},
    {"id": "GetNotifications", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.pushcut.io", "path": "/v1/notifications", "scope": {}},
    {"id": "SendNotification", "action": "send.notifications", "effects": ["send"], "method": "POST", "origin": "https://api.pushcut.io", "path": "/v1/notifications/{notificationName}", "body": "json", "scope": {"notificationName": {"from": "path", "at": "notificationName"}, "request": {"from": "body", "at": "", "type": "object"}}, "grant": ["notificationName"]},
    {"id": "ActionExecuted", "action": "admin.subscriptions", "effects": ["admin"], "method": "POST", "origin": "https://api.pushcut.io", "path": "/v1/subscriptions", "body": "json", "scope": {"url": {"from": "body", "at": "/url"}, "actionName": {"from": "body", "at": "/actionName"}}},
    {"id": "DeleteSubscription", "action": "delete.subscriptions", "effects": ["delete"], "method": "DELETE", "origin": "https://api.pushcut.io", "path": "/v1/subscriptions/{subscriptionId}", "scope": {"subscriptionId": {"from": "path", "at": "subscriptionId"}}}
  ]
  }
}
