{
  "title": "Moonshot Kimi",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "path": ["connections", "", "http", "values", "api_key"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "api_key", "origin": "https://api.moonshot.ai", "path": "/", "header": "Authorization", "prefix": "Bearer "}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete.files": {"title": "Delete: files"},
      "generate.batches": {"title": "Generate: batches"},
      "generate.completions": {"title": "Generate: completions"},
      "generate.estimate_token_count": {"title": "Generate: estimate token count"},
      "generate.fetch": {"title": "Generate: fetch"},
      "generate.files": {"title": "Generate: files"},
      "generate.responses": {"title": "Generate: responses"},
      "generate.search": {"title": "Generate: search"},
      "generate.search_pro": {"title": "Generate: search pro"},
      "generate.verify": {"title": "Generate: verify"},
      "read": {"title": "Read everything the account can see"},
      "send.messages": {"title": "Send: messages"}
    }
  },
  "operations": [
    {"id": "POST /anthropic/v1/messages", "action": "send.messages", "effects": ["send"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/anthropic/v1/messages", "body": "json", "scope": {"request": {"from": "body", "at": "", "type": "object"}}},
    {"id": "GET /v1/batches", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/batches", "params": ["after", "limit"], "scope": {}},
    {"id": "POST /v1/batches", "action": "generate.batches", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/batches", "body": "json", "scope": {"input_file_id": {"from": "body", "at": "/input_file_id"}}},
    {"id": "GET /v1/batches/{batch_id}", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/batches/{batch_id}", "scope": {"batch_id": {"from": "path", "at": "batch_id"}}},
    {"id": "POST /v1/batches/{batch_id}/cancel", "action": "generate.batches", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/batches/{batch_id}/cancel", "scope": {"batch_id": {"from": "path", "at": "batch_id"}}},
    {"id": "POST /v1/chat/completions", "action": "generate.completions", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/chat/completions", "body": "json", "scope": {}},
    {"id": "GET /v1/files", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/files", "scope": {}},
    {"id": "POST /v1/files", "action": "generate.files", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/files", "body": "any", "scope": {}},
    {"id": "GET /v1/files/{file_id}", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/files/{file_id}", "scope": {"file_id": {"from": "path", "at": "file_id"}}},
    {"id": "DELETE /v1/files/{file_id}", "action": "delete.files", "effects": ["delete"], "method": "DELETE", "origin": "https://api.moonshot.ai", "path": "/v1/files/{file_id}", "scope": {"file_id": {"from": "path", "at": "file_id"}}},
    {"id": "GET /v1/files/{file_id}/content", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/files/{file_id}/content", "scope": {"file_id": {"from": "path", "at": "file_id"}}},
    {"id": "GET /v1/models", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/models", "scope": {}},
    {"id": "POST /v1/responses", "action": "generate.responses", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/responses", "body": "json", "scope": {}},
    {"id": "POST /v1/signatures/verify", "action": "generate.verify", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/signatures/verify", "body": "json", "scope": {}},
    {"id": "POST /v1/tokenizers/estimate-token-count", "action": "generate.estimate_token_count", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/tokenizers/estimate-token-count", "body": "json", "scope": {}},
    {"id": "POST /v1/tools/fetch", "action": "generate.fetch", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/tools/fetch", "body": "json", "scope": {"url": {"from": "body", "at": "/url"}}},
    {"id": "POST /v1/tools/search", "action": "generate.search", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/tools/search", "body": "json", "scope": {}},
    {"id": "POST /v1/tools/search_pro", "action": "generate.search_pro", "effects": ["generate"], "method": "POST", "origin": "https://api.moonshot.ai", "path": "/v1/tools/search_pro", "body": "json", "scope": {}},
    {"id": "GET /v1/users/me/balance", "action": "read", "effects": ["read"], "method": "GET", "origin": "https://api.moonshot.ai", "path": "/v1/users/me/balance", "scope": {}}
  ]
}
