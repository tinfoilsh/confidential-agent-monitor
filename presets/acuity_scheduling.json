{
  "title": "Acuity Scheduling",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "api_key", "origin": "https://acuityscheduling.com", "path": "/api/v1", "basic": "password"}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "delete": {"title": "Delete"},
      "read": {"title": "Read everything the account can see"},
      "write.block": {"title": "Write: block"}
    }
  },
  "http": {
    "operations": {
      "appointmentidjson": {"action":"read","effects":["read"],"method":"GET","origin":"https://acuityscheduling.com","path":"/api/v1/appointment/:id.json","scope":{}},
      "block": {"action":"write.block","effects":["write"],"method":"POST","origin":"https://acuityscheduling.com","path":"/api/v1/block","body":"any","scope":{}},
      "blockidjson": {"action":"read","effects":["read"],"method":"GET","origin":"https://acuityscheduling.com","path":"/api/v1/block/:id.json","scope":{}},
      "blockidjson-1": {"action":"delete","effects":["delete"],"method":"DELETE","origin":"https://acuityscheduling.com","path":"/api/v1/block/:id.json","scope":{}},
      "calendarsjson": {"action":"read","effects":["read"],"method":"GET","origin":"https://acuityscheduling.com","path":"/api/v1/calendars.json","scope":{}},
      "get-appointments": {"action":"read","effects":["read"],"method":"GET","origin":"https://acuityscheduling.com","path":"/api/v1/appointments.json","params":["max","minDate","maxDate","calendarID"],"scope":{}},
      "get-canceled": {"action":"read","effects":["read"],"method":"GET","origin":"https://acuityscheduling.com","path":"/api/v1/canceled.json","params":["max","minDate","maxDate","calendarID"],"scope":{}},
      "ordersjson": {"action":"read","effects":["read"],"method":"GET","origin":"https://acuityscheduling.com","path":"/api/v1/orders.json","params":["max"],"scope":{}}
    }
  }
}
