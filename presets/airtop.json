    "connection": {"http": {"slots": [{"value": "api_key", "origin": "https://api.airtop.ai", "path": "/api/v1", "header": "Authorization", "prefix": "Bearer "}, {"value": "api_key", "origin": "https://api.airtop.ai", "path": "/api/v1", "header": "api-key"}]}},
