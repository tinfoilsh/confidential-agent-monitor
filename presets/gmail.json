{
  "title": "Gmail",
  "catalog": {
    "group": "api",
    "fields": [
      {
        "key": "token",
        "label": "Google account",
        "secret": true,
        "path": [
          "connections",
          "",
          "http",
          "values",
          "token"
        ],
        "oauth": {
          "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
          "token_url": "https://oauth2.googleapis.com/token",
          "client_id": "{MONITOR_GOOGLE_CLIENT_ID}",
          "client_secret": "{MONITOR_GOOGLE_CLIENT_SECRET}",
          "scope": "https://www.googleapis.com/auth/gmail.modify",
          "prompt": "consent"
        }
      }
    ],
    "connections": {
      "": {
        "http": {
          "slots": [
            {
              "value": "token",
              "origin": "https://gmail.googleapis.com",
              "path": "/gmail/v1",
              "header": "Authorization",
              "prefix": "Bearer "
            }
          ]
        }
      }
    },
    "defaults": {
      "contents": "me",
      "strangers": true,
      "sends": "anyone"
    },
