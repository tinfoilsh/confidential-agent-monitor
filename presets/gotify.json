{
  "title": "Gotify",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "origin", "label": "Your Gotify origin (https://host)", "paths": [["policy_options", "origin"], ["http", "slots", 0, "origin"]]},
      {"key": "app_api_token", "label": "App API Token", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "app_api_token", "origin": "https://example.com", "path": "/", "header": "X-Gotify-Key"}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "admin.config": {"title": "Admin: config"},
      "admin.token": {"title": "Admin: token"},
      "admin.user": {"title": "Admin: user"},
      "delete.application": {"title": "Delete: application"},
      "delete.client": {"title": "Delete: client"},
      "delete.image": {"title": "Delete: image"},
      "delete.message": {"title": "Delete: message"},
      "delete.user": {"title": "Delete: user"},
      "generate.image": {"title": "Generate: image"},
      "read": {"title": "Read everything the account can see"},
      "send.message": {"title": "Send: message"},
      "write.application": {"title": "Write: application"},
      "write.authorize": {"title": "Write: authorize"},
      "write.client": {"title": "Write: client"},
      "write.elevate": {"title": "Write: elevate"},
      "write.login": {"title": "Write: login"},
      "write.logout": {"title": "Write: logout"},
      "write.password": {"title": "Write: password"},
      "write.plugin": {"title": "Write: plugin"},
      "write.security": {"title": "Write: security"}
    }
  },
  "http": {
    "operations": {
      "createApp": {"action":"write.application","effects":["write"],"method":"POST","origin":"{origin}","path":"/application","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "createClient": {"action":"write.client","effects":["write"],"method":"POST","origin":"{origin}","path":"/client","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "createMessage": {"action":"send.message","effects":["send"],"method":"POST","origin":"{origin}","path":"/message","body":"json","scope":{"request":{"from":"body","at":"","type":"object"}}},
      "createUser": {"action":"admin.user","effects":["admin"],"method":"POST","origin":"{origin}","path":"/user","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "currentUser": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/current/user","scope":{}},
      "deleteApp": {"action":"delete.application","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/application/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "deleteAppMessages": {"action":"delete.message","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/application/{id}/message","scope":{"id":{"from":"path","at":"id"}}},
      "deleteClient": {"action":"delete.client","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/client/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "deleteMessage": {"action":"delete.message","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/message/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "deleteMessages": {"action":"delete.message","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/message","scope":{}},
      "deleteUser": {"action":"delete.user","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/user/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "disablePlugin": {"action":"write.plugin","effects":["write"],"method":"POST","origin":"{origin}","path":"/plugin/{id}/disable","scope":{"id":{"from":"path","at":"id"}}},
      "elevateClient": {"action":"write.elevate","effects":["write"],"method":"POST","origin":"{origin}","path":"/client/{id}/elevate","body":"json","scope":{"id":{"from":"path","at":"id"}}},
      "enablePlugin": {"action":"write.plugin","effects":["write"],"method":"POST","origin":"{origin}","path":"/plugin/{id}/enable","scope":{"id":{"from":"path","at":"id"}}},
      "externalAuthorize": {"action":"write.authorize","effects":["write"],"method":"POST","origin":"{origin}","path":"/auth/oidc/external/authorize","body":"json","scope":{"name":{"from":"body","at":"/name"}}},
      "externalToken": {"action":"admin.token","effects":["admin"],"method":"POST","origin":"{origin}","path":"/auth/oidc/external/token","body":"json","scope":{}},
      "getAppMessages": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/application/{id}/message","params":["limit","since"],"scope":{"id":{"from":"path","at":"id"}}},
      "getApps": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/application","scope":{}},
      "getClients": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/client","scope":{}},
      "getHealth": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/health","scope":{}},
      "getInfo": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/gotifyinfo","scope":{}},
      "getMessages": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/message","params":["limit","since"],"scope":{}},
      "getPluginConfig": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/plugin/{id}/config","scope":{"id":{"from":"path","at":"id"}}},
      "getPluginDisplay": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/plugin/{id}/display","scope":{"id":{"from":"path","at":"id"}}},
      "getPlugins": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/plugin","scope":{}},
      "getUser": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/user/{id}","scope":{"id":{"from":"path","at":"id"}}},
      "getUsers": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/user","scope":{}},
      "getVersion": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/version","scope":{}},
      "localLogin": {"action":"write.login","effects":["write"],"method":"POST","origin":"{origin}","path":"/auth/local/login","body":"any","scope":{}},
      "logout": {"action":"write.logout","effects":["write"],"method":"POST","origin":"{origin}","path":"/auth/logout","scope":{}},
      "oidcCallback": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/auth/oidc/callback","params":["code","state"],"scope":{}},
      "oidcElevate": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/auth/oidc/elevate","params":["id","durationSeconds"],"scope":{"id":{"from":"query","at":"id"}}},
      "oidcLogin": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/auth/oidc/login","params":["name"],"scope":{"name":{"from":"query","at":"name"}}},
      "removeAppImage": {"action":"delete.image","effects":["delete"],"method":"DELETE","origin":"{origin}","path":"/application/{id}/image","scope":{"id":{"from":"path","at":"id"}}},
      "streamMessages": {"action":"read","effects":["read"],"method":"GET","origin":"{origin}","path":"/stream","scope":{}},
      "updateAppSecurity": {"action":"write.security","effects":["write"],"method":"PUT","origin":"{origin}","path":"/application/{id}/security","body":"json","scope":{"id":{"from":"path","at":"id"}}},
      "updateApplication": {"action":"write.application","effects":["write"],"method":"PUT","origin":"{origin}","path":"/application/{id}","body":"json","scope":{"id":{"from":"path","at":"id"},"name":{"from":"body","at":"/name"}}},
      "updateClient": {"action":"write.client","effects":["write"],"method":"PUT","origin":"{origin}","path":"/client/{id}","body":"json","scope":{"id":{"from":"path","at":"id"},"name":{"from":"body","at":"/name"}}},
      "updateCurrentUser": {"action":"write.password","effects":["write"],"method":"POST","origin":"{origin}","path":"/current/user/password","body":"json","scope":{}},
      "updatePluginConfig": {"action":"admin.config","effects":["admin"],"method":"POST","origin":"{origin}","path":"/plugin/{id}/config","scope":{"id":{"from":"path","at":"id"}}},
      "updateUser": {"action":"admin.user","effects":["admin"],"method":"POST","origin":"{origin}","path":"/user/{id}","body":"json","scope":{"id":{"from":"path","at":"id"},"name":{"from":"body","at":"/name"}}},
      "uploadAppImage": {"action":"generate.image","effects":["generate"],"method":"POST","origin":"{origin}","path":"/application/{id}/image","body":"any","scope":{"id":{"from":"path","at":"id"}}}
    }
  }
}
