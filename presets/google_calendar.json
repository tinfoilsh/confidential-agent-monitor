{
  "title": "Google Calendar",
  "catalog": {
    "group": "api",
    "fields": [
      {
        "key": "token",
        "label": "Google account",
        "secret": true,
        "path": [
          "connections",
          "",
          "http",
          "values",
          "token"
        ],
        "oauth": {
          "auth_url": "https://accounts.google.com/o/oauth2/v2/auth",
          "token_url": "https://oauth2.googleapis.com/token",
          "client_id": "{MONITOR_GOOGLE_CLIENT_ID}",
          "client_secret": "{MONITOR_GOOGLE_CLIENT_SECRET}",
          "scope": "https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.freebusy",
          "prompt": "consent"
        }
      }
    ],
    "connections": {
      "": {
        "http": {
          "slots": [
            {
              "value": "token",
              "origin": "https://www.googleapis.com",
              "path": "/calendar/v3",
              "header": "Authorization",
              "prefix": "Bearer "
            }
          ]
        }
      }
    },
    "defaults": {
      "contents": "me",
      "strangers": true,
      "sends": "anyone"
    },
    "actions": {
      "read": {
        "title": "Read calendars, events and availability"
      },
      "write": {
        "title": "Create events without guests"
      },
      "send.invite": {
        "title": "Invite guests, and edit or cancel events guests may see"
      },
      "delete.acl": {
        "title": "delete: acl"
      },
      "share.acl": {
        "title": "share: acl"
      },
      "write.watch": {
        "title": "write: watch"
      },
      "delete.calendar_list": {
        "title": "delete: calendar_list"
      },
      "write.calendar_list": {
        "title": "write: calendar_list"
      },
      "delete.clear": {
        "title": "delete: clear"
      },
      "delete.calendars": {
        "title": "delete: calendars"
      },
      "write.calendars": {
        "title": "write: calendars"
      },
      "pay.calendars": {
        "title": "pay: calendars"
      },
      "write.stop": {
        "title": "write: stop"
      },
      "write.events": {
        "title": "write: events"
      },
      "write.quick_add": {
        "title": "write: quick_add"
      }
    }
  },
