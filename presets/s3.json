{
  "title": "S3-compatible storage",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "origin", "label": "Service endpoint, no bucket (https://your-endpoint.example.com)",
       "paths": [["policy_options", "origin"], ["connections", "", "http", "slots", 0, "origin"]]},
      {"key": "bucket_path", "label": "Bucket path prefix this credential may sign (e.g. /mybucket)", "path": ["connections", "", "http", "slots", 0, "path"]},
      {"key": "region", "label": "Region (as required by your provider; use \"auto\" if none applies)", "path": ["connections", "", "http", "slots", 0, "sigv4", "region"]},
      {"key": "access_key", "label": "Access key ID", "secret": true, "path": ["connections", "", "http", "values", "access_key"]},
      {"key": "secret_key", "label": "Secret access key", "secret": true, "path": ["connections", "", "http", "values", "secret_key"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "access_key", "origin": "https://example.com", "path": "/example-bucket", "sigv4": {"service": "s3", "region": "auto", "secret": "secret_key"}}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "read": {"title": "List and read objects"},
      "pay.requester": {"title": "Read objects from requester-pays buckets (billed to this account)"},
      "write": {"title": "Write objects"},
      "delete": {"title": "Delete objects"}
    }
  },
  "operations": [
    {"id": "bucket.list", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/{bucket}", "query": {"list-type": "2"}, "params": ["prefix", "delimiter", "max-keys", "continuation-token"], "headers": {"X-Amz-Request-Payer": null}, "scope": {"bucket": {"from": "path", "at": "bucket"}}},
    {"id": "object.get", "action": "read", "effects": ["read"], "method": "GET", "origin": "{origin}", "path": "/{bucket}/{key*}", "headers": {"X-Amz-Request-Payer": null}, "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
    {"id": "object.get.requester_pays", "action": "pay.requester", "effects": ["read", "pay"], "method": "GET", "origin": "{origin}", "path": "/{bucket}/{key*}", "headers": {"X-Amz-Request-Payer": "requester"}, "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
    {"id": "object.put", "action": "write", "effects": ["write"], "method": "PUT", "origin": "{origin}", "path": "/{bucket}/{key*}", "headers": {"X-Amz-Copy-Source": null, "X-Amz-Acl": null, "X-Amz-Grant-Read": null, "X-Amz-Grant-Write": null, "X-Amz-Grant-Read-Acp": null, "X-Amz-Grant-Write-Acp": null, "X-Amz-Grant-Full-Control": null, "X-Amz-Tagging": null, "X-Amz-Object-Lock-Mode": null, "X-Amz-Object-Lock-Retain-Until-Date": null, "X-Amz-Object-Lock-Legal-Hold": null, "X-Amz-Website-Redirect-Location": null, "X-Amz-Request-Payer": null}, "body": "any", "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}},
    {"id": "object.delete", "action": "delete", "effects": ["delete"], "method": "DELETE", "origin": "{origin}", "path": "/{bucket}/{key*}", "headers": {"X-Amz-Request-Payer": null, "X-Amz-Bypass-Governance-Retention": null}, "scope": {"bucket": {"from": "path", "at": "bucket"}, "key": {"from": "path", "at": "key"}}}
  ]
}
