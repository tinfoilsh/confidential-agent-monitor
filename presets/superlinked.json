      "proxy_completions": {"action":"completions.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/completions","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "proxy_decisions": {"action":"decisions.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/decisions","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "proxy_encode": {"action":"encode.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/encode/{model*}","scope":{"model":{"at":"model","from":"path"},"request":{"at":"","from":"body","type":"object"}}},
      "proxy_extract": {"action":"extract.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/extract/{model*}","scope":{"model":{"at":"model","from":"path"},"request":{"at":"","from":"body","type":"object"}}},
