      "list_pools": {"action":"pools.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/v1/pools","scope":{}},
      "openapi_json": {"action":"openapi.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/openapi.json","scope":{}},
