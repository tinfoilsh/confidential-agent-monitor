      "readyz": {"action":"readyz.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/readyz","scope":{}},
      "renew_pool": {"action":"pools.renew.admin","effects":["admin"],"method":"POST","origin":"{origin}","path":"/v1/pools/{name}/renew","scope":{"name":{"at":"name","from":"path"}}},
      "resolve_config": {"action":"configs.resolve.admin","body":"json","effects":["admin"],"method":"POST","origin":"{origin}","path":"/v1/configs/resolve","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "status_page": {"action":"health.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/","scope":{}},
      "ws_cluster_status": {"action":"ws.cluster_status.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/ws/cluster-status","scope":{}}
