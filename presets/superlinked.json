      "proxy_responses": {"action":"responses.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/responses","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "proxy_score": {"action":"score.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/score/{model*}","scope":{"model":{"at":"model","from":"path"},"request":{"at":"","from":"body","type":"object"}}},
