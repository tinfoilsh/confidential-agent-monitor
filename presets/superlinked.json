      "proxy_messages": {"action":"messages.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/messages","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "proxy_moderations": {"action":"moderations.generate","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/moderations","scope":{}},
      "proxy_openai_embeddings": {"action":"embeddings.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/embeddings","scope":{"request":{"at":"","from":"body","type":"object"}}},
      "proxy_rerank": {"action":"rerank.generate","body":"json","effects":["generate","pay","send"],"method":"POST","origin":"{origin}","path":"/v1/rerank","scope":{"request":{"at":"","from":"body","type":"object"}}},
