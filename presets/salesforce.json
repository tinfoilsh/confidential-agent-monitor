    {"id": "accounts.create", "action": "write.crm", "effects": ["write"], "method": "POST", "origin": "{origin}", "path": "/services/data/v62.0/sobjects/Account", "body": "json", "scope": {"record": {"from": "body", "at": "", "type": "object"}}},
    {"id": "accounts.update", "action": "write.crm", "effects": ["write"], "method": "PATCH", "origin": "{origin}", "path": "/services/data/v62.0/sobjects/Account/{id}", "body": "json", "scope": {"id": {"from": "path", "at": "id"}, "changes": {"from": "body", "at": "", "type": "object"}}},
    {"id": "accounts.delete", "action": "delete.crm", "effects": ["delete"], "method": "DELETE", "origin": "{origin}", "path": "/services/data/v62.0/sobjects/Account/{id}", "scope": {"id": {"from": "path", "at": "id"}}},
