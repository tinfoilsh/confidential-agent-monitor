{
  "title": "Salesforce",
  "catalog": {
    "fields": [
      {"key": "origin", "label": "Your Salesforce instance URL (https://yourinstance.my.salesforce.com)",
       "paths": [["policy_options", "origin"], ["connections", "", "http", "slots", 0, "origin"]]},
      {"key": "token", "label": "OAuth2 access token", "secret": true, "path": ["connections", "", "http", "values", "token"]}
    ],
    "connections": {"": {"http": {"slots": [{"value": "token", "origin": "https://example.my.salesforce.com", "path": "/services/data/v62.0", "header": "Authorization", "prefix": "Bearer "}]}}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "read": {"title": "Query and read records of any object type"},
      "write.crm": {"title": "Create and edit common CRM records: accounts, contacts, leads, opportunities and cases"},
      "delete.crm": {"title": "Delete common CRM records"}
    }
  },
  "operations": [
