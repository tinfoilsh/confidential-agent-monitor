{
  "title": "DocuSeal",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]}
    },
    "connections": {"": {"mcp": {"url": "{url}"}}},
    "defaults": {"contents": "team", "sends": "me", "strangers": true},
    "fields": [
      {"key": "url", "label": "Server URL", "default": "https://{domain}/mcp", "path": ["connections", "", "mcp", "url"]},
      {"key": "token", "label": "API key", "path": ["connections", "", "mcp", "token"], "secret": true}
    ]
  }
}
