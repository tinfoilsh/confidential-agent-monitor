{
  "title": "SSH server",
  "catalog": {
    "group": "generic",
    "warning": "Allows file transfer, commands, terminals, and interactive shells on the configured server. Prefer a narrower service when possible.",
    "actions": {
      "files": { "title": "Transfer files", "effects": ["read", "write"] },
      "run": { "title": "Run commands", "effects": ["execute"] },
      "session": {
        "title": "Set up terminals and send signals",
        "effects": ["session"]
      },
      "shell": { "title": "Open interactive shells", "effects": ["execute"] }
    },
    "connection": {
      "ssh": { "host": "{host}", "host_key": "{host_key}", "user": "{user}" }
    },
    "defaults": { "contents": "me", "sends": "me", "strangers": true },
    "fields": [
      {
        "key": "host",
        "label": "Host",
        "path": ["ssh", "host"]
      },
      {
        "key": "user",
        "label": "User",
        "path": ["ssh", "user"]
      },
      {
        "hint": "a line of ssh-keyscan <host>",
        "key": "host_key",
        "label": "Host key",
        "path": ["ssh", "host_key"]
      },
      {
        "key": "key",
        "label": "Private key",
        "multiline": true,
        "credential": true,
        "secret": true
      }
    ]
  }
}
