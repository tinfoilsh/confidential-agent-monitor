{
  "title": "PayPal",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "secret", "label": "Secret", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "secret", "origin": "https://api-m.paypal.com", "path": "/v1", "header": "Authorization", "prefix": "Bearer "}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "admin.webhooks": {"title": "Admin: webhooks"},
      "delete.webhooks": {"title": "Delete: webhooks"},
      "delete.webhooks_lookup": {"title": "Delete: webhooks lookup"},
      "pay.payouts": {"title": "Pay: payouts"},
      "read": {"title": "Read everything the account can see"},
      "send.resend": {"title": "Send: resend"},
      "write.payouts_item": {"title": "Write: payouts item"},
      "write.simulate_event": {"title": "Write: simulate event"},
      "write.verify_webhook_signature": {"title": "Write: verify webhook signature"},
      "write.webhooks_lookup": {"title": "Write: webhooks lookup"}
    }
  },
  "http": {
    "operations": {
      "event-types.list": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks/{webhook_id}/event-types","scope":{"webhook_id":{"from":"path","at":"webhook_id"}}},
      "payouts-item.cancel": {"action":"write.payouts_item","effects":["write"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/payments/payouts-item/{payout_item_id}/cancel","scope":{"payout_item_id":{"from":"path","at":"payout_item_id"}}},
      "payouts-item.get": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/payments/payouts-item/{payout_item_id}","scope":{"payout_item_id":{"from":"path","at":"payout_item_id"}}},
      "payouts.get": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/payments/payouts/{id}","params":["fields","page","page_size","total_required"],"scope":{"id":{"from":"path","at":"id"}}},
      "payouts.post": {"action":"pay.payouts","effects":["pay"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/payments/payouts","body":"any","scope":{}},
      "simulate-event.post": {"action":"write.simulate_event","effects":["write"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/notifications/simulate-event","body":"any","scope":{}},
      "verify-webhook-signature.post": {"action":"write.verify_webhook_signature","effects":["write"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/notifications/verify-webhook-signature","body":"any","scope":{}},
      "webhooks-event-types.list": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-event-types","scope":{}},
      "webhooks-events.get": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-events/{event_id}","scope":{"event_id":{"from":"path","at":"event_id"}}},
      "webhooks-events.list": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-events","params":["page_size","start_time","end_time","transaction_id","event_type"],"scope":{}},
      "webhooks-events.resend": {"action":"send.resend","effects":["send"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-events/{event_id}/resend","body":"any","scope":{"event_id":{"from":"path","at":"event_id"}}},
      "webhooks-lookup.delete": {"action":"delete.webhooks_lookup","effects":["delete"],"method":"DELETE","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-lookup/{webhook_lookup_id}","scope":{"webhook_lookup_id":{"from":"path","at":"webhook_lookup_id"}}},
      "webhooks-lookup.get": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-lookup/{webhook_lookup_id}","scope":{"webhook_lookup_id":{"from":"path","at":"webhook_lookup_id"}}},
      "webhooks-lookup.list": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-lookup","scope":{}},
      "webhooks-lookup.post": {"action":"write.webhooks_lookup","effects":["write"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks-lookup","scope":{}},
      "webhooks.delete": {"action":"delete.webhooks","effects":["delete"],"method":"DELETE","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks/{webhook_id}","scope":{"webhook_id":{"from":"path","at":"webhook_id"}}},
      "webhooks.get": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks/{webhook_id}","scope":{"webhook_id":{"from":"path","at":"webhook_id"}}},
      "webhooks.list": {"action":"read","effects":["read"],"method":"GET","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks","params":["anchor_type"],"scope":{}},
      "webhooks.post": {"action":"admin.webhooks","effects":["admin"],"method":"POST","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks","body":"any","scope":{}},
      "webhooks.update": {"action":"admin.webhooks","effects":["admin"],"method":"PATCH","origin":"https://api-m.paypal.com","path":"/v1/notifications/webhooks/{webhook_id}","body":"any","scope":{"webhook_id":{"from":"path","at":"webhook_id"}}}
    }
  }
}
