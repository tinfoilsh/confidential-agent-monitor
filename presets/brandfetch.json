{
  "title": "Brandfetch",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "api_key", "origin": "https://api.brandfetch.io", "path": "/v2", "header": "Authorization", "prefix": "Bearer "}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "pay.access": {"title": "Pay: access"},
      "read": {"title": "Read everything the account can see"}
    }
  },
  "http": {
    "operations": {
      "getAgentAccessOffer": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/agents/access","scope":{}},
      "getBrandContext": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/context/{domain}","params":["cachedOnly"],"scope":{"domain":{"from":"path","at":"domain"}}},
      "getBrandData": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/brands/{identifier}","params":["allowNsfw","cachedOnly"],"scope":{"identifier":{"from":"path","at":"identifier"}}},
      "getBrandDataByCrypto": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/brands/crypto/{symbol}","params":["allowNsfw","cachedOnly"],"scope":{"symbol":{"from":"path","at":"symbol"}}},
      "getBrandDataByDomain": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/brands/domain/{domain}","params":["allowNsfw","cachedOnly"],"scope":{"domain":{"from":"path","at":"domain"}}},
      "getBrandDataByIsin": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/brands/isin/{isin}","params":["allowNsfw","cachedOnly"],"scope":{"isin":{"from":"path","at":"isin"}}},
      "getBrandDataByTicker": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/brands/ticker/{ticker}","params":["allowNsfw","cachedOnly"],"scope":{"ticker":{"from":"path","at":"ticker"}}},
      "getBrandFromTransaction": {"action":"read","effects":["read"],"method":"POST","origin":"https://api.brandfetch.io","path":"/v2/brands/transaction","body":"json","scope":{}},
      "getViewer": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/viewer","scope":{}},
      "prefetchBrand": {"action":"read","effects":["read"],"method":"HEAD","origin":"https://api.brandfetch.io","path":"/v2/brands/{identifier}","scope":{"identifier":{"from":"path","at":"identifier"}}},
      "prefetchBrandByDomain": {"action":"read","effects":["read"],"method":"HEAD","origin":"https://api.brandfetch.io","path":"/v2/brands/domain/{domain}","scope":{"domain":{"from":"path","at":"domain"}}},
      "purchaseAgentAccess": {"action":"pay.access","effects":["pay"],"method":"POST","origin":"https://api.brandfetch.io","path":"/v2/agents/access","params":["usd","rotateKey"],"scope":{}},
      "searchBrands": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.brandfetch.io","path":"/v2/search/{name_clientId}","params":["c"],"scope":{"name_clientId":{"from":"path","at":"name_clientId"}}}
    }
  }
}
