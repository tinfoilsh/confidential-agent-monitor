{
  "title": "Shopify",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]}
    },
    "connection": {"mcp": {"url": "{url}"}},
    "defaults": {"contents": "team", "sends": "me", "strangers": true},
    "fields": [
      {"key": "url", "label": "Server URL", "default": "https://{shop}/api/ucp/mcp", "path": ["mcp", "url"]},
      {"key": "token", "label": "Token", "credential": true, "secret": true, "hint": "Leave empty to sign in", "oauth": {"resource": "{url}"}}
    ]
  }
}
