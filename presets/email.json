{
  "title": "Email",
  "catalog": {
    "group": "protocol",
    "actions": {
      "organize": {"title": "Move, flag and delete mail", "effects": ["write"]},
      "read": {"title": "Read mail", "effects": ["read"]}
    },
    "connection": {"imap": {"url": "{imap_url}", "user": "{address}"}},
    "defaults": {"contents": "me", "sends": "me", "strangers": true},
    "fields": [
      {"key": "address", "label": "Own email address, for policy", "path": ["policy_options", "address"]},
      {"key": "password", "label": "App password", "credential": true, "secret": true},
      {"default": "imaps://imap.gmail.com", "key": "imap_url", "label": "IMAP URL", "path": ["imap", "url"]},
      {"edit_only": true, "key": "imap_user", "label": "IMAP user", "path": ["imap", "user"]}
    ]
  }
}
