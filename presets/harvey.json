{
  "title": "Harvey",
  "catalog": {
    "group": "mcp",
    "actions": {
      "read": {"title": "Use read-only tools", "effects": ["read"]},
      "use": {"title": "Use tools that change things", "effects": ["write"]}
    },
    "connection": {"mcp": {"url": "https://api.harvey.ai/hosted_mcp/mcp"}},
    "defaults": {"contents": "team", "sends": "me", "strangers": true},
    "fields": [
      {"key": "client_id", "label": "OAuth client ID", "paths": []},
      {"key": "client_secret", "label": "OAuth client secret", "paths": [], "secret": true},
      {"key": "token", "label": "Token", "credential": true, "secret": true, "hint": "Leave empty to sign in", "oauth": {"resource": "https://api.harvey.ai/hosted_mcp/mcp", "client_id": "{client_id}", "client_secret": "{client_secret}"}}
    ]
  }
}
