{
  "title": "SFTP files",
  "catalog": {
    "group": "protocol",
    "actions": {
      "read": {"title": "Read files and directories", "effects": ["read"]},
      "write": {"title": "Create and change files", "effects": ["write"]},
      "readwrite": {"title": "Open files for reading and writing", "effects": ["read", "write"]},
      "delete": {"title": "Delete files and directories", "effects": ["delete"]},
      "rename": {"title": "Move files and directories", "effects": ["write", "delete"]},
      "metadata": {"title": "Change file attributes and permissions", "effects": ["admin"]}
    },
    "connections": {"": {"sftp": {"host": "{host}", "host_key": "{host_key}", "user": "{user}", "root": "{root}"}}},
    "defaults": {"contents": "me", "sends": "me", "strangers": true},
    "fields": [
      {"key": "host", "label": "Host", "path": ["connections", "", "sftp", "host"]},
      {"key": "user", "label": "User", "path": ["connections", "", "sftp", "user"]},
      {"key": "host_key", "label": "Host key", "hint": "A line from ssh-keyscan, verified with the server owner", "path": ["connections", "", "sftp", "host_key"]},
      {"key": "key", "label": "Private key", "multiline": true, "secret": true, "path": ["connections", "", "sftp", "key"]},
      {"key": "root", "label": "Remote directory", "default": "/", "path": ["connections", "", "sftp", "root"]}
    ]
  }
}
