{
  "title": "Pushcut",
  "catalog": {
    "group": "api",
    "fields": [
      {"key": "api_key", "label": "API Key", "secret": true, "credential": true}
    ],
    "connection": {"http": {"slots": [{"value": "api_key", "origin": "https://api.pushcut.io", "path": "/v1", "header": "API-Key"}]}},
    "defaults": {"contents": "team", "strangers": true, "sends": "anyone"},
    "actions": {
      "admin.subscriptions": {"title": "Admin: subscriptions"},
      "delete.subscriptions": {"title": "Delete: subscriptions"},
      "read": {"title": "Read everything the account can see"},
      "send.notifications": {"title": "Send: notifications"}
    }
  },
  "http": {
    "operations": {
      "ActionExecuted": {"action":"admin.subscriptions","effects":["admin"],"method":"POST","origin":"https://api.pushcut.io","path":"/v1/subscriptions","body":"json","scope":{"url":{"from":"body","at":"/url"},"actionName":{"from":"body","at":"/actionName"}}},
      "DeleteSubscription": {"action":"delete.subscriptions","effects":["delete"],"method":"DELETE","origin":"https://api.pushcut.io","path":"/v1/subscriptions/{subscriptionId}","scope":{"subscriptionId":{"from":"path","at":"subscriptionId"}}},
      "GetDevices": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/devices","scope":{}},
      "GetNotifications": {"action":"read","effects":["read"],"method":"GET","origin":"https://api.pushcut.io","path":"/v1/notifications","scope":{}},
      "SendNotification": {"action":"send.notifications","effects":["send"],"method":"POST","origin":"https://api.pushcut.io","path":"/v1/notifications/{notificationName}","body":"json","scope":{"notificationName":{"from":"path","at":"notificationName"},"request":{"from":"body","at":"","type":"object"}},"grant":["notificationName"]}
    }
  }
}
