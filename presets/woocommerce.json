{
  "catalog": {
    "actions": {
      "wp_json": {
        "title": "Wp json"
      },
      "wp_json.wc": {
        "title": "Wc"
      },
      "wp_json.wc.orders": {
        "title": "Orders"
      },
      "wp_json.wc.orders.read": {
        "title": "Read"
      },
      "wp_json.wc.orders.refunds": {
        "title": "Refunds"
      },
      "wp_json.wc.orders.refunds.pay": {
        "title": "Make payments"
      },
      "wp_json.wc.orders.write": {
        "title": "Create and edit"
      },
      "wp_json.wc.products": {
        "title": "Products"
      },
      "wp_json.wc.products.delete": {
        "title": "Delete"
      },
      "wp_json.wc.products.read": {
        "title": "Read"
      },
      "wp_json.wc.products.write": {
        "title": "Create and edit"
      }
    },
    "connections": {
      "": {
        "http": {
          "slots": [
            {
              "basic": "user",
              "origin": "https://example.com",
              "path": "/wp-json/wc/v3",
              "value": "consumer_key"
            },
            {
              "basic": "password",
              "origin": "https://example.com",
              "path": "/wp-json/wc/v3",
              "value": "consumer_secret"
            }
          ]
        }
      }
    },
    "defaults": {
      "contents": "team",
      "sends": "anyone",
      "strangers": true
    },
    "fields": [
      {
        "key": "origin",
        "label": "Your store's site URL (https://yourstore.example.com)",
        "paths": [
          [
            "policy_options",
            "origin"
          ],
          [
            "connections",
            "",
            "http",
            "slots",
            0,
            "origin"
          ],
          [
            "connections",
            "",
            "http",
            "slots",
            1,
            "origin"
          ]
        ]
      },
      {
        "key": "consumer_key",
        "label": "Consumer key",
        "path": [
          "connections",
          "",
          "http",
          "values",
          "consumer_key"
        ],
        "secret": true
      },
      {
        "key": "consumer_secret",
        "label": "Consumer secret",
        "path": [
          "connections",
          "",
          "http",
          "values",
          "consumer_secret"
        ],
        "secret": true
      }
    ],
    "group": "api"
  },
  "title": "WooCommerce",
  "http": {
    "operations": {
      "orders.list": {"action":"wp_json.wc.orders.read","effects":["read"],"method":"GET","origin":"{origin}","params":["page","per_page","status"],"path":"/wp-json/wc/v3/orders","scope":{}},
      "orders.refunds.create": {"action":"wp_json.wc.orders.refunds.pay","body":"json","effects":["pay"],"method":"POST","origin":"{origin}","path":"/wp-json/wc/v3/orders/{order}/refunds","scope":{"order":{"at":"order","from":"path"},"refund":{"at":"","from":"body","type":"object"}}},
      "orders.update": {"action":"wp_json.wc.orders.write","body":"json","effects":["write","pay","send"],"method":"PUT","origin":"{origin}","path":"/wp-json/wc/v3/orders/{order}","scope":{"changes":{"at":"","from":"body","type":"object"},"order":{"at":"order","from":"path"}}},
      "products.create": {"action":"wp_json.wc.products.write","body":"json","effects":["write","publish"],"method":"POST","origin":"{origin}","path":"/wp-json/wc/v3/products","scope":{"product":{"at":"","from":"body","type":"object"}}},
      "products.delete": {"action":"wp_json.wc.products.delete","effects":["delete"],"method":"DELETE","origin":"{origin}","params":["force"],"path":"/wp-json/wc/v3/products/{product}","scope":{"product":{"at":"product","from":"path"},"query":{"at":"","from":"query","type":"object"}}},
      "products.get": {"action":"wp_json.wc.products.read","effects":["read"],"method":"GET","origin":"{origin}","path":"/wp-json/wc/v3/products/{product}","scope":{"product":{"at":"product","from":"path"}}},
      "products.list": {"action":"wp_json.wc.products.read","effects":["read"],"method":"GET","origin":"{origin}","params":["page","per_page","search","status"],"path":"/wp-json/wc/v3/products","scope":{}},
      "products.update": {"action":"wp_json.wc.products.write","body":"json","effects":["write","publish"],"method":"PUT","origin":"{origin}","path":"/wp-json/wc/v3/products/{product}","scope":{"changes":{"at":"","from":"body","type":"object"},"product":{"at":"product","from":"path"}}}
    }
  }
}
