{
  "title": "General network access",
  "catalog": {
    "group": "generic",
    "warning": "Monitor can see where a sandbox connects (host and port) but not what it sends. Prefer a named connection when one exists.",
    "actions": {
      "connect": {
        "title": "Connect and exchange data",
        "effects": ["read", "send"]
      }
    },
    "connection": { "tcp": { "hosts": ["*"] } },
    "defaults": { "contents": "anyone", "sends": "anyone", "strangers": true },
    "fields": [
      {
        "key": "hosts",
        "label": "Hosts",
        "list": true,
        "default": ["*"],
        "hint": "example.com, *.example.com, or * for all hosts",
        "help": "Hostnames or wildcard patterns.",
        "path": ["tcp", "hosts"]
      },
      {
        "key": "ports",
        "label": "Ports",
        "list": true,
        "number": true,
        "hint": "22, 8080",
        "help": "Leave empty to allow all ports.",
        "path": ["tcp", "ports"]
      }
    ]
  }
}
