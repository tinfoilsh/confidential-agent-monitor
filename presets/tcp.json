{
  "title": "General network access",
  "catalog": {
    "group": "generic",
    "warning": "The Perimeter can see where a bunker connects (host and port) but not what it sends.",
    "actions": {
      "connect": {
        "title": "Connect and exchange data",
        "effects": ["read", "send"]
      }
    },
    "connection": { "tcp": { "hosts": ["*"] } },
    "defaults": { "contents": "anyone", "sends": "anyone", "strangers": true },
    "fields": [
      {
        "key": "hosts",
        "label": "Hosts",
        "list": true,
        "default": ["*"],
        "hint": "example.com, *.example.com, or * for all hosts",
        "help": "Hostnames or wildcard patterns. Matches all TCP ports.",
        "path": ["tcp", "hosts"]
      }
    ]
  }
}
